---
// src/pages/admin/pagos.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import PagosAdmin from '../../components/admin/PagosAdmin.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

const [respuestaPerfil, respuestaPagos] = await Promise.all([
  llamarBackend('/admin/perfil', { token }),
  llamarBackend('/admin/pagos', { token }),
]);

const perfil = respuestaPerfil.datos.data as { nombre: string; apellido: string };

const pagos = (respuestaPagos.datos.pagos ?? []) as import('../../components/admin/PagosAdmin.astro').PagoAdmin[];
const metricas = (respuestaPagos.datos.metricas ?? {
  saldoTotal: 0,
  pagosMes: 0,
  pagosPendientes: 0,
  ticketPromedio: 0,
  totalAprobados: 0,
  totalRechazados: 0,
}) as import('../../components/admin/PagosAdmin.astro').MetricasPagos;
const serieDiaria = (respuestaPagos.datos.serieDiaria ?? []) as import('../../components/admin/PagosAdmin.astro').PuntoSerieIngresos[];

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<AdminLayout
  titulo="Pagos"
  vistaActual="pagos"
  nombreAdmin={`${perfil.nombre} ${perfil.apellido}`}
  inicialesAdmin={iniciales}
>
  <PagosAdmin pagosIniciales={pagos} metricasIniciales={metricas} serieDiariaInicial={serieDiaria} />
</AdminLayout>