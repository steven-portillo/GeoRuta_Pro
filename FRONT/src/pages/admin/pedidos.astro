---
// src/pages/admin/pedidos.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import PedidosAdmin from '../../components/admin/PedidosAdmin.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

const [respuestaPerfil, respuestaPedidos] = await Promise.all([
  llamarBackend('/admin/perfil', { token }),
  llamarBackend('/admin/pedidos', { token }),
]);

const perfil = respuestaPerfil.datos.data as { nombre: string; apellido: string };
const pedidos = (respuestaPedidos.datos.pedidos ?? []) as import('../../components/admin/PedidosAdmin.astro').PedidoAdmin[];
const metricas = (respuestaPedidos.datos.metricas ?? {
  pendientes: 0,
  enTransito: 0,
  entregadosHoy: 0,
  canceladosMes: 0,
}) as import('../../components/admin/PedidosAdmin.astro').MetricasPedidos;

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<AdminLayout
  titulo="Pedidos"
  vistaActual="pedidos"
  nombreAdmin={`${perfil.nombre} ${perfil.apellido}`}
  inicialesAdmin={iniciales}
>
  <PedidosAdmin pedidosIniciales={pedidos} metricasIniciales={metricas} />
</AdminLayout>