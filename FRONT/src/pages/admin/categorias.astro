---
// src/pages/admin/categorias.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import CategoriasAdmin from '../../components/admin/CategoriasAdmin.astro';

const BACKEND_URL = import.meta.env.API_DENO || 'http://127.0.0.1:8005';
const token = Astro.cookies.get('token')?.value;

let perfil = { nombre: '', apellido: '', imagenUrl: '' };
let categorias: import('../../components/admin/CategoriasAdmin.astro').CategoriaAdmin[] = [];

if (token) {
  const [resPerfil, resCategorias] = await Promise.all([
    fetch(`${BACKEND_URL}/api/perfil`, {
      headers: { Authorization: `Bearer ${token}` },
    }),
    fetch(`${BACKEND_URL}/api/admin/categorias`, {
      headers: { Authorization: `Bearer ${token}` },
    }),
  ]);

  const dataPerfil = await resPerfil.json();
  const dataCategorias = await resCategorias.json();

  if (dataPerfil.success) perfil = dataPerfil.data;
  if (dataCategorias.success) categorias = dataCategorias.data ?? [];
}

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<AdminLayout
  titulo="Categorías"
  vistaActual="categorias"
  nombreAdmin={`${perfil.nombre} ${perfil.apellido}`}
  inicialesAdmin={iniciales}
>
  <CategoriasAdmin categoriasIniciales={categorias} />
</AdminLayout>