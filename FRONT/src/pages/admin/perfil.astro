---
// src/pages/admin/perfil.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import PerfilAdmin from '../../components/admin/PerfilAdmin.astro';
import { llamarBackend, obtenerToken, resolverUrlBackend } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

const [respuestaPerfil, respuestaEmpresa] = await Promise.all([
  llamarBackend('/admin/perfil', { token }),
  llamarBackend('/admin/empresa', { token }),
]);

const perfilUsuario = respuestaPerfil.datos.data ?? {};
const empresa = respuestaEmpresa.datos.data ?? {};
const imagenPerfil = perfilUsuario.imagenUrl ?? perfilUsuario.imagen_url ?? '';
const perfil = ({
  ...perfilUsuario,
  imagenUrl: resolverUrlBackend(imagenPerfil) ?? '',
  empresaNombre: empresa.nombre ?? '',
  empresaDesc: empresa.descripcion ?? '',
  empresaLogo: resolverUrlBackend(empresa.logo_url) ?? '',
} ?? {
  nombre: '',
  apellido: '',
  email: '',
  imagenUrl: '',
  empresaNombre: '',
  empresaDesc: '',
  empresaLogo: '',
}) as import('../../components/admin/PerfilAdmin.astro').PerfilAdmin;

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<AdminLayout
  titulo="Mi perfil"
  vistaActual="perfil"
  nombreAdmin={`${perfil.nombre} ${perfil.apellido}`}
  inicialesAdmin={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <PerfilAdmin perfilInicial={perfil} />
</AdminLayout>