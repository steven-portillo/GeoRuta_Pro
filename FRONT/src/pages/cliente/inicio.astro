---
// src/pages/cliente/inicio.astro
import ClienteLayout from '../../layouts/ClienteLayout.astro';
import InicioCliente from '../../components/cliente/InicioCliente.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

// se piden en paralelo: no dependen una de la otra
const [respuestaCuenta, respuestaProveedores] = await Promise.all([
  llamarBackend('/cliente/perfil/cuenta', { token }),
  llamarBackend('/cliente/proveedores', { token }),
]);

const perfil = respuestaCuenta.datos.data as {
  nombre: string;
  apellido: string;
  email: string;
  imagenUrl: string;
  activo: boolean;
  fechaCreacion: string;
  estadoCuenta: string;
};

const proveedores = (respuestaProveedores.datos.data ?? []) as {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
}[];

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<ClienteLayout
  titulo="Inicio"
  vistaActual="inicio"
  nombreUsuario={`${perfil.nombre} ${perfil.apellido}`}
  inicialesUsuario={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <InicioCliente perfil={perfil} proveedores={proveedores} />
</ClienteLayout>