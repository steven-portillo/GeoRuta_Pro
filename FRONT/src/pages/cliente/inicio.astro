---
// src/pages/cliente/inicio.astro
import ClienteLayout from '../../layouts/ClienteLayout.astro';
import InicioCliente from '../../components/cliente/InicioCliente.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

const [respuestaCuenta, respuestaProveedores, respuestaPedidos] = await Promise.all([
  llamarBackend('/cliente/perfil/cuenta', { token }),
  llamarBackend('/cliente/proveedores', { token }),
  llamarBackend('/cliente/pedidos', { token }),
]);

const perfil = respuestaCuenta.datos.data as {
  nombre: string;
  apellido: string;
  email: string;
  imagenUrl: string;
  activo: boolean;
  fechaCreacion: string;
  estadoCuenta: string;
};

const proveedores = (respuestaProveedores.datos.data ?? []) as {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
}[];

const datosPedidos = (respuestaPedidos.datos ?? {}) as {
  pedidos?: {
    id: number;
    total: number;
    fecha: string;
    estado: string;
    empresa: string;
    empresaLogo: string;
    direccion: string;
    metodoPago: string;
    pagoConfirmado: boolean;
    totalItems: number;
  }[];
  pedidoActivo?: {
    id: number;
    estado: string;
    empresa: string;
    total: number;
    direccion: string;
    productosLista: string;
    totalItems: number;
  } | null;
};

const pedidoActivo = datosPedidos.pedidoActivo ?? null;
const pedidos = datosPedidos.pedidos ?? [];

// prioriza activo; si no, el más reciente del historial
const basePedido = pedidoActivo
  ? {
      id: pedidoActivo.id,
      estado: pedidoActivo.estado,
      empresa: pedidoActivo.empresa,
      total: pedidoActivo.total,
      direccion: pedidoActivo.direccion,
      productosLista: pedidoActivo.productosLista,
      totalItems: pedidoActivo.totalItems,
      esActivo: true as boolean,
      fecha: undefined as string | undefined,
      empresaLogo: '' as string,
    }
  : pedidos.length > 0
    ? {
        id: pedidos[0].id,
        estado: pedidos[0].estado,
        empresa: pedidos[0].empresa,
        total: pedidos[0].total,
        direccion: pedidos[0].direccion,
        productosLista: `${pedidos[0].totalItems} producto(s)`,
        totalItems: pedidos[0].totalItems,
        esActivo: false as boolean,
        fecha: pedidos[0].fecha,
        empresaLogo: pedidos[0].empresaLogo ?? '',
      }
    : null;

// fase 2: traer items del último pedido para "productos que ya pediste"
type ItemComprado = {
  nombre: string;
  imagenUrl: string;
  categoria: string;
  cantidad: number;
  precioUnitario: number;
  subtotal: number;
};

let itemsComprados: ItemComprado[] = [];
let empresaLogoPedido = basePedido?.empresaLogo ?? '';

if (basePedido) {
  const respuestaDetalle = await llamarBackend(`/cliente/pedidos/${basePedido.id}`, { token });
  if (respuestaDetalle.datos?.success && respuestaDetalle.datos?.data) {
    const data = respuestaDetalle.datos.data as {
      cabecera?: { empresaLogo?: string };
      items?: ItemComprado[];
    };
    itemsComprados = data.items ?? [];
    if (data.cabecera?.empresaLogo) {
      empresaLogoPedido = data.cabecera.empresaLogo;
    }
  }
}

const pedidoParaMostrar = basePedido
  ? { ...basePedido, empresaLogo: empresaLogoPedido }
  : null;

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<ClienteLayout
  titulo="Inicio"
  vistaActual="inicio"
  nombreUsuario={`${perfil.nombre} ${perfil.apellido}`}
  inicialesUsuario={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <InicioCliente
    perfil={perfil}
    proveedores={proveedores}
    ultimoPedido={pedidoParaMostrar}
    itemsComprados={itemsComprados}
  />
</ClienteLayout>