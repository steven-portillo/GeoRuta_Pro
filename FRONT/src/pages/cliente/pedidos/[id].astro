---
// src/pages/cliente/pedidos/[id].astro
import type { ComponentProps } from 'astro/types';
import ClienteLayout from '../../../layouts/ClienteLayout.astro';
import DetallePedidoCliente from '../../../components/cliente/DetallePedidoCliente.astro';
import { llamarBackend, obtenerToken } from '../../../lib/Backend';

// el estado del pedido cambia, no queremos que el navegador muestre una copia vieja al volver atras
Astro.response.headers.set('Cache-Control', 'no-store');

const token = obtenerToken(Astro.cookies);
const idPedido = Number(Astro.params.id);

if (!Number.isInteger(idPedido) || idPedido <= 0) {
  return Astro.redirect('/cliente/pedidos');
}

// perfil (para el navbar) y detalle del pedido en paralelo
const [respuestaCuenta, respuestaDetalle] = await Promise.all([
  llamarBackend('/cliente/perfil/cuenta', { token }),
  llamarBackend(`/cliente/pedidos/${idPedido}`, { token }),
]);

// el backend responde 404 si el pedido no existe o no es de este cliente
if (!respuestaDetalle.datos.success) {
  return Astro.redirect('/cliente/pedidos');
}

const perfil = respuestaCuenta.datos.data as {
  nombre: string;
  apellido: string;
  imagenUrl: string;
};

const { cabecera, items } = respuestaDetalle.datos.data as ComponentProps<typeof DetallePedidoCliente>;

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<ClienteLayout
  titulo={`Pedido #PED-${idPedido}`}
  vistaActual="pedidos"
  nombreUsuario={`${perfil.nombre} ${perfil.apellido}`}
  inicialesUsuario={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <DetallePedidoCliente cabecera={cabecera} items={items} />
</ClienteLayout>