---
import ClienteLayout from '../../layouts/ClienteLayout.astro';
import CatalogoCliente from '../../components/cliente/CatalogoCliente.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

const [respuestaPerfil, respuestaProveedores] = await Promise.all([
  llamarBackend('/cliente/perfil', { token }),
  llamarBackend('/cliente/proveedores', { token }),
]);

const perfil = respuestaPerfil.datos.data as { nombre: string; apellido: string; imagenUrl: string };
const proveedores = (respuestaProveedores.datos.data ?? []) as {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
}[];

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<ClienteLayout
  titulo="Catálogo de productos"
  vistaActual="catalogo"
  nombreUsuario={`${perfil.nombre} ${perfil.apellido}`}
  inicialesUsuario={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <CatalogoCliente proveedores={proveedores} />
</ClienteLayout>