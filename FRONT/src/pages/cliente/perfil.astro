---
// src/pages/cliente/perfil.astro
import ClienteLayout from '../../layouts/ClienteLayout.astro';
import PerfilCliente from '../../components/cliente/PerfilCliente.astro';
import { llamarBackend, obtenerToken } from '../../lib/Backend';

const token = obtenerToken(Astro.cookies);

// un solo llamado: /cliente/perfil/cuenta ya trae todo lo que necesitan
// tanto el navbar (nombre, imagenUrl) como esta vista (email, fechaCreacion, estadoCuenta)
const respuesta = await llamarBackend('/cliente/perfil/cuenta', { token });

const perfil = respuesta.datos.data as {
  nombre: string;
  apellido: string;
  email: string;
  imagenUrl: string;
  activo: boolean;
  fechaCreacion: string;
  estadoCuenta: string;
};

const iniciales = `${perfil.nombre?.[0] ?? ''}${perfil.apellido?.[0] ?? ''}`.toUpperCase();
---

<ClienteLayout
  titulo="Mi perfil"
  vistaActual="perfil"
  nombreUsuario={`${perfil.nombre} ${perfil.apellido}`}
  inicialesUsuario={iniciales}
  imagenUrl={perfil.imagenUrl || null}
>
  <PerfilCliente perfil={perfil} iniciales={iniciales} />
</ClienteLayout>