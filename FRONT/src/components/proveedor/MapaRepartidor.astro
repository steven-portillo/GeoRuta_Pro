---
import MapaLayout from "../../layouts/MapaLayout.astro";
const token = Astro.cookies.get("token")?.value;
---

<div id="datostoken" data-token={token}></div>

<MapaLayout
  rol="repartidor"
  placeholder="Buscar por nombre o dirección"
  vacio="Nadie en ruta"
  leyenda={["repartidor", "destino"]}
>
  <div slot="bajo-mapa" id="accionesRuta" class="mapa-acciones ruta-idle">
    <div class="mapa-burbujas" role="group" aria-label="Controles de ruta">
      <button
        type="button"
        id="btnIniciarRuta"
        class="mapa-burbuja"
        aria-label="Iniciar ruta"
        title="Iniciar ruta"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M8 5v14l11-7z"></path></svg
        ></button
      >
      <button
        type="button"
        id="btnDescanso"
        class="mapa-burbuja"
        aria-label="Descanso"
        title="Descanso"
        disabled
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M7 5h4v14H7zm6 0h4v14h-4z"></path></svg
        ></button
      >
      <button
        type="button"
        id="btnReanudar"
        class="mapa-burbuja"
        aria-label="Reanudar"
        title="Reanudar"
        disabled
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M8 5v14l11-7z"></path></svg
        ></button
      >
      <button
        type="button"
        id="btnTerminarRuta"
        class="mapa-burbuja"
        aria-label="Terminar ruta"
        title="Terminar ruta"
        disabled
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
          ><path d="M6 6h12v12H6z"></path></svg
        ></button
      >
    </div>
  </div>
  <button
    slot="sobre-mapa"
    type="button"
    id="btnCentrar"
    class="mapa-centrar"
    aria-label="Centrar el mapa en mi ubicación"
    title="Centrar en mi ubicación"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="3.5"></circle><circle cx="12" cy="12" r="7.5"
      ></circle><path d="M12 2v3M12 19v3M2 12h3M19 12h3"></path>
    </svg>
    <span>Mi ubicación</span>
  </button>
  <div
    slot="modal"
    id="modalPedidoRepartidor"
    class="mapa-modal mapa-modal-detalle"
    hidden
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalPedidoRepartidorTitulo"
    aria-busy="false"
  >
    <div class="mapa-modal-caja mapa-modal-detalle-caja">
      <div class="mapa-modal-cab">
        <h2 id="modalPedidoRepartidorTitulo">
          Detalle del pedido <span id="modalPedidoRepartidorNumero"></span>
        </h2>
        <button
          type="button"
          class="mapa-modal-x"
          data-cerrar-pedido
          aria-label="Cerrar detalle del pedido">×</button
        >
      </div>

      <div class="mapa-pedido-resumen">
        <div>
          <span class="mapa-pedido-etiqueta">Estado</span>
          <strong id="modalPedidoRepartidorEstado">Cargando…</strong>
        </div>
        <div>
          <span class="mapa-pedido-etiqueta">Fecha</span>
          <strong id="modalPedidoRepartidorFecha">Cargando…</strong>
        </div>
      </div>

      <section class="mapa-pedido-seccion">
        <h3>Datos de entrega</h3>
        <dl class="mapa-pedido-datos">
          <div>
            <dt>Cliente</dt>
            <dd id="modalPedidoRepartidorCliente">Cargando…</dd>
          </div>
          <div>
            <dt>Teléfono</dt>
            <dd id="modalPedidoRepartidorTelefono">Cargando…</dd>
          </div>
          <div>
            <dt>Correo</dt>
            <dd id="modalPedidoRepartidorCorreo">Cargando…</dd>
          </div>
          <div>
            <dt>Dirección</dt>
            <dd id="modalPedidoRepartidorDireccion">Cargando…</dd>
          </div>
        </dl>
      </section>

      <section class="mapa-pedido-seccion">
        <h3>Productos del pedido</h3>
        <div class="mapa-pedido-tabla-scroll">
          <table class="mapa-factura mapa-pedido-factura">
            <thead>
              <tr>
                <th>Producto</th>
                <th>Cant.</th>
                <th>Precio unitario</th>
                <th>Subtotal</th>
              </tr>
            </thead>
            <tbody id="modalPedidoRepartidorItems">
              <tr><td colspan="4">Cargando productos…</td></tr>
            </tbody>
          </table>
        </div>
        <div class="mapa-pedido-total">
          <span>Total del pedido</span>
          <strong id="modalPedidoRepartidorTotal">Cargando…</strong>
        </div>
      </section>

      <p
        id="modalPedidoRepartidorError"
        class="mapa-pedido-error"
        role="alert"
        hidden
      ></p>
    </div>
  </div>
</MapaLayout>
<script>
  import L from "leaflet";
  import { WsUbicacionCliente } from "../../utils/wsCliente.ts";
  import {
    initMapaUi,
    marcarSeleccion,
    setFaseRutaUI as setFaseRuta,
  } from "../public/mapaUi.ts";
  import { init } from "astro/virtual-modules/prefetch.js";

  const datos = document.getElementById("datostoken") as HTMLElement;
  const token = datos.dataset.token ?? "";
  const API_DENO = import.meta.env.PUBLIC_API_DENO;
  const WS_BASE = import.meta.env.PUBLIC_WS_URL;
  const WS_URL = WS_BASE.startsWith("/")
    ? `${location.protocol === "https:" ? "wss" : "ws"}://${location.host}${WS_BASE}`
    : WS_BASE;
  const MARCADOR_YO = -1;
  const btnIniciar = document.getElementById(
    "btnIniciarRuta",
  ) as HTMLButtonElement | null;
  const btnDescanso = document.getElementById(
    "btnDescanso",
  ) as HTMLButtonElement | null;
  const btnReanudar = document.getElementById(
    "btnReanudar",
  ) as HTMLButtonElement | null;
  const btnTerminar = document.getElementById(
    "btnTerminarRuta",
  ) as HTMLButtonElement | null;

  setFaseRuta("idle");

  btnIniciar?.addEventListener("click", () => {
    cliente.enviar({ tipo: "EmpezarRuta" });
    iniciarGps(enviarThrottled);
  });
  btnDescanso?.addEventListener("click", () => {
    cliente.enviar({ tipo: "Descanso" });
    setFaseRuta("descanso");
  });
  btnReanudar?.addEventListener("click", () => {
    cliente.enviar({ tipo: "ReanudarRuta" });
    enviarUbicacionYa();
    setFaseRuta("activo");
  });
  btnTerminar?.addEventListener("click", () => {
    cliente.enviar({ tipo: "TerminarRuta" });
  });

  //           Iconos
  const iconRepartidor = L.icon({
    iconUrl: "/pins/repartidor.png",
    iconSize: [40, 40],
    iconAnchor: [20, 40],
    popupAnchor: [0, -36],
  });

  const iconTienda = L.icon({
    iconUrl: "/pins/tienda.png",
    iconSize: [36, 36],
    iconAnchor: [18, 36],
    popupAnchor: [0, -32],
  });

  //             Mapa
  const map = L.map("mapa").setView([5.794323, -73.062859], 13);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    maxZoom: 19,
    attribution: "&copy; OpenStreetMap",
  }).addTo(map);
  initMapaUi(map);

  const marcadores = new Map<number, L.Marker>();


    // ---------- Centrar / seguir mi ubicación ----------
  const btnCentrar = document.getElementById("btnCentrar") as HTMLButtonElement | null;
  let siguiendo = false;

  function setSiguiendo(v: boolean) {
    siguiendo = v;
    btnCentrar?.setAttribute("aria-pressed", String(v));
    btnCentrar?.classList.toggle("is-activo", v);
    const t = btnCentrar?.querySelector("span");
    if (t) t.textContent = v ? "Siguiendo" : "Mi ubicación";
  }

  function flyAMi(lat: number, lng: number) {
    map.flyTo([lat, lng], Math.max(map.getZoom(), 17), { duration: 0.8 });
  }

  btnCentrar?.addEventListener("click", () => {
    if (siguiendo) { setSiguiendo(false); return; }

    const yo = marcadores.get(MARCADOR_YO);
    if (yo) {
      const p = yo.getLatLng();
      flyAMi(p.lat, p.lng);
      setSiguiendo(true);
      return;
    }

    // Aún no hay pin propio (ruta sin iniciar): centrar una sola vez, sin seguir
    btnCentrar!.disabled = true;
    navigator.geolocation?.getCurrentPosition(
      (pos) => { flyAMi(pos.coords.latitude, pos.coords.longitude); btnCentrar!.disabled = false; },
      () => { alert("No se pudo obtener tu ubicación. Revisa el permiso de ubicación."); btnCentrar!.disabled = false; },
      { enableHighAccuracy: true, maximumAge: 10000, timeout: 8000 },
    );
  });

  // Si el repartidor arrastra el mapa, deja de seguir
  map.on("dragstart", () => { if (siguiendo) setSiguiendo(false); });




  function escapeHtml(s: string) {
    return String(s)
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  function popupRepartidor(nombre: string, empresa: string, id: number) {
    return `
      <strong>${escapeHtml(nombre || "Repartidor #" + id)}</strong><br/>
      <span>${escapeHtml(empresa || "")}</span>
    `;
  }

  function popupTienda(
    nombre: string,
    direccion: string,
    idPedido: number,
  ) {
    return `
    <div class="mapa-popup-destino">
      <strong>${escapeHtml(nombre || "Destino")}</strong>
      <small>${escapeHtml(direccion || "")}</small>
      <button type="button" class="mapa-btn-pedido mapa-btn-detalle" data-pedido="${idPedido}">
        Obtener detalle
      </button>
    </div>`;
  }

  function upsertMarcadorRepartidor(
    id: number,
    lat: number,
    lng: number,
    meta?: { nombre?: string; empresa?: string },
  ) {
    const key = Number(id);
    const latLng = L.latLng(lat, lng);
    if (key === MARCADOR_YO && siguiendo) map.panTo(latLng);
    const html = popupRepartidor(
      meta?.nombre ?? (key === MARCADOR_YO ? "Mi ubicación" : ""),
      meta?.empresa ?? "",
      key === MARCADOR_YO ? 0 : key,
    );

    const existente = marcadores.get(key);
    if (existente) {
      existente.setLatLng(latLng);
      existente.setPopupContent(html);
      return;
    }

    const marker = L.marker(latLng, { icon: iconRepartidor }).addTo(map);
    marker.bindPopup(html);
    marcadores.set(key, marker);
  }

  //            Destinos (tiendas) + lista del panel
  const marcadoresDestino = new Map<number, L.Marker>();

  function renderLista(destinos: any[]) {
    const lista = document.getElementById("mapaLista");
    if (!lista) return;
    lista.innerHTML = destinos
      .map(
        (d) => `
      <li class="mapa-item" data-id="${d.id_pedido}" data-lat="${d.lat}" data-lng="${d.lng}"
          data-search="${escapeHtml(`${d.nombre_cliente} ${d.direccion_texto}`)}">
        <button type="button" class="mapa-card">
          <span class="mapa-avatar mapa-avatar--tienda"><img src="/pins/tienda.png" alt="" /></span>
          <span class="mapa-textos">
            <span class="mapa-t1">${escapeHtml(d.nombre_cliente || "Cliente")}</span>
            <span class="mapa-t2">${escapeHtml(d.direccion_texto || "Sin dirección")}</span>
          </span>
        </button>
      </li>`,
      )
      .join("");
    // reaplica el filtro del buscador y actualiza el "sin resultados"
    document.getElementById("mapaBusqueda")?.dispatchEvent(new Event("input"));
  }

  async function cargarDestinos() {
    try {
      const res = await fetch(
        `${API_DENO}/api/proveedor/mapa/destinos-en-ruta`,
        {
          headers: { Authorization: `Bearer ${token}` },
        },
      );
      if (!res.ok) {
        console.error("Destinos HTTP", res.status, await res.text());
        return;
      }

      const json = await res.json();
      const destinos = json.data ?? [];

      marcadoresDestino.forEach((m) => map.removeLayer(m));
      marcadoresDestino.clear();

      const grupo = L.featureGroup();
      const validos: any[] = [];

      for (const d of destinos) {
        const lat = Number(d.lat);
        const lng = Number(d.lng);
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) continue;
        const idPedido = Number(d.id_pedido);

        const pin = L.marker([lat, lng], { icon: iconTienda }).addTo(map);
        pin.bindPopup(
          popupTienda(
            d.nombre_cliente ?? "Cliente",
            d.direccion_texto ?? "",
            idPedido,
          ),
        );
        pin.on("click", () => marcarSeleccion(idPedido));
        marcadoresDestino.set(idPedido, pin);
        grupo.addLayer(pin);
        validos.push({ ...d, lat, lng });
      }

      renderLista(validos);

      if (grupo.getLayers().length > 0) {
        map.fitBounds(grupo.getBounds().pad(0.2));
      }
    } catch (e) {
      console.error("cargarDestinos", e);
    }
  }

  // Al elegir una card: initMapaUi ya centra el mapa; aquí abrimos el popup del pin
  document.getElementById("mapaLista")?.addEventListener("click", (e) => {
    const li = (e.target as HTMLElement).closest<HTMLElement>(".mapa-item");
    const m = li && marcadoresDestino.get(Number(li.dataset.id));
    if (m) setTimeout(() => m.openPopup(), 700); // espera a que termine el flyTo
  });

  interface PedidoDetalle {
    id_pedido: number;
    id_estado: number;
    fecha_creacion: string;
    total: number | null;
    nombre_cliente: string;
    telefono_cliente: string | null;
    email_cliente: string | null;
    direccion_texto: string;
    items: {
      producto: string;
      cantidad: number;
      precio_unitario: number;
      subtotal: number;
    }[];
  }

  const modalPedido = document.getElementById(
    "modalPedidoRepartidor",
  ) as HTMLDivElement;
  const formatoCOP = new Intl.NumberFormat("es-CO", {
    style: "currency",
    currency: "COP",
    maximumFractionDigits: 0,
  });
  let pedidoActivo = 0;
  let elementoQueAbrioModal: HTMLElement | null = null;

  function textoModal(id: string, texto: string) {
    const elemento = document.getElementById(id);
    if (elemento) elemento.textContent = texto;
  }

  function mostrarProductosPedido(items: PedidoDetalle["items"]) {
    const cuerpo = document.getElementById("modalPedidoRepartidorItems");
    if (!cuerpo) return;
    cuerpo.replaceChildren();

    if (!items.length) {
      const fila = cuerpo.insertRow();
      const celda = fila.insertCell();
      celda.colSpan = 4;
      celda.textContent = "Este pedido no tiene productos registrados.";
      return;
    }

    for (const item of items) {
      const fila = cuerpo.insertRow();
      const producto = fila.insertCell();
      producto.textContent = item.producto || "Producto";
      const cantidad = fila.insertCell();
      cantidad.textContent = String(item.cantidad);
      const precio = fila.insertCell();
      precio.textContent = formatoCOP.format(item.precio_unitario);
      const subtotal = fila.insertCell();
      subtotal.textContent = formatoCOP.format(item.subtotal);
    }
  }

  function mostrarEstadoProductos(mensaje: string) {
    const cuerpo = document.getElementById("modalPedidoRepartidorItems");
    if (!cuerpo) return;
    cuerpo.replaceChildren();
    const fila = cuerpo.insertRow();
    const celda = fila.insertCell();
    celda.colSpan = 4;
    celda.textContent = mensaje;
  }

  function cerrarModalPedido() {
    if (modalPedido.hidden) return;
    modalPedido.hidden = true;
    modalPedido.setAttribute("aria-busy", "false");
    pedidoActivo = 0;
    elementoQueAbrioModal?.focus();
    elementoQueAbrioModal = null;
  }

  async function abrirModalPedido(idPedido: number, boton: HTMLElement) {
    if (!Number.isSafeInteger(idPedido) || idPedido <= 0) return;

    pedidoActivo = idPedido;
    elementoQueAbrioModal = boton;
    modalPedido.hidden = false;
    modalPedido.setAttribute("aria-busy", "true");
    textoModal("modalPedidoRepartidorNumero", `#${idPedido}`);
    textoModal("modalPedidoRepartidorEstado", "Cargando…");
    textoModal("modalPedidoRepartidorFecha", "Cargando…");
    textoModal("modalPedidoRepartidorCliente", "Cargando…");
    textoModal("modalPedidoRepartidorTelefono", "Cargando…");
    textoModal("modalPedidoRepartidorCorreo", "Cargando…");
    textoModal("modalPedidoRepartidorDireccion", "Cargando…");
    textoModal("modalPedidoRepartidorTotal", "Cargando…");
    const error = document.getElementById("modalPedidoRepartidorError");
    if (error) {
      error.hidden = true;
      error.textContent = "";
    }
    mostrarEstadoProductos("Cargando productos…");
    modalPedido.querySelector<HTMLElement>("[data-cerrar-pedido]")?.focus();

    try {
      const respuesta = await fetch(
        `${API_DENO}/api/proveedor/mapa/pedido-detalle/${idPedido}`,
        { headers: { Authorization: `Bearer ${token}` } },
      );
      const resultado: {
        success?: boolean;
        message?: string;
        data?: PedidoDetalle;
      } = await respuesta.json();
      if (pedidoActivo !== idPedido) return;
      if (!respuesta.ok || !resultado.success || !resultado.data) {
        throw new Error(
          resultado.message || "No se pudo obtener el detalle del pedido.",
        );
      }

      const pedido = resultado.data;
      textoModal("modalPedidoRepartidorEstado", "En tránsito");
      const fecha = new Date(pedido.fecha_creacion);
      textoModal(
        "modalPedidoRepartidorFecha",
        Number.isNaN(fecha.getTime())
          ? pedido.fecha_creacion || "No disponible"
          : fecha.toLocaleString("es-CO"),
      );
      textoModal(
        "modalPedidoRepartidorCliente",
        pedido.nombre_cliente || "No disponible",
      );
      textoModal(
        "modalPedidoRepartidorTelefono",
        pedido.telefono_cliente || "No registrado",
      );
      textoModal(
        "modalPedidoRepartidorCorreo",
        pedido.email_cliente || "No registrado",
      );
      textoModal(
        "modalPedidoRepartidorDireccion",
        pedido.direccion_texto || "No disponible",
      );
      textoModal(
        "modalPedidoRepartidorTotal",
        formatoCOP.format(Number(pedido.total ?? 0)),
      );
      mostrarProductosPedido(Array.isArray(pedido.items) ? pedido.items : []);
    } catch (error) {
      console.error("Error al obtener detalle del pedido:", error);
      if (pedidoActivo !== idPedido) return;
      const mensaje = error instanceof Error
        ? error.message
        : "No se pudo obtener el detalle del pedido.";
      const elementoError = document.getElementById(
        "modalPedidoRepartidorError",
      );
      if (elementoError) {
        elementoError.textContent = mensaje;
        elementoError.hidden = false;
      }
      textoModal("modalPedidoRepartidorEstado", "No disponible");
      textoModal("modalPedidoRepartidorFecha", "No disponible");
      textoModal("modalPedidoRepartidorCliente", "No disponible");
      textoModal("modalPedidoRepartidorTelefono", "No disponible");
      textoModal("modalPedidoRepartidorCorreo", "No disponible");
      textoModal("modalPedidoRepartidorDireccion", "No disponible");
      textoModal("modalPedidoRepartidorTotal", "No disponible");
      mostrarEstadoProductos("No se pudieron cargar los productos.");
    } finally {
      if (pedidoActivo === idPedido) {
        modalPedido.setAttribute("aria-busy", "false");
      }
    }
  }

  document.addEventListener("click", (evento) => {
    const destino = evento.target as HTMLElement;
    const boton = destino.closest<HTMLElement>(".mapa-btn-detalle");
    if (boton) {
      evento.preventDefault();
      void abrirModalPedido(Number(boton.dataset.pedido), boton);
      return;
    }
    if (
      destino === modalPedido ||
      destino.closest("[data-cerrar-pedido]")
    ) {
      cerrarModalPedido();
    }
  });

  document.addEventListener("keydown", (evento) => {
    if (evento.key === "Escape") cerrarModalPedido();
  });

  //        GPS
  let watchId: number | null = null;

  function crearEnviarUbicacionThrottled(clienteWs: {
    enviar: (p: object) => void;
  }) {
    let last = 0;
    return (payload: object) => {
      const now = Date.now();
      if (now - last < 4000) return;
      last = now;
      clienteWs.enviar(payload);
    };
  }

  function detenerGps() {
    if (watchId != null) {
      navigator.geolocation.clearWatch(watchId);
      watchId = null;
    }
  }

  function iniciarGps(enviarFn: (p: object) => void) {
    if (!navigator.geolocation) {
      console.error("Sin geolocalización");
      return;
    }

    detenerGps();

    watchId = navigator.geolocation.watchPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;

        upsertMarcadorRepartidor(MARCADOR_YO, lat, lng, {
          nombre: "Mi ubicación",
          empresa: "",
        });
        console.log("Lat: " + lat, " Lng: " + lng);
        enviarFn({ tipo: "EnviarUbicacion", lat, lng });
      },
      (err) => console.error("GPS", err),
      { enableHighAccuracy: true, maximumAge: 3000, timeout: 10000 },
    );
  }

  // Envía la posición actual ya, sin esperar a que el GPS detecte un cambio.
  function enviarUbicacionYa() {
    navigator.geolocation?.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude;
        const lng = pos.coords.longitude;
        upsertMarcadorRepartidor(MARCADOR_YO, lat, lng, {
          nombre: "Mi ubicación",
          empresa: "",
        });
        cliente.enviar({ tipo: "EnviarUbicacion", lat, lng });
      },
      (err) => console.error("GPS", err),
      { enableHighAccuracy: true, maximumAge: 0, timeout: 10000 },
    );
  }

  //    WebSocket
  function setWsBadge(
    estado: "conectando" | "conectado" | "reconectando" | "cerrado",
  ) {
    const el = document.getElementById("wsEstado");
    if (!el) return;
    el.classList.remove("ws-badge--off", "ws-badge--on", "ws-badge--wait");

    if (estado === "conectado") {
      el.textContent = "En línea";
      el.classList.add("ws-badge--on");
    } else if (estado === "reconectando" || estado === "conectando") {
      el.textContent =
        estado === "conectando" ? "Conectando…" : "Reconectando…";
      el.classList.add("ws-badge--wait");
    } else {
      el.textContent = "Desconectado";
      el.classList.add("ws-badge--off");
    }
  }

  const cliente = new WsUbicacionCliente(WS_URL, token, {
    onEstado: (e) => {
      console.log("[WS Cliente]", e);
      setWsBadge(e);
    },
    onMensaje: (msg) => {
      if (msg.tipo === "Error") {
        const texto = String(msg.mensaje ?? "Error");
        console.warn(texto);
        if (
          msg.codigo === "RUTA_CON_PENDIENTES" ||
          texto.toLowerCase().includes("tránsito") ||
          texto.toLowerCase().includes("transito")
        ) {
          alert(texto);
        }
        return;
      }

      if (msg.tipo === "estado_ruta") {
        const modo = String(msg.modo ?? "inactivo");
        if (modo === "activo") {
          setFaseRuta("activo");
          iniciarGps(enviarThrottled);
        } else if (modo === "descanso") {
          setFaseRuta("descanso");
          iniciarGps(enviarThrottled);
        } else {
          setFaseRuta("idle");
          detenerGps();
        }

        if (msg.lat != null && msg.lng != null) {
          upsertMarcadorRepartidor(
            MARCADOR_YO,
            Number(msg.lat),
            Number(msg.lng),
            {
              nombre: "Mi ubicación",
            },
          );
        }
        return;
      }

      if (msg.tipo === "ruta_iniciada") {
        setFaseRuta("activo");
        cargarDestinos();
        return;
      }

      if (msg.tipo === "ruta_terminada") {
        alert("Ruta terminada correctamente.");
        detenerGps();
        setSiguiendo(false);
        setFaseRuta("idle");
        cargarDestinos(); // limpia pines y lista
        return;
      }
    },
  });

  cliente.setDespuesDeAuth(() => {
    cliente.enviar({ tipo: "UnirseComoProveedor" });
  });

  cliente.conectar();
  cargarDestinos();

  const enviarThrottled = crearEnviarUbicacionThrottled(cliente);

  window.addEventListener("beforeunload", () => {
    detenerGps();
    cliente.cerrar();
  });
</script>
