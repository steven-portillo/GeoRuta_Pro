---
// src/components/auth/RecuperarPasswordForm.astro
// recuperacion de contraseña en dos pasos dentro de la misma pagina:
// paso 1 = pedir el codigo por correo, paso 2 = codigo + contraseña nueva

import './auth.css';
import '../../styles/Forms.css';
---

<div class="login-page-wrapper">
  <!-- PANEL IZQUIERDO -->
  <div class="login-visual">
    <div class="login-visual-inner">
      <div class="lv-brand">
        <div class="lv-brand-icon">
          <svg viewBox="0 0 24 24">
            <path
              d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4z"
            ></path>
          </svg>
        </div>
        <span class="lv-brand-name">GeoRuta</span>
      </div>

      <div class="lv-tagline">
        Recupera<br />el acceso a<br /><span>tu cuenta</span>
      </div>

      <ul class="lv-features">
        <li>
          <div class="lv-feat-icon"><i class="bi bi-envelope-check"></i></div>
          Te enviamos un código a tu correo
        </li>
        <li>
          <div class="lv-feat-icon"><i class="bi bi-clock-history"></i></div>
          El código vence en 15 minutos
        </li>
        <li>
          <div class="lv-feat-icon"><i class="bi bi-shield-lock"></i></div>
          Se puede usar una sola vez
        </li>
      </ul>
    </div>
  </div>

  <!-- PANEL DERECHO -->
  <div class="login-form-side">
    <div class="login-card-container">
      <div class="login-card">
        <a href="/login" class="login-back">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"></path>
          </svg>
          Volver a iniciar sesión
        </a>

        <div id="formAlert" class="alert-custom alert-custom-danger d-none" role="alert">
          <i class="bi bi-exclamation-triangle-fill" id="formAlertIcon"></i>
          <span id="formAlertMessage"></span>
        </div>

        <!-- PASO 1: pedir el codigo -->
        <section id="paso1">
          <div class="login-head">
            <h1>¿Olvidaste tu contraseña?</h1>
            <p>Escribe tu correo y te enviaremos un código para crear una nueva</p>
          </div>

          <form id="formSolicitar" class="login-form" novalidate>
            <div class="input-group-custom mb-3">
              <label for="emailInput" class="form-label-custom">Correo electrónico</label>
              <div class="input-field-wrapper">
                <i class="bi bi-envelope field-icon"></i>
                <input
                  type="text"
                  id="emailInput"
                  class="form-control-custom"
                  placeholder="usuario@correo.com"
                  autocomplete="email"
                  required
                />
              </div>
              <div class="error-feedback" id="emailError"></div>
            </div>

            <button type="submit" class="btn-submit-gradient" id="btnSolicitar">
              <span class="btn-text">Enviar código</span>
              <i class="bi bi-send btn-icon"></i>
              <div class="btn-spinner spinner-border spinner-border-sm text-light d-none" role="status">
                <span class="visually-hidden">Cargando...</span>
              </div>
            </button>
          </form>
        </section>

        <!-- PASO 2: codigo + contraseña nueva -->
        <section id="paso2" class="d-none">
          <div class="login-head">
            <h1>Crea tu nueva contraseña</h1>
            <p>Enviamos un código de 6 dígitos a <strong id="correoDestino"></strong></p>
          </div>

          <form id="formRestablecer" class="login-form" novalidate>
            <div class="input-group-custom mb-3">
              <label for="codigoInput" class="form-label-custom">Código de verificación</label>
              <div class="input-field-wrapper">
                <i class="bi bi-123 field-icon"></i>
                <input
                  type="text"
                  id="codigoInput"
                  class="form-control-custom"
                  placeholder="000000"
                  inputmode="numeric"
                  maxlength="6"
                  autocomplete="one-time-code"
                  required
                />
              </div>
              <div class="error-feedback" id="codigoError"></div>
            </div>

            <div class="input-group-custom mb-3">
              <label for="passwordInput" class="form-label-custom">Nueva contraseña</label>
              <div class="input-field-wrapper">
                <i class="bi bi-key field-icon"></i>
                <input
                  type="password"
                  id="passwordInput"
                  class="form-control-custom"
                  placeholder="Mínimo 8 caracteres"
                  autocomplete="new-password"
                  required
                />
                <button type="button" class="toggle-password-btn" id="togglePassword" aria-label="Mostrar u ocultar contraseña">
                  <i class="bi bi-eye" id="togglePasswordIcon"></i>
                </button>
              </div>
              <div class="error-feedback" id="passwordError"></div>
            </div>

            <div class="input-group-custom mb-3">
              <label for="confirmarInput" class="form-label-custom">Confirmar contraseña</label>
              <div class="input-field-wrapper">
                <i class="bi bi-key field-icon"></i>
                <input
                  type="password"
                  id="confirmarInput"
                  class="form-control-custom"
                  placeholder="Repite la contraseña"
                  autocomplete="new-password"
                  required
                />
                <button type="button" class="toggle-password-btn" id="togglePasswordConfirm" aria-label="Mostrar u ocultar contraseña">
                  <i class="bi bi-eye" id="togglePasswordConfirmIcon"></i>
                </button>
              </div>
              <div class="error-feedback" id="confirmarError"></div>
            </div>

            <button type="submit" class="btn-submit-gradient" id="btnRestablecer">
              <span class="btn-text">Cambiar contraseña</span>
              <i class="bi bi-check2-circle btn-icon"></i>
              <div class="btn-spinner spinner-border spinner-border-sm text-light d-none" role="status">
                <span class="visually-hidden">Cargando...</span>
              </div>
            </button>

            <div class="text-center">
              <p class="register-prompt mb-0">
                ¿No te llegó? <button type="button" class="forgot-link btn-enlace" id="btnReenviar" disabled>Reenviar código</button>
              </p>
              <p class="register-prompt mb-1">
                ¿Te equivocaste de correo? <button type="button" class="forgot-link btn-enlace" id="btnOtroCorreo">Usar otro</button>
              </p>
            </div>
          </form>
        </section>
      </div>
    </div>
  </div>
</div>

<style>
  .lv-feat-icon i {
    font-size: 1.05rem;
    color: #fff;
  }

  /* botones que se ven como el enlace .forgot-link */
  .btn-enlace {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  .btn-enlace:disabled {
    opacity: 0.6;
    cursor: default;
    text-decoration: none;
  }
</style>

<script>
  import {
    validarFormatoEmail,
    validarPassword,
    validarPasswordComparar,
    attachFieldValidation,
  } from '../../utils/validaciones';
  import type { ResultadoValidacion } from '../../utils/validaciones';

  // mismo tiempo minimo entre codigos que aplica el backend (SEGUNDOS_ENTRE_CODIGOS)
  const SEGUNDOS_REENVIO = 60;

  const paso1 = document.getElementById('paso1');
  const paso2 = document.getElementById('paso2');
  const formSolicitar = document.getElementById('formSolicitar') as HTMLFormElement | null;
  const formRestablecer = document.getElementById('formRestablecer') as HTMLFormElement | null;
  const btnSolicitar = document.getElementById('btnSolicitar') as HTMLButtonElement | null;
  const btnRestablecer = document.getElementById('btnRestablecer') as HTMLButtonElement | null;
  const btnReenviar = document.getElementById('btnReenviar') as HTMLButtonElement | null;
  const btnOtroCorreo = document.getElementById('btnOtroCorreo') as HTMLButtonElement | null;
  const correoDestino = document.getElementById('correoDestino');

  const emailInput = document.getElementById('emailInput') as HTMLInputElement | null;
  const codigoInput = document.getElementById('codigoInput') as HTMLInputElement | null;
  const passwordInput = document.getElementById('passwordInput') as HTMLInputElement | null;
  const confirmarInput = document.getElementById('confirmarInput') as HTMLInputElement | null;

  const formAlert = document.getElementById('formAlert');
  const formAlertMessage = document.getElementById('formAlertMessage');
  const formAlertIcon = document.getElementById('formAlertIcon');

  // el correo con el que se pidio el codigo; se reutiliza en el paso 2 y al reenviar
  let correoActual = '';
  let temporizador: number | undefined;

  function mostrarAlerta(tipo: 'danger' | 'success', mensaje: string) {
    if (!formAlert || !formAlertMessage || !formAlertIcon) return;
    formAlertMessage.textContent = mensaje;
    formAlert.className = `alert-custom alert-custom-${tipo} d-flex`;
    formAlertIcon.className = tipo === 'danger' ? 'bi bi-exclamation-triangle-fill' : 'bi bi-check-circle-fill';
  }

  function ocultarAlerta() {
    formAlert?.classList.add('d-none');
    formAlert?.classList.remove('d-flex');
  }

  // cambia el boton entre su estado normal y el de "cargando" (texto + icono + spinner)
  function estadoCargando(boton: HTMLButtonElement, cargando: boolean, textoNormal: string, textoCargando: string) {
    const texto = boton.querySelector('.btn-text');
    const icono = boton.querySelector('.btn-icon');
    const spinner = boton.querySelector('.btn-spinner');
    if (texto) texto.textContent = cargando ? textoCargando : textoNormal;
    icono?.classList.toggle('d-none', cargando);
    spinner?.classList.toggle('d-none', !cargando);
    boton.disabled = cargando;
  }

  // mostrar/ocultar contraseña, uno por cada campo
  function conectarToggle(idBoton: string, input: HTMLInputElement | null, idIcono: string) {
    const boton = document.getElementById(idBoton);
    const icono = document.getElementById(idIcono);
    if (!boton || !input || !icono) return;

    boton.addEventListener('click', () => {
      const esPassword = input.type === 'password';
      input.type = esPassword ? 'text' : 'password';
      icono.classList.toggle('bi-eye', !esPassword);
      icono.classList.toggle('bi-eye-slash', esPassword);
    });
  }

  conectarToggle('togglePassword', passwordInput, 'togglePasswordIcon');
  conectarToggle('togglePasswordConfirm', confirmarInput, 'togglePasswordConfirmIcon');

  // cuenta regresiva del boton "reenviar codigo"
  function iniciarCuentaRegresiva() {
    if (!btnReenviar) return;
    window.clearInterval(temporizador);

    let restantes = SEGUNDOS_REENVIO;
    btnReenviar.disabled = true;
    btnReenviar.textContent = `Reenviar código (${restantes}s)`;

    temporizador = window.setInterval(() => {
      restantes -= 1;
      if (restantes <= 0) {
        window.clearInterval(temporizador);
        btnReenviar.disabled = false;
        btnReenviar.textContent = 'Reenviar código';
        return;
      }
      btnReenviar.textContent = `Reenviar código (${restantes}s)`;
    }, 1000);
  }

  // pide el codigo al backend; devuelve true si la peticion fue aceptada
  async function pedirCodigo(email: string): Promise<boolean> {
    try {
      const respuesta = await fetch('/api/auth/recuperar/solicitar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const resultado = await respuesta.json();

      if (!resultado.success) {
        mostrarAlerta('danger', resultado.message ?? 'No fue posible enviar el código');
        return false;
      }
      return true;
    } catch {
      mostrarAlerta('danger', 'No fue posible conectar con el servidor');
      return false;
    }
  }

  // validaciones de campo (mismo helper que login y registro)
  const validarEmail = attachFieldValidation(emailInput, document.getElementById('emailError'), validarFormatoEmail);

  const validarCodigo = attachFieldValidation(
    codigoInput,
    document.getElementById('codigoError'),
    (valor): ResultadoValidacion =>
      /^\d{6}$/.test(valor) ? { isValid: true } : { isValid: false, mensaje: 'Escribe el código de 6 dígitos' },
  );

  const validarPasswordNueva = attachFieldValidation(
    passwordInput,
    document.getElementById('passwordError'),
    (valor) => validarPassword(valor, { minLength: 8 }),
  );

  const validarConfirmar = attachFieldValidation(
    confirmarInput,
    document.getElementById('confirmarError'),
    (valor) => validarPasswordComparar(valor, passwordInput?.value ?? ''),
  );

  // el codigo solo admite digitos: se limpia cualquier otro caracter al escribir o pegar
  codigoInput?.addEventListener('input', () => {
    if (codigoInput) codigoInput.value = codigoInput.value.replace(/\D/g, '');
  });

  // si cambia la contraseña y la confirmacion ya tenia texto, se revalida en cadena
  passwordInput?.addEventListener('input', () => {
    if (confirmarInput?.value) validarConfirmar?.();
  });

  // ---- paso 1: pedir el codigo ----
  formSolicitar?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    ocultarAlerta();

    if (!validarEmail?.().isValid || !emailInput || !btnSolicitar) {
      emailInput?.focus();
      return;
    }

    estadoCargando(btnSolicitar, true, 'Enviar código', 'Enviando...');
    const email = emailInput.value.trim();
    const aceptado = await pedirCodigo(email);
    estadoCargando(btnSolicitar, false, 'Enviar código', 'Enviando...');

    if (!aceptado) return;

    correoActual = email;
    if (correoDestino) correoDestino.textContent = email;
    paso1?.classList.add('d-none');
    paso2?.classList.remove('d-none');
    iniciarCuentaRegresiva();
    codigoInput?.focus();
  });

  // ---- reenviar el codigo ----
  btnReenviar?.addEventListener('click', async () => {
    ocultarAlerta();
    btnReenviar.disabled = true;

    const aceptado = await pedirCodigo(correoActual);
    if (aceptado) {
      mostrarAlerta('success', 'Si el correo está registrado, te enviamos un nuevo código');
      iniciarCuentaRegresiva();
    } else {
      btnReenviar.disabled = false;
    }
  });

  // ---- volver al paso 1 con otro correo ----
  btnOtroCorreo?.addEventListener('click', () => {
    window.clearInterval(temporizador);
    ocultarAlerta();
    formRestablecer?.reset();
    paso2?.classList.add('d-none');
    paso1?.classList.remove('d-none');
    emailInput?.focus();
  });

  // ---- paso 2: codigo + contraseña nueva ----
  formRestablecer?.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    ocultarAlerta();

    const codigoOk = validarCodigo?.();
    const passwordOk = validarPasswordNueva?.();
    const confirmarOk = validarConfirmar?.();

    if (!codigoOk?.isValid || !passwordOk?.isValid || !confirmarOk?.isValid) {
      mostrarAlerta('danger', 'Por favor completa todos los campos correctamente.');
      return;
    }

    if (!btnRestablecer || !codigoInput || !passwordInput) return;

    estadoCargando(btnRestablecer, true, 'Cambiar contraseña', 'Guardando...');

    try {
      const respuesta = await fetch('/api/auth/recuperar/restablecer', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email: correoActual,
          codigo: codigoInput.value,
          password: passwordInput.value,
        }),
      });
      const resultado = await respuesta.json();

      if (!resultado.success) {
        estadoCargando(btnRestablecer, false, 'Cambiar contraseña', 'Guardando...');
        mostrarAlerta('danger', resultado.message ?? 'No fue posible cambiar la contraseña');
        return;
      }

      window.clearInterval(temporizador);
      mostrarAlerta('success', 'Contraseña actualizada. Redirigiendo al inicio de sesión...');
      setTimeout(() => {
        window.location.href = '/login';
      }, 1500);
    } catch {
      estadoCargando(btnRestablecer, false, 'Cambiar contraseña', 'Guardando...');
      mostrarAlerta('danger', 'No fue posible conectar con el servidor');
    }
  });
</script>