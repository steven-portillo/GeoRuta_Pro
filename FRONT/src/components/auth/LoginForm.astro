---
// src/components/auth/LoginForm.astro
// componente de presentacion: no hace fetch al backend, solo pinta el
// formulario y recibe el mensaje de error que la pagina ya resolvio (mismo
// patron que InicioCliente: la pagina resuelve datos/props, el componente pinta)

interface Props {
  mensajeError: string | null;
}

const { mensajeError } = Astro.props;
---

<form id="form-login" class="login-formulario" novalidate>
  <h1 class="login-titulo">Iniciar sesión</h1>
  <p class="login-subtitulo">Ingresa con tu cuenta de GeoRuta</p>

  {mensajeError && (
    <p class="login-error" data-error-inicial>{mensajeError}</p>
  )}
  <p class="login-error" data-error-envio hidden></p>

  <label for="email">Correo</label>
  <input id="email" name="email" type="email" required autocomplete="email" />

  <label for="password">Contraseña</label>
  <input id="password" name="password" type="password" required autocomplete="current-password" />

  <button type="submit">Ingresar</button>

  <p class="login-registro">
    ¿No tienes cuenta? <a href="/registro">Regístrate</a>
  </p>
</form>

<script>
  // redirige segun el rol que devuelve el backend — solo CLIENTE esta migrado
  // en Astro por ahora; los demas roles quedan listos para cuando se migren
  // sus vistas (mismo mapa de prefijos que usa middleware.ts)
  const RUTA_POR_ROL: Record<string, string> = {
    CLIENTE: '/cliente/inicio',
    ADMIN: '/admin/inicio',
    PROVEEDOR: '/proveedor/inicio',
    SUPERADMIN: '/superadmin/inicio',
  };

  const formulario = document.getElementById('form-login') as HTMLFormElement;
  const errorEnvio = document.querySelector('[data-error-envio]') as HTMLParagraphElement;

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    errorEnvio.hidden = true;

    const datos = new FormData(formulario);
    const cuerpo = {
      email: datos.get('email'),
      password: datos.get('password'),
    };

    const boton = formulario.querySelector('button') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Ingresando...';

    try {
      const respuesta = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
      const resultado = await respuesta.json();

      if (!resultado.success) {
        errorEnvio.textContent = resultado.message ?? 'Email o contraseña incorrectos';
        errorEnvio.hidden = false;
        return;
      }

      const destino = RUTA_POR_ROL[resultado.usuario.rol] ?? '/';
      window.location.href = destino;
    } catch {
      errorEnvio.textContent = 'No fue posible conectar con el servidor';
      errorEnvio.hidden = false;
    } finally {
      boton.disabled = false;
      boton.textContent = 'Ingresar';
    }
  });
</script>

<style>
  .login-formulario {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    width: 100%;
    max-width: 360px;
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 14px;
    padding: 2rem 1.75rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
  }

  .login-titulo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--secondary-900);
    margin-bottom: 2px;
  }

  .login-subtitulo {
    font-size: 0.82rem;
    color: var(--secondary-600);
    margin-bottom: 0.5rem;
  }

  .login-formulario label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--secondary-700);
    margin-top: 6px;
  }

  .login-formulario input {
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    border: 1px solid var(--secondary-200);
    font-size: 0.88rem;
  }

  .login-formulario input:focus {
    outline: none;
    border-color: var(--primary-600);
  }

  .login-formulario button {
    margin-top: 0.8rem;
    padding: 0.7rem;
    border-radius: 8px;
    border: none;
    background: var(--primary-700);
    color: white;
    font-weight: 700;
    font-size: 0.88rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .login-formulario button:hover {
    background: var(--primary-900);
  }

  .login-formulario button:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .login-error {
    background: #fee2e2;
    color: #dc2626;
    font-size: 0.78rem;
    padding: 0.5rem 0.7rem;
    border-radius: 8px;
  }

  .login-registro {
    font-size: 0.78rem;
    color: var(--secondary-600);
    text-align: center;
    margin-top: 0.6rem;
  }

  .login-registro a {
    color: var(--primary-600);
    font-weight: 600;
    text-decoration: none;
  }
</style>