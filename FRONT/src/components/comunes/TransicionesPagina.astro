---
// transiciones entre paginas para landing + vistas de autenticacion, usando la
// api nativa de view transitions entre documentos (css @view-transition)
//   push   -> landing  => login/registro
//   volver -> login/registro => landing
//   swap   -> login <-> registro <-> registro-empresa (solo el formulario sube)
---

<script is:inline>
  // corre en el <head> antes del primer render: la pagina nueva ya nace
  // con el tipo de transicion correcto (sin parpadeo)
  (function () {
    var h = document.documentElement;
    try {
      var tipo = sessionStorage.getItem('gr_trans');
      sessionStorage.removeItem('gr_trans');
      if (tipo) h.setAttribute('data-transicion', tipo);
    } catch (e) {}
  })();
</script>

<script is:inline>
  // marca el tipo de transicion justo antes de navegar, segun el enlace pulsado
  (function () {
    var RUTAS_AUTH = ['/login', '/registro', '/registro-empresa', '/password'];
    var h = document.documentElement;

    function limpiar(ruta) {
      return ruta.length > 1 ? ruta.replace(/\/+$/, '') : ruta;
    }

    document.addEventListener('click', function (e) {
      if (e.defaultPrevented || e.button !== 0) return;
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

      var a = e.target.closest ? e.target.closest('a[href]') : null;
      if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download')) return;

      var url = new URL(a.href, location.href);
      if (url.origin !== location.origin) return;

      var origen = limpiar(location.pathname);
      var destino = limpiar(url.pathname);
      var origenEsAuth = RUTAS_AUTH.indexOf(origen) !== -1;
      var destinoEsAuth = RUTAS_AUTH.indexOf(destino) !== -1;

      var tipo = null;
      if (origenEsAuth && destinoEsAuth && origen !== destino) tipo = 'swap';
      else if (origen === '/' && destinoEsAuth) tipo = 'push';
      else if (origenEsAuth && destino === '/') tipo = 'volver';
      if (!tipo) return;

      try {
        sessionStorage.setItem('gr_trans', tipo);
      } catch (_) {
        return;
      }
      // la pagina actual tambien debe conocer el tipo: la captura "vieja" usa estos estilos
      h.setAttribute('data-transicion', tipo);
    });

    window.addEventListener('pageshow', function (e) {
      if (e.persisted) {
        try {
          sessionStorage.removeItem('gr_trans');
        } catch (_) {}
      }
    });
  })();
</script>

<style is:global>
  /* activa las transiciones solo en landing + auth (los paneles no lo declaran) */
  @view-transition {
    navigation: auto;
  }

  /* swap: solo el panel del formulario se anima, el panel azul se queda quieto */
  html[data-transicion='swap'] .login-form-side {
    view-transition-name: panel-form;
  }

  /* el grupo recorta lo que se salga del panel, asi el formulario nunca
     invade el panel azul mientras sube; el fondo evita huecos entre capturas */
  html[data-transicion='swap']::view-transition-group(panel-form) {
    overflow: clip;
    background: var(--primary-50);
  }

  /* normal en vez de plus-lighter: evita que el formulario "brille" mientras
     las dos capturas se superponen */
  html[data-transicion='swap']::view-transition-old(panel-form),
  html[data-transicion='swap']::view-transition-new(panel-form) {
    mix-blend-mode: normal;
  }


/* El formulario actual sube lentamente y desaparece */
@keyframes gr-form-sale {
  0% {
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
  }

  45% {
    opacity: 0.85;
  }

  100% {
    transform: translateY(-110px);
    opacity: 0;
    filter: blur(2px);
  }
}

/* El nuevo formulario se revela desde abajo */
@keyframes gr-form-entra {
  0% {
    transform: translateY(100px);
    opacity: 0;
    clip-path: inset(100% 0 0 0);
  }

  35% {
    opacity: 0.5;
  }

  100% {
    transform: translateY(0);
    opacity: 1;
    clip-path: inset(0 0 0 0);
  }
}

/* El formulario anterior sale con un movimiento pausado */
html[data-transicion='swap']::view-transition-old(panel-form) {
  animation: 0.65s cubic-bezier(0.55, 0, 0.75, 0.2) both gr-form-sale;
}

/* El nuevo formulario aparece con un efecto de revelado */
html[data-transicion='swap']::view-transition-new(panel-form) {
  animation: 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both gr-form-entra;
}


  /* el formulario actual sube y se desvanece */
  html[data-transicion='swap']::view-transition-old(panel-form) {
    animation: 0.35s cubic-bezier(0.55, 0, 0.75, 0.2) both gr-form-sale;
  }
  /* el formulario nuevo entra desde abajo hacia arriba, con un pequeno retraso */
  html[data-transicion='swap']::view-transition-new(panel-form) {
    animation: 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both gr-form-entra;
  }

  /* el resto de la pagina (el texto del panel azul cambia segun la vista)
     hace un fundido corto con la animacion por defecto del navegador */
  
html[data-transicion='swap']::view-transition-old(root),
html[data-transicion='swap']::view-transition-new(root) {
  animation-duration: 0.65s;
}


  /* push / volver: estilo "empujar" (sin cambios) */
  @keyframes gr-sale-izq { to { transform: translateX(-14%); opacity: 0; } }
  @keyframes gr-entra-der { from { transform: translateX(14%); opacity: 0; } }
  @keyframes gr-sale-der { to { transform: translateX(14%); opacity: 0; } }
  @keyframes gr-entra-izq { from { transform: translateX(-14%); opacity: 0; } }

  html[data-transicion='push']::view-transition-old(root) {
    animation: 0.5s cubic-bezier(0.55, 0, 0.75, 0.2) both gr-sale-izq;
  }
  html[data-transicion='push']::view-transition-new(root) {
    animation: 0.65s cubic-bezier(0.22, 1, 0.36, 1) both gr-entra-der;
  }
  html[data-transicion='volver']::view-transition-old(root) {
    animation: 0.5s cubic-bezier(0.55, 0, 0.75, 0.2) both gr-sale-der;
  }
  html[data-transicion='volver']::view-transition-new(root) {
    animation: 0.65s cubic-bezier(0.22, 1, 0.36, 1) both gr-entra-izq;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-group(*),
    ::view-transition-old(*),
    ::view-transition-new(*) {
      animation-duration: 0.01s !important;
    }
  }
</style>