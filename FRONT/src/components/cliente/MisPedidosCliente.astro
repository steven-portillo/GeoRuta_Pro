---
// src/components/cliente/MisPedidosCliente.astro

interface Metricas {
  total: number;
  enTransito: number;
  entregados: number;
  cancelados: number;
  pendientes: number;
  totalGastado: number;
  esteMes: number;
}

interface PedidoResumen {
  id: number;
  total: number;
  fecha: string;
  estado: string;
  empresa: string;
  empresaLogo: string;
  direccion: string;
  metodoPago: string;
  pagoConfirmado: boolean;
  totalItems: number;
}

interface PedidoActivo {
  id: number;
  estado: string;
  empresa: string;
  total: number;
  direccion: string;
  productosLista: string;
  totalItems: number;
}

interface Props {
  metricas: Metricas;
  pedidos: PedidoResumen[];
  pedidoActivo: PedidoActivo | null;
}

const { metricas, pedidos, pedidoActivo } = Astro.props;

// mismos colores por estado en toda la vista (tarjetas del historial, badge del
// pedido activo y el modal de detalle usan esta misma paleta)
const COLORES_ESTADO: Record<string, { fondo: string; acento: string }> = {
  pendiente: { fondo: '#fef3c7', acento: '#d97706' },
  'en preparacion': { fondo: '#dbeafe', acento: '#1d4ed8' },
  'en transito': { fondo: '#f3e8ff', acento: '#7c3aed' },
  entregado: { fondo: '#dcfce7', acento: '#16a34a' },
  cancelado: { fondo: '#fee2e2', acento: '#dc2626' },
};

// quita tildes para no depender de si el backend manda "En transito" o "En tránsito"
function normalizar(texto: string): string {
  return texto
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();
}

function colorDeEstado(estado: string) {
  return COLORES_ESTADO[normalizar(estado)] ?? { fondo: '#f1f5f9', acento: '#64748b' };
}

// pasos del stepper del pedido activo (se comparan normalizados)
const PASOS_TRACKING = ['Pendiente', 'En preparacion', 'En transito', 'Entregado'];

function formatearFecha(fecha: string): string {
  return new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }).format(
    new Date(fecha),
  );
}

const pasoActivoIndice = pedidoActivo
  ? PASOS_TRACKING.findIndex((paso) => normalizar(paso) === normalizar(pedidoActivo.estado))
  : -1;
const pedidoActivoCancelado = pedidoActivo ? normalizar(pedidoActivo.estado) === 'cancelado' : false;
---

<!-- ── metricas ── -->
<div class="grilla-metricas">
  <div class="metrica-card">
    <div class="metrica-valor">{metricas.total}</div>
    <div class="metrica-label">Pedidos totales</div>
  </div>
  <div class="metrica-card" style={`background:${COLORES_ESTADO['en transito'].fondo}`}>
    <div class="metrica-valor" style={`color:${COLORES_ESTADO['en transito'].acento}`}>{metricas.enTransito}</div>
    <div class="metrica-label">En tránsito</div>
  </div>
  <div class="metrica-card" style={`background:${COLORES_ESTADO.entregado.fondo}`}>
    <div class="metrica-valor" style={`color:${COLORES_ESTADO.entregado.acento}`}>{metricas.entregados}</div>
    <div class="metrica-label">Entregados</div>
  </div>
  <div class="metrica-card">
    <div class="metrica-valor">{metricas.esteMes}</div>
    <div class="metrica-label">Este mes</div>
  </div>
  <div class="metrica-card">
    <div class="metrica-valor">${metricas.totalGastado.toLocaleString('es-CO')}</div>
    <div class="metrica-label">Total gastado</div>
  </div>
</div>

<!-- ── pedido activo destacado ── -->
{pedidoActivo && (
  <div class="seccion-activo">
    <div class="encabezado-seccion">
      <span class="titulo-seccion">Pedido en curso</span>
    </div>

    <a class="tarjeta-activo" href={`/cliente/pedidos/${pedidoActivo.id}`}>
      <div class="activo-encabezado">
        <div>
          <div class="activo-empresa">{pedidoActivo.empresa}</div>
          <div class="activo-productos">{pedidoActivo.productosLista || `${pedidoActivo.totalItems} producto(s)`}</div>
        </div>
        <div
          class="badge-estado grande"
          style={`background:${colorDeEstado(pedidoActivo.estado).fondo};color:${colorDeEstado(pedidoActivo.estado).acento}`}
        >
          {pedidoActivo.estado}
        </div>
      </div>

      {pedidoActivoCancelado ? (
        <div class="activo-cancelado">Este pedido fue cancelado.</div>
      ) : (
        <div class="stepper-tracking">
          {PASOS_TRACKING.map((paso, indice) => (
            <div class={`paso-tracking ${indice <= pasoActivoIndice ? 'completado' : ''} ${indice === pasoActivoIndice ? 'actual' : ''}`}>
              <div class="paso-punto"></div>
              <div class="paso-label">{paso === 'En preparacion' ? 'En preparación' : paso === 'En transito' ? 'En tránsito' : paso}</div>
            </div>
          ))}
        </div>
      )}

      <div class="activo-pie">
        <div class="activo-direccion">📍 {pedidoActivo.direccion}</div>
        <div class="activo-total">${pedidoActivo.total.toLocaleString('es-CO')}</div>
      </div>
    </a>
  </div>
)}

<!-- ── historial ── -->
<div class="seccion-historial">
  <div class="encabezado-seccion">
    <span class="titulo-seccion">Historial de pedidos</span>
  </div>

  {pedidos.length === 0 ? (
    <div class="historial-vacio">
      <p>Aún no tienes pedidos.</p>
      <a href="/cliente/catalogo" class="enlace-catalogo">Ir al catálogo →</a>
    </div>
  ) : (
    <div class="grilla-pedidos" id="grilla-pedidos">
      {pedidos.map((pedido) => {
        const color = colorDeEstado(pedido.estado);
        return (
                    <a class="tarjeta-pedido" href={`/cliente/pedidos/${pedido.id}`}>
            <div class="pedido-encabezado">
              {pedido.empresaLogo ? (
                <img src={pedido.empresaLogo} alt={pedido.empresa} class="pedido-logo" data-fallback="empresa" />
              ) : null}
              <div class="pedido-logo-placeholder" style={`display:${pedido.empresaLogo ? 'none' : 'flex'}`}>
                {pedido.empresa.charAt(0).toUpperCase()}
              </div>
              <div class="pedido-info-top">
                <div class="pedido-empresa">{pedido.empresa}</div>
                <div class="pedido-fecha">{formatearFecha(pedido.fecha)}</div>
              </div>
              <div class="badge-estado" style={`background:${color.fondo};color:${color.acento}`}>
                {pedido.estado}
              </div>
            </div>

            <div class="pedido-direccion">📍 {pedido.direccion}</div>

            <div class="pedido-pie">
              <div class="pedido-items">{pedido.totalItems} producto(s)</div>
              <div class="pedido-pago">
                {pedido.pagoConfirmado ? (
                  <span class="pago-ok">✓ Pagado</span>
                ) : (
                  <span class="pago-pendiente">Pago pendiente</span>
                )}
              </div>
              <div class="pedido-total">${pedido.total.toLocaleString('es-CO')}</div>
            </div>
          </a>
        );
      })}
    </div>
  )}
</div>


<script>
  
  // logo de empresa roto -> placeholder con inicial (igual patron que el catalogo)
  document.getElementById('grilla-pedidos')?.addEventListener(
    'error',
    (evento) => {
      const img = evento.target as HTMLImageElement;
      if (!img.dataset?.fallback) return;
      img.style.display = 'none';
      const placeholder = img.nextElementSibling as HTMLElement | null;
      if (placeholder) placeholder.style.display = 'flex';
    },
    true,
  );

</script>

<style>
  .encabezado-seccion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .titulo-seccion {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--secondary-800);
  }

  /* ── metricas ── */
  .grilla-metricas {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
    margin-bottom: 1.25rem;
  }

  .metrica-card {
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    text-align: center;
  }

  .metrica-valor {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--secondary-900);
  }

  .metrica-label {
    font-size: 0.7rem;
    color: var(--secondary-500);
    font-weight: 600;
    margin-top: 2px;
  }

  /* ── badge de estado (compartido: pedido activo, tarjetas, modal) ── */
  .badge-estado {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .badge-estado.grande {
    font-size: 0.82rem;
    padding: 6px 14px;
  }

  /* ── pedido activo ── */
  .seccion-activo {
    margin-bottom: 1.5rem;
  }

  .tarjeta-activo {
    display: block;            
    text-decoration: none;     
    color: inherit;            
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    cursor: pointer;
    transition: box-shadow 0.15s;
  }

  .tarjeta-activo:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .activo-encabezado {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .activo-empresa {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--secondary-900);
  }

  .activo-productos {
    font-size: 0.8rem;
    color: var(--secondary-500);
    margin-top: 2px;
    max-width: 480px;
  }

  .activo-cancelado {
    background: #fee2e2;
    color: #dc2626;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .stepper-tracking {
    display: flex;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .paso-tracking {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    text-align: center;
  }

  .paso-tracking:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 7px;
    left: 50%;
    width: 100%;
    height: 2px;
    background: var(--secondary-200);
    z-index: 0;
  }

  .paso-tracking.completado:not(:last-child)::after {
    background: var(--primary-500);
  }

  .paso-punto {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--secondary-200);
    border: 2px solid white;
    box-shadow: 0 0 0 2px var(--secondary-200);
    z-index: 1;
    margin-bottom: 6px;
  }

  .paso-tracking.completado .paso-punto {
    background: var(--primary-600);
    box-shadow: 0 0 0 2px var(--primary-600);
  }

  .paso-tracking.actual .paso-punto {
    box-shadow: 0 0 0 4px var(--primary-100), 0 0 0 2px var(--primary-600);
  }

  .paso-label {
    font-size: 0.7rem;
    color: var(--secondary-400);
    font-weight: 600;
  }

  .paso-tracking.completado .paso-label {
    color: var(--secondary-800);
  }

  .activo-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--secondary-100);
  }

  .activo-direccion {
    font-size: 0.8rem;
    color: var(--secondary-500);
  }

  .activo-total {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--primary-700);
  }

  /* ── historial ── */
  .historial-vacio {
    background: white;
    border: 1px dashed var(--secondary-200);
    border-radius: 14px;
    padding: 3rem;
    text-align: center;
    color: var(--secondary-400);
  }

  .enlace-catalogo {
    display: inline-block;
    margin-top: 8px;
    color: var(--primary-600);
    font-weight: 600;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .grilla-pedidos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .tarjeta-pedido {
    display: block;            
    text-decoration: none;     
    color: inherit;            
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 14px;
    padding: 1rem 1.1rem;
    cursor: pointer;
    transition: all 0.15s;
  }

  .tarjeta-pedido:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .pedido-encabezado {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 0.75rem;
  }

  .pedido-logo,
  .pedido-logo-placeholder {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .pedido-logo-placeholder {
    background: var(--primary-900);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .pedido-info-top {
    flex: 1;
    min-width: 0;
  }

  .pedido-empresa {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--secondary-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pedido-fecha {
    font-size: 0.72rem;
    color: var(--secondary-400);
  }

  .pedido-direccion {
    font-size: 0.78rem;
    color: var(--secondary-500);
    margin-bottom: 0.75rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pedido-pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--secondary-100);
  }

  .pedido-items {
    font-size: 0.72rem;
    color: var(--secondary-400);
  }

  .pago-ok {
    font-size: 0.72rem;
    color: #16a34a;
    font-weight: 600;
  }

  .pago-pendiente {
    font-size: 0.72rem;
    color: #d97706;
    font-weight: 600;
  }

  .pedido-total {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--secondary-900);
  }


  @media (max-width: 900px) {
    .grilla-metricas {
      grid-template-columns: repeat(3, 1fr);
    }

    .grilla-pedidos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .grilla-metricas {
      grid-template-columns: repeat(2, 1fr);
    }

    .grilla-pedidos {
      grid-template-columns: 1fr;
    }

    .mped-datos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>