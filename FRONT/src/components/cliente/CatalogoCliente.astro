  .modal-producto-nav { position: absolute; top: 50%; z-index: 1; width: 40px; height: 40px; border: 1px solid rgba(255,255,255,.85); border-radius: 50%; background: rgba(255,255,255,.92); color: var(--secondary-800); font-size: 1.7rem; line-height: 1; cursor: pointer; box-shadow: 0 4px 14px rgba(15,23,42,.16); transform: translateY(-50%); transition: background-color 160ms ease, transform 160ms ease; }
