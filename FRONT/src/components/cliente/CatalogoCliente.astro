  .empresas-carrusel-botones button { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #cbd5e1; border-radius: 50%; background: #fff; color: #334155; font-size: 1.25rem; line-height: 1; cursor: pointer; transition: background-color 160ms ease, transform 160ms ease; }
  .empresas-carrusel-botones button:hover { background: #f8fafc; transform: scale(1.06); }
  .empresas-carrusel-botones button[aria-label="Pausar carrusel"] { font-size: 0.78rem; }

  @keyframes empresas-slide-entrada { from { opacity: 0.55; } to { opacity: 1; } }
  @keyframes empresas-texto-entrada { from { opacity: 0; transform: translateX(-18px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes empresas-marca-entrada { from { opacity: 0; transform: translate(18px, -50%) scale(0.92); } to { opacity: 1; transform: translate(0, -50%) scale(1); } }
  @keyframes empresas-orbita { to { transform: rotate(360deg); } }

