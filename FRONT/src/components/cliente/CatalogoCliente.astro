  .empresas-slide-etiqueta span { width: 7px; height: 7px; border-radius: 50%; background: #86efac; box-shadow: 0 0 0 4px rgba(134, 239, 172, 0.2); }
  .empresas-slide-texto h2 { max-width: 16ch; margin: 0 0 0.55rem; color: #0f172a; font-family: var(--font-display); font-size: clamp(1.65rem, 3.6vw, 2.8rem); font-weight: 800; letter-spacing: -0.045em; line-height: 1.08; text-wrap: balance; }
  .empresas-slide-texto p { display: -webkit-box; max-width: 48ch; overflow: hidden; margin: 0 0 1.1rem; color: #475569; font-size: clamp(0.82rem, 1.3vw, 0.95rem); line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }

  .empresas-slide-accion {
    display: inline-flex;
    align-items: center;
