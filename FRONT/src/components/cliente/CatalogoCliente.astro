---
// src/components/cliente/CatalogoCliente.astro
import CheckoutCliente from './CheckoutCliente.astro';

interface ProveedorCard {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
  portadaUrl: string;
}

interface Props {
  proveedores: ProveedorCard[];
}

const { proveedores } = Astro.props;
const backendUrlPublico = (
  import.meta.env.PUBLIC_API_DENO ||
  import.meta.env.API_DENO ||
  import.meta.env.PUBLIC_BACKEND_URL ||
  'http://127.0.0.1:8005'
).replace(/\/+$/, '');
---

<div class="dos-columnas" id="dos-columnas" data-vista="empresas">
  <!-- ── columna izquierda: proveedores/productos ── -->
  <div class="catalogo-vista">
    <button class="boton-volver" id="btn-volver" style="display:none;">⬅ Volver</button>

    <div class="catalogo-intro" id="encabezado-empresas">
      <div>
        <span class="catalogo-eyebrow">CATÁLOGO DE MARCAS</span>
        <h1>Encuentra tu próxima favorita</h1>
        <p>Explora empresas y descubre todo lo que tienen para ofrecerte.</p>
      </div>
      <span class="catalogo-cantidad" id="cantidad-empresas"></span>
    </div>

    <section class="empresas-carrusel" id="empresas-carrusel" aria-label="Empresas destacadas">
      <div class="empresas-carrusel-contenido" id="empresas-carrusel-contenido" aria-live="polite"></div>
      <div class="empresas-carrusel-controles">
        <div class="empresas-carrusel-puntos" id="empresas-carrusel-puntos"></div>
        <div class="empresas-carrusel-botones">
          <button type="button" id="empresas-carrusel-pausa" aria-label="Pausar carrusel">Ⅱ</button>
          <button type="button" id="empresas-carrusel-anterior" aria-label="Empresa anterior">‹</button>
          <button type="button" id="empresas-carrusel-siguiente" aria-label="Empresa siguiente">›</button>
        </div>
      </div>
    </section>

    <div class="barra-busqueda">
      <label class="busqueda-empresas">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m16 16 4.5 4.5"></path></svg>
        <input class="campo-busqueda" type="text" placeholder="Buscar empresa..." id="campo-busqueda" />
      </label>
      <select class="selector-categoria" id="selector-categoria">
        <option value="">Todas las categorías</option>
      </select>
    </div>

    <div class="grilla-productos" id="grilla-productos"></div>
  </div>

  <!-- ── columna derecha: carrito (oculta mientras esta vacio) ── -->
  <div class="columna-carrito" id="columna-carrito">
    <div class="panel-carrito">
      <div class="titulo-carrito">Carrito</div>
      <div id="contenido-carrito"></div>
      <div id="resumen-carrito" style="display:none;">
        <hr class="separador-carrito" />
        <div class="fila-total">
          <span class="etiqueta-total">Subtotal</span>
          <span class="valor-total" id="subtotal-carrito">$0</span>
        </div>
        <div class="fila-total">
          <span class="etiqueta-total">Envío</span>
          <span class="valor-total">$8.000</span>
        </div>
        <div class="fila-total">
          <span class="etiqueta-total">Total</span>
          <span class="valor-total grande" id="total-carrito">$0</span>
        </div>
        <button class="boton-confirmar-pedido" id="btn-confirmar-pedido">Confirmar pedido</button>
      </div>
    </div>
  </div>
</div>

<!-- ── modal de detalle de producto ── -->
<div id="modal-producto" class="modal-producto-overlay">
  <div class="modal-producto-caja">
    <button class="modal-producto-cerrar" id="mp-cerrar">×</button>
    <div class="modal-producto-grid">
      <div class="modal-producto-imagen-wrap" id="mp-imagen-wrap">
        <img id="mp-imagen" src="" alt="" class="modal-producto-imagen" data-fallback="modal" />
        <div id="mp-imagen-placeholder" class="modal-producto-imagen-placeholder"></div>
        <button type="button" id="mp-imagen-anterior" class="modal-producto-nav modal-producto-nav-anterior" aria-label="Ver imagen anterior" hidden>‹</button>
        <button type="button" id="mp-imagen-siguiente" class="modal-producto-nav modal-producto-nav-siguiente" aria-label="Ver imagen siguiente" hidden>›</button>
        <span id="mp-imagen-contador" class="modal-producto-contador" aria-live="polite" hidden></span>
      </div>
      <div class="modal-producto-info">
        <div id="mp-categoria" class="modal-producto-categoria"></div>
        <h2 id="mp-nombre" class="modal-producto-nombre"></h2>
        <p id="mp-descripcion" class="modal-producto-descripcion"></p>
        <div id="mp-precio" class="modal-producto-precio"></div>
        <div id="mp-stock" class="modal-producto-stock"></div>
        <div id="mp-cantidad-row" class="modal-producto-cantidad-row">
          <span>Cantidad</span>
          <div class="modal-producto-stepper">
            <button type="button" id="mp-restar">−</button>
            <input type="number" id="mp-cantidad" class="mp-cantidad-input" value="1" min="1" />
            <button type="button" id="mp-sumar">+</button>
          </div>
        </div>
        <button id="mp-btn-agregar" class="modal-producto-btn-agregar">+ Agregar al carrito</button>
      </div>
    </div>
  </div>
</div>

<!-- ── checkout: mapa de direccion + metodo de pago + Wompi ── -->
<CheckoutCliente />

<script define:vars={{ proveedoresIniciales: proveedores, backendUrlPublico }}>
  // ══════════════════════════════════════════════════════════
  // estado en memoria del navegador (se pierde al recargar la pagina,
  // igual que en el original — el carrito nunca se guarda en el backend
  // hasta que se confirma el pedido)
  // ══════════════════════════════════════════════════════════
  let proveedoresData = proveedoresIniciales;
  let productosActuales = [];
  let proveedorActual = null;
  let carrito = {}; // { [idProducto]: cantidad }

  let productoModalActual = null;
  let cantidadModalActual = 1;
  let imagenesModalActuales = [];
  let indiceImagenModalActual = 0;
  let indiceEmpresaCarrusel = 0;
  let temporizadorCarrusel = null;
  let carruselPausado = false;

  function resolverImagenBackend(url) {
    if (!url || /^(https?:|data:|blob:)/i.test(url)) return url;
    return `${backendUrlPublico}${url.startsWith('/') ? url : `/${url}`}`;
  }

  const grilla = document.getElementById('grilla-productos');
  const btnVolver = document.getElementById('btn-volver');
  const campoBusqueda = document.getElementById('campo-busqueda');
  const selectorCategoria = document.getElementById('selector-categoria');
  const encabezadoEmpresas = document.getElementById('encabezado-empresas');
  const cantidadEmpresas = document.getElementById('cantidad-empresas');
  const carruselEmpresas = document.getElementById('empresas-carrusel');
  const contenidoCarruselEmpresas = document.getElementById('empresas-carrusel-contenido');
  const puntosCarruselEmpresas = document.getElementById('empresas-carrusel-puntos');
  const botonPausaCarrusel = document.getElementById('empresas-carrusel-pausa');
  const movimientoReducido = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.addEventListener('error', (evento) => {
    const imagen = evento.target;
    if (!(imagen instanceof HTMLImageElement)) return;

    const tipoFallback = imagen.dataset.fallback;
    if (tipoFallback === 'slide-background') {
      imagen.remove();
    } else if (tipoFallback === 'slide-logo') {
      const placeholder = document.createElement('span');
      placeholder.className = 'empresas-slide-logo-placeholder';
      placeholder.textContent = (imagen.alt || 'E').charAt(0).toUpperCase();
      imagen.replaceWith(placeholder);
    } else if (tipoFallback === 'logo') {
      const contenedor = imagen.parentElement;
      imagen.remove();
      const placeholder = contenedor?.querySelector('.logo-placeholder-cat');
      if (placeholder) placeholder.style.display = 'flex';
    } else if (tipoFallback === 'producto') {
      const contenedor = imagen.parentElement;
      imagen.remove();
      const placeholder = contenedor?.querySelector('.producto-imagen-placeholder');
      if (placeholder) placeholder.style.display = 'flex';
    } else if (tipoFallback === 'modal') {
      imagen.style.display = 'none';
      document.getElementById('mp-imagen-placeholder').style.display = 'flex';
    } else if (tipoFallback === 'cart-product') {
      const placeholder = document.createElement('div');
      placeholder.textContent = (imagen.alt || 'P').charAt(0).toUpperCase();
      placeholder.style.cssText = 'width:40px;height:40px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-weight:700;color:#94a3b8;flex-shrink:0';
      imagen.replaceWith(placeholder);
    }
  }, true);

  function actualizarCantidadEmpresas(cantidad) {
    if (cantidadEmpresas) {
      cantidadEmpresas.textContent = `${cantidad} ${cantidad === 1 ? 'empresa' : 'empresas'}`;
    }
  }

  function renderizarSlideEmpresa() {
    if (!proveedoresData.length || !contenidoCarruselEmpresas) return;
    indiceEmpresaCarrusel = (indiceEmpresaCarrusel + proveedoresData.length) % proveedoresData.length;
    const empresa = proveedoresData[indiceEmpresaCarrusel];
    const nombre = escaparHtml(empresa.nombre);
    const descripcion = escaparHtml(empresa.descripcion || 'Conoce sus productos y novedades.');
    const inicial = escaparHtml((empresa.nombre || 'E').charAt(0).toUpperCase());
    const logo = empresa.logoUrl
      ? `<img class="empresas-slide-logo" src="${escaparHtml(empresa.logoUrl)}" alt="${nombre}" data-fallback="slide-logo" />`
      : `<span class="empresas-slide-logo-placeholder">${inicial}</span>`;
    const fondo = empresa.logoUrl
      ? `<img class="empresas-slide-fondo" src="${escaparHtml(empresa.logoUrl)}" alt="" aria-hidden="true" data-fallback="slide-background" />`
      : '';

    contenidoCarruselEmpresas.innerHTML = `
      <div class="empresas-slide" data-slide="${indiceEmpresaCarrusel}" style="">
        ${fondo}
        <div class="empresas-slide-trama" aria-hidden="true"></div>
        <div class="empresas-slide-texto">
          <span class="empresas-slide-etiqueta"><span></span> MARCA DESTACADA</span>
          <h2>${nombre}</h2>
          <p>${descripcion}</p>
          <button type="button" class="empresas-slide-accion" data-accion="ver-proveedor" data-id="${Number(empresa.id)}">
            Explorar catálogo <span aria-hidden="true">→</span>
          </button>
        </div>
        <div class="empresas-slide-marca" aria-hidden="true">
          <span class="empresas-slide-orbita"></span>
          ${logo}
        </div>
      </div>`;

    if (puntosCarruselEmpresas) {
      puntosCarruselEmpresas.replaceChildren(...proveedoresData.map((proveedor, indice) => {
        const punto = document.createElement('button');
        punto.type = 'button';
        punto.className = 'empresas-carrusel-punto';
        punto.setAttribute('aria-label', `Mostrar ${proveedor.nombre}`);
        punto.setAttribute('aria-current', indice === indiceEmpresaCarrusel ? 'true' : 'false');
        punto.addEventListener('click', () => {
          indiceEmpresaCarrusel = indice;
          renderizarSlideEmpresa();
          reiniciarTemporizadorCarrusel();
        });
        return punto;
      }));
    }
    actualizarControlesCarrusel();
  }

  function actualizarControlesCarrusel() {
    const hayVariasEmpresas = proveedoresData.length > 1;
    const anterior = document.getElementById('empresas-carrusel-anterior');
    const siguiente = document.getElementById('empresas-carrusel-siguiente');
    if (anterior) anterior.hidden = !hayVariasEmpresas;
    if (siguiente) siguiente.hidden = !hayVariasEmpresas;
    if (botonPausaCarrusel) {
      botonPausaCarrusel.hidden = !hayVariasEmpresas;
      botonPausaCarrusel.textContent = carruselPausado ? '▶' : 'Ⅱ';
      botonPausaCarrusel.setAttribute('aria-label', carruselPausado ? 'Reanudar carrusel' : 'Pausar carrusel');
    }
    if (puntosCarruselEmpresas) puntosCarruselEmpresas.hidden = !hayVariasEmpresas;
  }

  function detenerTemporizadorCarrusel() {
    if (temporizadorCarrusel !== null) {
      window.clearInterval(temporizadorCarrusel);
      temporizadorCarrusel = null;
    }
  }

  function reiniciarTemporizadorCarrusel() {
    detenerTemporizadorCarrusel();
    if (proveedoresData.length < 2 || carruselPausado || movimientoReducido.matches) return;
    temporizadorCarrusel = window.setInterval(() => {
      indiceEmpresaCarrusel++;
      renderizarSlideEmpresa();
    }, 6000);
  }

  function moverCarruselEmpresas(delta) {
    indiceEmpresaCarrusel += delta;
    renderizarSlideEmpresa();
    reiniciarTemporizadorCarrusel();
  }

  // ── toast simple (reemplaza mostrarToast del script global original) ──
  function mostrarToast(mensaje, esError = false) {
    const toast = document.createElement('div');
    toast.textContent = mensaje;
    toast.style.cssText = `
      position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
      background:${esError ? '#dc2626' : '#1e293b'}; color:white;
      padding:0.65rem 1.1rem; border-radius:10px; font-size:0.85rem;
      z-index:9999; box-shadow:0 8px 24px rgba(0,0,0,0.2);
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  // ══════════════════════════════════════════════════════════
  // renderizar proveedores / productos
  // ══════════════════════════════════════════════════════════

  // escapa texto de usuario (nombre/descripcion de empresa) antes de meterlo en innerHTML
  function escaparHtml(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  // tarjeta de empresa: portada, identidad de marca y acceso al catálogo,
  // descripcion y boton "Ver catalogo". toda la tarjeta es clickeable (data-accion)
  function plantillaProveedor(p) {
    const nombre = escaparHtml(p.nombre);
    const inicial = escaparHtml((p.nombre || 'E').charAt(0).toUpperCase());
    return `
      <div class="tarjeta-proveedor" data-accion="ver-proveedor" data-id="${p.id}">
        <div class="proveedor-portada">
          ${p.portadaUrl
            ? `<img src="${escaparHtml(p.portadaUrl)}" class="proveedor-portada-img" alt="" data-fallback="portada" />`
            : `<span class="proveedor-portada-inicial" aria-hidden="true">${inicial}</span>`}
          <span class="proveedor-portada-brillo" aria-hidden="true"></span>
          <span class="proveedor-disponible"><span></span>Catálogo disponible</span>
        </div>
        <div class="proveedor-logo">
          ${p.logoUrl ? `<img src="${escaparHtml(p.logoUrl)}" alt="${nombre}" data-fallback="logo" />` : ''}
          <div class="logo-placeholder-cat" style="display:${p.logoUrl ? 'none' : 'flex'}">${inicial}</div>
        </div>
        <div class="proveedor-info">
          <div class="proveedor-nombre">${nombre}<span class="proveedor-chevron" aria-hidden="true">↗</span></div>
          <p class="proveedor-desc">${escaparHtml(p.descripcion)}</p>
          <button type="button" class="boton-ver-catalogo" data-accion="ver-proveedor" data-id="${p.id}">
            <span>Ver productos</span><span aria-hidden="true">→</span>
          </button>
        </div>
      </div>`;
  }

  function renderizarProveedores() {
    proveedorActual = null;
    document.getElementById('dos-columnas')?.setAttribute('data-vista', 'empresas');
    grilla.classList.remove('con-productos');
    if (btnVolver) { btnVolver.style.display = 'none'; btnVolver.style.opacity = '1'; }
    if (selectorCategoria) selectorCategoria.innerHTML = '<option value="">Todas las categorías</option>';
    if (campoBusqueda) campoBusqueda.value = '';
    if (campoBusqueda) campoBusqueda.placeholder = 'Buscar empresa...';
    if (encabezadoEmpresas) encabezadoEmpresas.hidden = false;
    actualizarCantidadEmpresas(proveedoresData.length);
    if (carruselEmpresas) carruselEmpresas.hidden = !proveedoresData.length;

    if (!proveedoresData.length) {
      detenerTemporizadorCarrusel();
      grilla.innerHTML = `
        <div class="empresa-estado-vacio">
          <span class="empresa-estado-icono" aria-hidden="true">✦</span>
          <h2>Pronto habrá más marcas</h2>
          <p>Por ahora no hay empresas disponibles. Vuelve a visitarnos pronto.</p>
        </div>`;
      return;
    }

    renderizarSlideEmpresa();
    reiniciarTemporizadorCarrusel();
    grilla.innerHTML = proveedoresData.map(plantillaProveedor).join('');
  }

  function filtrarEmpresas() {
    if (proveedorActual) return;
    const texto = campoBusqueda?.value.toLowerCase().trim() ?? '';
    const filtradas = proveedoresData.filter(
      (e) => e.nombre.toLowerCase().includes(texto) || (e.descripcion ?? '').toLowerCase().includes(texto),
    );
    actualizarCantidadEmpresas(filtradas.length);

    if (!filtradas.length) {
      grilla.innerHTML = `
        <div class="empresa-estado-vacio">
          <span class="empresa-estado-icono" aria-hidden="true">⌕</span>
          <h2>No encontramos esa marca</h2>
          <p>Prueba con otro nombre o revisa la escritura de “${escaparHtml(texto)}”.</p>
        </div>`;
      return;
    }

    grilla.innerHTML = filtradas.map(plantillaProveedor).join('');
  }

  async function verProductosProveedor(idEmpresa) {
    proveedorActual = proveedoresData.find((p) => Number(p.id) === Number(idEmpresa));
    document.getElementById('dos-columnas')?.setAttribute('data-vista', 'productos');
    grilla.classList.add('con-productos');
    if (encabezadoEmpresas) encabezadoEmpresas.hidden = true;
    if (carruselEmpresas) carruselEmpresas.hidden = true;
    detenerTemporizadorCarrusel();
    if (campoBusqueda) campoBusqueda.placeholder = 'Buscar producto...';
    grilla.innerHTML = '<p style="color:#94a3b8;padding:2rem">Cargando productos...</p>';
    if (btnVolver) btnVolver.style.display = 'inline-flex';

    try {
      // llama al proxy BFF (archivo 12), nunca directo al backend deno
      const res = await fetch(`/api/auth/cliente/proveedores/${idEmpresa}/productos`);
      const data = await res.json();

      if (!data.success || !data.data?.length) {
        grilla.innerHTML = `
          <div style="padding:3rem;text-align:center;color:#94a3b8">
            <p style="font-size:1.1rem;margin-bottom:8px">Sin productos disponibles</p>
            <p style="font-size:0.85rem">Este proveedor aún no tiene productos activos.</p>
          </div>`;
        return;
      }

      productosActuales = data.data.map((producto) => ({
        ...producto,
        imagenUrl: resolverImagenBackend(producto.imagenUrl),
      }));

      if (selectorCategoria) {
        const categorias = [...new Set(productosActuales.map((p) => p.categoria))].sort();
        selectorCategoria.innerHTML =
          '<option value="">Todas las categorías</option>' +
          categorias.map((c) => `<option value="${c}">${c}</option>`).join('');
      }

      renderizarCatalogo(productosActuales);
    } catch (err) {
      console.error('error cargando productos:', err);
      grilla.innerHTML = '<p style="color:#ef4444;padding:2rem">Error al cargar productos.</p>';
    }
  }

  function renderizarCatalogo(lista) {
    if (!lista.length) {
      grilla.innerHTML = '<p style="color:#94a3b8;padding:2rem">No se encontraron productos.</p>';
      return;
    }

    grilla.innerHTML = lista
      .map((p) => {
        const idNum = Number(p.id);
        const precio = Number(p.precio);
        const stock = Number(p.stock);
        const sinStock = stock === 0;

        return `
        <div class="tarjeta-producto">
          <div class="producto-imagen-wrap" data-accion="abrir-producto" data-id="${idNum}" style="cursor:pointer">
            ${p.imagenUrl ? `<img src="${escaparHtml(resolverImagenBackend(p.imagenUrl))}" class="producto-imagen" alt="${escaparHtml(p.nombre)}" data-fallback="producto" />` : ''}
            <div class="producto-imagen-placeholder" style="display:${p.imagenUrl ? 'none' : 'flex'}">
              ${(p.nombre || 'P').charAt(0).toUpperCase()}
            </div>
          </div>
          <div class="producto-info">
            <div class="nombre-producto" data-accion="abrir-producto" data-id="${idNum}" style="cursor:pointer">${p.nombre}</div>
            <div class="categoria-producto">${p.categoria}</div>
            ${p.descripcion ? `<div class="desc-producto">${p.descripcion}</div>` : ''}
            <div class="precio-producto">$${precio.toLocaleString('es-CO')}</div>
            <div class="stock-producto" style="color:${sinStock ? '#ef4444' : '#94a3b8'}">
              ${sinStock ? '⚠ Sin stock' : `Stock: ${stock} uds`}
            </div>
          </div>
          <button class="boton-agregar-carrito" data-accion="agregar-carrito" data-id="${idNum}" ${sinStock ? 'disabled' : ''}>
            ${sinStock ? 'Sin stock' : '+ Agregar'}
          </button>
        </div>`;
      })
      .join('');
  }

  function filtrarCatalogo() {
    if (!productosActuales.length) return;
    const texto = campoBusqueda?.value.toLowerCase() ?? '';
    const categoria = selectorCategoria?.value ?? '';
    const filtrados = productosActuales.filter(
      (p) => p.nombre.toLowerCase().includes(texto) && (!categoria || p.categoria === categoria),
    );
    renderizarCatalogo(filtrados);
  }

  function volverAProveedores() {
    const haySelecciones = Object.values(carrito).some((c) => c > 0);
    if (haySelecciones) {
      const confirmar = confirm('⚠️ Tienes productos en el carrito.\n\n¿Deseas vaciar el carrito y volver a los proveedores?');
      if (!confirmar) return;
      carrito = {};
      renderizarCarrito();
    }
    productosActuales = [];
    proveedorActual = null;
    if (campoBusqueda) campoBusqueda.value = '';
    renderizarProveedores();
  }

  // ══════════════════════════════════════════════════════════
  // carrito
  // ══════════════════════════════════════════════════════════

  function agregarAlCarrito(id, cantidad = 1) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    if (!producto) return;

    const cantidadActual = carrito[idNum] || 0;
    const nuevaCantidad = cantidadActual + cantidad;

    if (nuevaCantidad > Number(producto.stock)) {
      mostrarToast('⚠️ No hay más stock disponible.', true);
      return;
    }

    carrito[idNum] = nuevaCantidad;
    renderizarCarrito();
  }

  function cambiarCantidad(id, delta) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    const nuevaCantidad = (carrito[idNum] || 0) + delta;

    if (nuevaCantidad <= 0) {
      delete carrito[idNum];
    } else if (producto && nuevaCantidad > Number(producto.stock)) {
      mostrarToast('⚠️ Stock máximo alcanzado.', true);
      return;
    } else {
      carrito[idNum] = nuevaCantidad;
    }
    renderizarCarrito();
  }

  function setCantidad(id, input) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    const nuevo = parseInt(input.value, 10);

    if (isNaN(nuevo) || nuevo <= 0) {
      if (confirm('⚠️ ¿Deseas eliminar este producto del carrito?')) {
        delete carrito[idNum];
      } else {
        input.value = carrito[idNum];
      }
      renderizarCarrito();
      return;
    }

    if (producto && nuevo > Number(producto.stock)) {
      mostrarToast(`⚠️ Stock máximo disponible: ${producto.stock} uds.`, true);
      input.value = carrito[idNum];
      return;
    }

    carrito[idNum] = nuevo;
    renderizarCarrito();
  }

  function renderizarCarrito() {
    const contenido = document.getElementById('contenido-carrito');
    const resumen = document.getElementById('resumen-carrito');
    if (!contenido) return;

    const ids = Object.keys(carrito).filter((id) => carrito[id] > 0);

    if (btnVolver && proveedorActual) {
      btnVolver.style.opacity = ids.length > 0 ? '0.6' : '1';
      btnVolver.title = ids.length > 0 ? 'Vacía el carrito para volver' : 'Volver a proveedores';
    }

    // el carrito solo existe visualmente cuando hay al menos un producto: al agregar el
    // primero aparece en la columna derecha y al quitar el ultimo desaparece, devolviendole
    // todo el ancho a la grilla de productos
    document.getElementById('dos-columnas')?.classList.toggle('con-carrito', ids.length > 0);

    if (!ids.length) {
      contenido.innerHTML = '';
      if (resumen) resumen.style.display = 'none';
      return;
    }

    let subtotal = 0;
    contenido.innerHTML = ids
      .map((id) => {
        const idNum = Number(id);
        const p = productosActuales.find((x) => Number(x.id) === idNum);
        if (!p) return '';
        const cantidad = carrito[idNum];
        const total = Number(p.precio) * cantidad;
        subtotal += total;

        return `
        <div class="item-carrito">
          ${
            p.imagenUrl
              ? `<img src="${escaparHtml(resolverImagenBackend(p.imagenUrl))}" alt="${escaparHtml(p.nombre)}" data-fallback="cart-product" style="width:40px;height:40px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0;flex-shrink:0">`
              : `<div style="width:40px;height:40px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-weight:700;color:#94a3b8;flex-shrink:0">${(p.nombre || 'P').charAt(0).toUpperCase()}</div>`
          }
          <div style="flex:1;min-width:0">
            <div class="nombre-item-carrito">${p.nombre}</div>
            <div style="font-size:0.72rem;color:#94a3b8">$${Number(p.precio).toLocaleString('es-CO')} c/u</div>
          </div>
          <div class="controles-cantidad">
            <button class="boton-cantidad" data-accion="restar-item" data-id="${idNum}">−</button>
            <input class="valor-cantidad" type="number" min="1" max="${p.stock}" value="${cantidad}" data-accion="input-cantidad" data-id="${idNum}" />
            <button class="boton-cantidad" data-accion="sumar-item" data-id="${idNum}">+</button>
          </div>
          <div class="precio-item-carrito">$${total.toLocaleString('es-CO')}</div>
        </div>`;
      })
      .join('');

    const envio = 8000;
    document.getElementById('subtotal-carrito').textContent = '$' + subtotal.toLocaleString('es-CO');
    document.getElementById('total-carrito').textContent = '$' + (subtotal + envio).toLocaleString('es-CO');
    if (resumen) resumen.style.display = 'block';
  }

  // ══════════════════════════════════════════════════════════
  // modal de detalle de producto
  // ══════════════════════════════════════════════════════════

  function mostrarImagenModal(indice, direccion = 0) {
    if (!imagenesModalActuales.length) return;
    indiceImagenModalActual = (indice + imagenesModalActuales.length) % imagenesModalActuales.length;
    const imgEl = document.getElementById('mp-imagen');
    imgEl.src = resolverImagenBackend(imagenesModalActuales[indiceImagenModalActual]);
    imgEl.alt = `${productoModalActual.nombre}, imagen ${indiceImagenModalActual + 1}`;
    imgEl.style.display = 'block';
    document.getElementById('mp-imagen-placeholder').style.display = 'none';
    imgEl.classList.remove('mp-deslizar-izquierda', 'mp-deslizar-derecha');
    if (direccion !== 0) {
      void imgEl.offsetWidth;
      imgEl.classList.add(direccion > 0 ? 'mp-deslizar-derecha' : 'mp-deslizar-izquierda');
    }
    const mostrarControles = imagenesModalActuales.length > 1;
    document.getElementById('mp-imagen-anterior').hidden = !mostrarControles;
    document.getElementById('mp-imagen-siguiente').hidden = !mostrarControles;
    const contador = document.getElementById('mp-imagen-contador');
    contador.hidden = !mostrarControles;
    contador.textContent = `${indiceImagenModalActual + 1} / ${imagenesModalActuales.length}`;
  }

  async function abrirModalProducto(id) {
    const producto = productosActuales.find((p) => Number(p.id) === Number(id));
    if (!producto) return;

    productoModalActual = producto;
    cantidadModalActual = 1;

    const precio = Number(producto.precio);
    const stock = Number(producto.stock);
    const sinStock = stock === 0;

    document.getElementById('mp-categoria').textContent = producto.categoria || '';
    document.getElementById('mp-nombre').textContent = producto.nombre;
    const descEl = document.getElementById('mp-descripcion');
    descEl.textContent = producto.descripcion || '';
    descEl.style.display = producto.descripcion ? 'block' : 'none';
    document.getElementById('mp-precio').textContent = '$' + precio.toLocaleString('es-CO');

    const stockEl = document.getElementById('mp-stock');
    stockEl.textContent = sinStock ? '⚠ Sin stock disponible' : `Stock disponible: ${stock} uds`;
    stockEl.classList.toggle('sin-stock', sinStock);

    const imgEl = document.getElementById('mp-imagen');
    const placeholderEl = document.getElementById('mp-imagen-placeholder');
    imagenesModalActuales = producto.imagenUrl ? [producto.imagenUrl] : [];
    indiceImagenModalActual = 0;
    if (producto.imagenUrl) {
      mostrarImagenModal(0);
    } else {
      imgEl.style.display = 'none';
      placeholderEl.style.display = 'flex';
      placeholderEl.textContent = (producto.nombre || 'P').charAt(0).toUpperCase();
    }
    document.getElementById('mp-imagen-anterior').hidden = true;
    document.getElementById('mp-imagen-siguiente').hidden = true;
    document.getElementById('mp-imagen-contador').hidden = true;

    document.getElementById('mp-cantidad').value = cantidadModalActual;
    document.getElementById('mp-cantidad-row').style.display = sinStock ? 'none' : 'flex';

    const btnAgregar = document.getElementById('mp-btn-agregar');
    btnAgregar.disabled = sinStock;
    btnAgregar.textContent = sinStock ? 'Sin stock' : '+ Agregar al carrito';

    document.getElementById('modal-producto').classList.add('abierto');

    if (!Array.isArray(producto.imagenes)) {
      try {
        const respuesta = await fetch(`/api/auth/cliente/productos/${producto.id}`);
        const resultado = await respuesta.json();
        if (!respuesta.ok || !resultado.success) {
          throw new Error(resultado.message || 'No se pudieron cargar las imágenes del producto.');
        }
        if (productoModalActual !== producto) return;
        producto.imagenes = Array.isArray(resultado.data?.imagenes)
          ? resultado.data.imagenes.map((imagen) => imagen.url).filter(Boolean)
          : [];
      } catch (error) {
        console.error('Error al cargar las imágenes del producto:', error);
        if (productoModalActual === producto) {
          mostrarToast('No se pudieron cargar todas las imágenes del producto.', true);
        }
      }
    }

    if (productoModalActual === producto && producto.imagenes?.length) {
      imagenesModalActuales = producto.imagenes;
      mostrarImagenModal(0);
    }
  }

  function cerrarModalProducto() {
    document.getElementById('modal-producto').classList.remove('abierto');
    productoModalActual = null;
    imagenesModalActuales = [];
    indiceImagenModalActual = 0;
  }

  function cambiarCantidadModal(delta) {
    if (!productoModalActual) return;
    const stock = Number(productoModalActual.stock);
    const nueva = cantidadModalActual + delta;
    if (nueva < 1) return;
    if (nueva > stock) {
      mostrarToast('⚠️ No hay más stock disponible.', true);
      return;
    }
    cantidadModalActual = nueva;
    document.getElementById('mp-cantidad').value = cantidadModalActual;
  }

  // ══════════════════════════════════════════════════════════
  // eventos (delegados: el contenido de grilla/carrito se re-crea con
  // innerHTML, asi que se escucha en el contenedor fijo, no en cada tarjeta)
  // ══════════════════════════════════════════════════════════

  grilla.addEventListener('click', (evento) => {
    const el = evento.target.closest('[data-accion]');
    if (!el) return;
    const id = el.dataset.id;

    if (el.dataset.accion === 'ver-proveedor') verProductosProveedor(id);
    if (el.dataset.accion === 'abrir-producto') abrirModalProducto(id);
    if (el.dataset.accion === 'agregar-carrito') {
      agregarAlCarrito(id);
      const textoOrig = el.textContent;
      el.textContent = '✓ Agregado';
      el.classList.add('agregado');
      setTimeout(() => {
        el.textContent = textoOrig;
        el.classList.remove('agregado');
      }, 800);
    }
  });

  // fallback de imagen rota: logo/producto -> placeholder con inicial; portada -> degradado de fondo
  grilla.addEventListener(
    'error',
    (evento) => {
      const img = evento.target;
      if (!img.dataset?.fallback) return;
      img.style.display = 'none';
      if (img.dataset.fallback === 'portada') return;
      const placeholder = img.nextElementSibling;
      if (placeholder) placeholder.style.display = 'flex';
    },
    true, // captura: el evento "error" de <img> no burbujea
  );

  document.getElementById('contenido-carrito').addEventListener('click', (evento) => {
    const el = evento.target.closest('[data-accion]');
    if (!el) return;
    const id = el.dataset.id;
    if (el.dataset.accion === 'restar-item') cambiarCantidad(id, -1);
    if (el.dataset.accion === 'sumar-item') cambiarCantidad(id, 1);
  });

  document.getElementById('contenido-carrito').addEventListener('change', (evento) => {
    const el = evento.target.closest('[data-accion="input-cantidad"]');
    if (el) setCantidad(el.dataset.id, el);
  });

  document.getElementById('contenido-carrito').addEventListener('click', (evento) => {
    if (evento.target.matches('[data-accion="input-cantidad"]')) evento.target.select();
  });

  btnVolver?.addEventListener('click', volverAProveedores);
  campoBusqueda?.addEventListener('input', () => (proveedorActual ? filtrarCatalogo() : filtrarEmpresas()));
  selectorCategoria?.addEventListener('change', filtrarCatalogo);

  document.getElementById('mp-cerrar')?.addEventListener('click', cerrarModalProducto);
  document.getElementById('mp-imagen-anterior')?.addEventListener('click', () => mostrarImagenModal(indiceImagenModalActual - 1, -1));
  document.getElementById('mp-imagen-siguiente')?.addEventListener('click', () => mostrarImagenModal(indiceImagenModalActual + 1, 1));
  let inicioDeslizamientoGaleria = null;
  document.getElementById('mp-imagen-wrap')?.addEventListener('pointerdown', (evento) => {
    if (evento.pointerType === 'touch') inicioDeslizamientoGaleria = evento.clientX;
  });
  document.getElementById('mp-imagen-wrap')?.addEventListener('pointerup', (evento) => {
    if (inicioDeslizamientoGaleria === null) return;
    const desplazamiento = evento.clientX - inicioDeslizamientoGaleria;
    inicioDeslizamientoGaleria = null;
    if (Math.abs(desplazamiento) < 45 || imagenesModalActuales.length < 2) return;
    mostrarImagenModal(indiceImagenModalActual + (desplazamiento < 0 ? 1 : -1), desplazamiento < 0 ? 1 : -1);
  });
  document.getElementById('modal-producto')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarModalProducto();
  });
  document.getElementById('mp-restar')?.addEventListener('click', () => cambiarCantidadModal(-1));
  document.getElementById('mp-sumar')?.addEventListener('click', () => cambiarCantidadModal(1));
  document.getElementById('mp-cantidad')?.addEventListener('change', function () {
    if (!productoModalActual) return;
    const stock = Number(productoModalActual.stock);
    let nueva = parseInt(this.value, 10);
    if (isNaN(nueva) || nueva < 1) nueva = 1;
    else if (nueva > stock) {
      mostrarToast(`⚠️ Stock máximo disponible: ${stock} uds.`, true);
      nueva = stock;
    }
    cantidadModalActual = nueva;
    this.value = cantidadModalActual;
  });
  document.getElementById('mp-cantidad')?.addEventListener('click', function () {
    this.select();
  });

  document.getElementById('mp-btn-agregar')?.addEventListener('click', () => {
    if (!productoModalActual) return;
    agregarAlCarrito(productoModalActual.id, cantidadModalActual);
    const btn = document.getElementById('mp-btn-agregar');
    const textoOrig = btn.textContent;
    btn.textContent = '✓ Agregado';
    btn.style.background = '#16a34a';
    setTimeout(() => {
      btn.textContent = textoOrig;
      btn.style.background = '';
    }, 800);
    setTimeout(cerrarModalProducto, 700);
  });

  // "confirmar pedido" abre el checkout (CheckoutCliente.astro lo escucha): mapa -> pago -> Wompi
  document.getElementById('btn-confirmar-pedido')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('georuta:iniciar-checkout', { detail: { carrito, productosActuales, proveedorActual } }));
  });

  // el checkout avisa cuando el pedido quedo creado: se vacia el carrito
  document.addEventListener('georuta:pedido-creado', () => {
    carrito = {};
    renderizarCarrito();
  });

  // busqueda desde la topbar del layout (evento emitido en ClienteLayout.astro)
  window.addEventListener('buscar-producto', (evento) => {
    if (!proveedorActual) return;
    if (campoBusqueda) campoBusqueda.value = evento.detail;
    filtrarCatalogo();
  });

  document.getElementById('empresas-carrusel-anterior')?.addEventListener('click', () => moverCarruselEmpresas(-1));
  document.getElementById('empresas-carrusel-siguiente')?.addEventListener('click', () => moverCarruselEmpresas(1));
  botonPausaCarrusel?.addEventListener('click', () => {
    carruselPausado = !carruselPausado;
    actualizarControlesCarrusel();
    reiniciarTemporizadorCarrusel();
  });
  carruselEmpresas?.addEventListener('click', (evento) => {
    const accion = evento.target.closest('[data-accion="ver-proveedor"]');
    if (accion) verProductosProveedor(accion.dataset.id);
  });
  carruselEmpresas?.addEventListener('pointerenter', detenerTemporizadorCarrusel);
  carruselEmpresas?.addEventListener('pointerleave', reiniciarTemporizadorCarrusel);
  carruselEmpresas?.addEventListener('focusin', detenerTemporizadorCarrusel);
  carruselEmpresas?.addEventListener('focusout', (evento) => {
    if (!carruselEmpresas.contains(evento.relatedTarget)) reiniciarTemporizadorCarrusel();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) detenerTemporizadorCarrusel();
    else reiniciarTemporizadorCarrusel();
  });
  movimientoReducido.addEventListener('change', reiniciarTemporizadorCarrusel);

  // estado inicial
  renderizarProveedores();
  renderizarCarrito();
</script>

