---
// src/components/cliente/CatalogoCliente.astro

interface ProveedorCard {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
}

interface Props {
  proveedores: ProveedorCard[];
}

const { proveedores } = Astro.props;
---

<div class="dos-columnas">
  <!-- ── columna izquierda: proveedores/productos ── -->
  <div>
    <button class="boton-volver" id="btn-volver" style="display:none;">⬅ Volver</button>

    <div class="barra-busqueda">
      <input class="campo-busqueda" type="text" placeholder="Buscar empresa..." id="campo-busqueda" />
      <select class="selector-categoria" id="selector-categoria">
        <option value="">Todas las categorías</option>
      </select>
    </div>

    <div class="grilla-productos" id="grilla-productos"></div>
  </div>

  <!-- ── columna derecha: carrito ── -->
  <div>
    <div class="panel-carrito">
      <div class="titulo-carrito">Carrito</div>
      <div id="contenido-carrito"></div>
      <div id="resumen-carrito" style="display:none;">
        <hr class="separador-carrito" />
        <div class="fila-total">
          <span class="etiqueta-total">Subtotal</span>
          <span class="valor-total" id="subtotal-carrito">$0</span>
        </div>
        <div class="fila-total">
          <span class="etiqueta-total">Envío</span>
          <span class="valor-total">$8.000</span>
        </div>
        <div class="fila-total">
          <span class="etiqueta-total">Total</span>
          <span class="valor-total grande" id="total-carrito">$0</span>
        </div>
        <button class="boton-confirmar-pedido" id="btn-confirmar-pedido">Confirmar pedido</button>
      </div>
    </div>
  </div>
</div>

<!-- ── modal de detalle de producto ── -->
<div id="modal-producto" class="modal-producto-overlay">
  <div class="modal-producto-caja">
    <button class="modal-producto-cerrar" id="mp-cerrar">×</button>
    <div class="modal-producto-grid">
      <div class="modal-producto-imagen-wrap">
        <img id="mp-imagen" src="" alt="" class="modal-producto-imagen" />
        <div id="mp-imagen-placeholder" class="modal-producto-imagen-placeholder"></div>
      </div>
      <div class="modal-producto-info">
        <div id="mp-categoria" class="modal-producto-categoria"></div>
        <h2 id="mp-nombre" class="modal-producto-nombre"></h2>
        <p id="mp-descripcion" class="modal-producto-descripcion"></p>
        <div id="mp-precio" class="modal-producto-precio"></div>
        <div id="mp-stock" class="modal-producto-stock"></div>
        <div id="mp-cantidad-row" class="modal-producto-cantidad-row">
          <span>Cantidad</span>
          <div class="modal-producto-stepper">
            <button type="button" id="mp-restar">−</button>
            <input type="number" id="mp-cantidad" class="mp-cantidad-input" value="1" min="1" />
            <button type="button" id="mp-sumar">+</button>
          </div>
        </div>
        <button id="mp-btn-agregar" class="modal-producto-btn-agregar">+ Agregar al carrito</button>
      </div>
    </div>
  </div>
</div>

<script define:vars={{ proveedoresIniciales: proveedores }}>
  // ══════════════════════════════════════════════════════════
  // estado en memoria del navegador (se pierde al recargar la pagina,
  // igual que en el original — el carrito nunca se guarda en el backend
  // hasta que se confirma el pedido)
  // ══════════════════════════════════════════════════════════
  let proveedoresData = proveedoresIniciales;
  let productosActuales = [];
  let proveedorActual = null;
  let carrito = {}; // { [idProducto]: cantidad }

  let productoModalActual = null;
  let cantidadModalActual = 1;

  const grilla = document.getElementById('grilla-productos');
  const btnVolver = document.getElementById('btn-volver');
  const campoBusqueda = document.getElementById('campo-busqueda');
  const selectorCategoria = document.getElementById('selector-categoria');

  // ── toast simple (reemplaza mostrarToast del script global original) ──
  function mostrarToast(mensaje, esError = false) {
    const toast = document.createElement('div');
    toast.textContent = mensaje;
    toast.style.cssText = `
      position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
      background:${esError ? '#dc2626' : '#1e293b'}; color:white;
      padding:0.65rem 1.1rem; border-radius:10px; font-size:0.85rem;
      z-index:9999; box-shadow:0 8px 24px rgba(0,0,0,0.2);
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  // ══════════════════════════════════════════════════════════
  // renderizar proveedores / productos
  // ══════════════════════════════════════════════════════════

  function renderizarProveedores() {
    proveedorActual = null;
    if (btnVolver) { btnVolver.style.display = 'none'; btnVolver.style.opacity = '1'; }
    if (selectorCategoria) selectorCategoria.innerHTML = '<option value="">Todas las categorías</option>';
    if (campoBusqueda) campoBusqueda.value = '';

    if (!proveedoresData.length) {
      grilla.innerHTML = '<p style="color:#94a3b8;padding:2rem">No hay proveedores disponibles.</p>';
      return;
    }

    grilla.innerHTML = proveedoresData
      .map(
        (p) => `
      <div class="tarjeta-proveedor" data-accion="ver-proveedor" data-id="${p.id}">
        ${p.logoUrl ? `<img src="${p.logoUrl}" class="imagen-proveedor" alt="${p.nombre}" data-fallback="logo" />` : ''}
        <div class="logo-placeholder-cat" style="display:${p.logoUrl ? 'none' : 'flex'}">
          ${(p.nombre || 'E').charAt(0).toUpperCase()}
        </div>
        <div class="nombre-proveedor">${p.nombre}</div>
        ${p.descripcion ? `<div class="desc-proveedor">${p.descripcion}</div>` : ''}
      </div>`,
      )
      .join('');
  }

  function filtrarEmpresas() {
    if (proveedorActual) return;
    const texto = campoBusqueda?.value.toLowerCase().trim() ?? '';
    const filtradas = proveedoresData.filter(
      (e) => e.nombre.toLowerCase().includes(texto) || (e.descripcion ?? '').toLowerCase().includes(texto),
    );

    if (!filtradas.length) {
      grilla.innerHTML = `
        <div style="padding:3rem;text-align:center;color:#94a3b8">
          <p style="font-size:1.1rem;margin-bottom:8px">Sin resultados</p>
          <p style="font-size:0.85rem">No se encontraron empresas con "${texto}".</p>
        </div>`;
      return;
    }

    grilla.innerHTML = filtradas
      .map(
        (p) => `
      <div class="tarjeta-proveedor" data-accion="ver-proveedor" data-id="${p.id}">
        ${p.logoUrl ? `<img src="${p.logoUrl}" class="imagen-proveedor" alt="${p.nombre}" data-fallback="logo" />` : ''}
        <div class="logo-placeholder-cat" style="display:${p.logoUrl ? 'none' : 'flex'}">
          ${(p.nombre || 'E').charAt(0).toUpperCase()}
        </div>
        <div class="nombre-proveedor">${p.nombre}</div>
        ${p.descripcion ? `<div class="desc-proveedor">${p.descripcion}</div>` : ''}
      </div>`,
      )
      .join('');
  }

  async function verProductosProveedor(idEmpresa) {
    proveedorActual = proveedoresData.find((p) => Number(p.id) === Number(idEmpresa));
    grilla.innerHTML = '<p style="color:#94a3b8;padding:2rem">Cargando productos...</p>';
    if (btnVolver) btnVolver.style.display = 'inline-flex';

    try {
      // llama al proxy BFF (archivo 12), nunca directo al backend deno
      const res = await fetch(`/api/cliente/proveedores/${idEmpresa}/productos`);
      const data = await res.json();

      if (!data.success || !data.data?.length) {
        grilla.innerHTML = `
          <div style="padding:3rem;text-align:center;color:#94a3b8">
            <p style="font-size:1.1rem;margin-bottom:8px">Sin productos disponibles</p>
            <p style="font-size:0.85rem">Este proveedor aún no tiene productos activos.</p>
          </div>`;
        return;
      }

      productosActuales = data.data;

      if (selectorCategoria) {
        const categorias = [...new Set(productosActuales.map((p) => p.categoria))].sort();
        selectorCategoria.innerHTML =
          '<option value="">Todas las categorías</option>' +
          categorias.map((c) => `<option value="${c}">${c}</option>`).join('');
      }

      renderizarCatalogo(productosActuales);
    } catch (err) {
      console.error('error cargando productos:', err);
      grilla.innerHTML = '<p style="color:#ef4444;padding:2rem">Error al cargar productos.</p>';
    }
  }

  function renderizarCatalogo(lista) {
    if (!lista.length) {
      grilla.innerHTML = '<p style="color:#94a3b8;padding:2rem">No se encontraron productos.</p>';
      return;
    }

    grilla.innerHTML = lista
      .map((p) => {
        const idNum = Number(p.id);
        const precio = Number(p.precio);
        const stock = Number(p.stock);
        const sinStock = stock === 0;

        return `
        <div class="tarjeta-producto">
          <div class="producto-imagen-wrap" data-accion="abrir-producto" data-id="${idNum}" style="cursor:pointer">
            ${p.imagenUrl ? `<img src="${p.imagenUrl}" class="producto-imagen" alt="${p.nombre}" data-fallback="producto" />` : ''}
            <div class="producto-imagen-placeholder" style="display:${p.imagenUrl ? 'none' : 'flex'}">
              ${(p.nombre || 'P').charAt(0).toUpperCase()}
            </div>
          </div>
          <div class="producto-info">
            <div class="nombre-producto" data-accion="abrir-producto" data-id="${idNum}" style="cursor:pointer">${p.nombre}</div>
            <div class="categoria-producto">${p.categoria}</div>
            ${p.descripcion ? `<div class="desc-producto">${p.descripcion}</div>` : ''}
            <div class="precio-producto">$${precio.toLocaleString('es-CO')}</div>
            <div class="stock-producto" style="color:${sinStock ? '#ef4444' : '#94a3b8'}">
              ${sinStock ? '⚠ Sin stock' : `Stock: ${stock} uds`}
            </div>
          </div>
          <button class="boton-agregar-carrito" data-accion="agregar-carrito" data-id="${idNum}" ${sinStock ? 'disabled' : ''}>
            ${sinStock ? 'Sin stock' : '+ Agregar'}
          </button>
        </div>`;
      })
      .join('');
  }

  function filtrarCatalogo() {
    if (!productosActuales.length) return;
    const texto = campoBusqueda?.value.toLowerCase() ?? '';
    const categoria = selectorCategoria?.value ?? '';
    const filtrados = productosActuales.filter(
      (p) => p.nombre.toLowerCase().includes(texto) && (!categoria || p.categoria === categoria),
    );
    renderizarCatalogo(filtrados);
  }

  function volverAProveedores() {
    const haySelecciones = Object.values(carrito).some((c) => c > 0);
    if (haySelecciones) {
      const confirmar = confirm('⚠️ Tienes productos en el carrito.\n\n¿Deseas vaciar el carrito y volver a los proveedores?');
      if (!confirmar) return;
      carrito = {};
      renderizarCarrito();
    }
    productosActuales = [];
    proveedorActual = null;
    if (campoBusqueda) campoBusqueda.value = '';
    renderizarProveedores();
  }

  // ══════════════════════════════════════════════════════════
  // carrito
  // ══════════════════════════════════════════════════════════

  function agregarAlCarrito(id, cantidad = 1) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    if (!producto) return;

    const cantidadActual = carrito[idNum] || 0;
    const nuevaCantidad = cantidadActual + cantidad;

    if (nuevaCantidad > Number(producto.stock)) {
      mostrarToast('⚠️ No hay más stock disponible.', true);
      return;
    }

    carrito[idNum] = nuevaCantidad;
    renderizarCarrito();
  }

  function cambiarCantidad(id, delta) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    const nuevaCantidad = (carrito[idNum] || 0) + delta;

    if (nuevaCantidad <= 0) {
      delete carrito[idNum];
    } else if (producto && nuevaCantidad > Number(producto.stock)) {
      mostrarToast('⚠️ Stock máximo alcanzado.', true);
      return;
    } else {
      carrito[idNum] = nuevaCantidad;
    }
    renderizarCarrito();
  }

  function setCantidad(id, input) {
    const idNum = Number(id);
    const producto = productosActuales.find((p) => Number(p.id) === idNum);
    const nuevo = parseInt(input.value, 10);

    if (isNaN(nuevo) || nuevo <= 0) {
      if (confirm('⚠️ ¿Deseas eliminar este producto del carrito?')) {
        delete carrito[idNum];
      } else {
        input.value = carrito[idNum];
      }
      renderizarCarrito();
      return;
    }

    if (producto && nuevo > Number(producto.stock)) {
      mostrarToast(`⚠️ Stock máximo disponible: ${producto.stock} uds.`, true);
      input.value = carrito[idNum];
      return;
    }

    carrito[idNum] = nuevo;
    renderizarCarrito();
  }

  function renderizarCarrito() {
    const contenido = document.getElementById('contenido-carrito');
    const resumen = document.getElementById('resumen-carrito');
    if (!contenido) return;

    const ids = Object.keys(carrito).filter((id) => carrito[id] > 0);

    if (btnVolver && proveedorActual) {
      btnVolver.style.opacity = ids.length > 0 ? '0.6' : '1';
      btnVolver.title = ids.length > 0 ? 'Vacía el carrito para volver' : 'Volver a proveedores';
    }

    if (!ids.length) {
      contenido.innerHTML = `<div class="carrito-vacio"><p>Tu carrito está vacío.<br>Agrega productos del catálogo.</p></div>`;
      if (resumen) resumen.style.display = 'none';
      return;
    }

    let subtotal = 0;
    contenido.innerHTML = ids
      .map((id) => {
        const idNum = Number(id);
        const p = productosActuales.find((x) => Number(x.id) === idNum);
        if (!p) return '';
        const cantidad = carrito[idNum];
        const total = Number(p.precio) * cantidad;
        subtotal += total;

        return `
        <div class="item-carrito">
          ${
            p.imagenUrl
              ? `<img src="${p.imagenUrl}" style="width:40px;height:40px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0;flex-shrink:0">`
              : `<div style="width:40px;height:40px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;font-weight:700;color:#94a3b8;flex-shrink:0">${(p.nombre || 'P').charAt(0).toUpperCase()}</div>`
          }
          <div style="flex:1;min-width:0">
            <div class="nombre-item-carrito">${p.nombre}</div>
            <div style="font-size:0.72rem;color:#94a3b8">$${Number(p.precio).toLocaleString('es-CO')} c/u</div>
          </div>
          <div class="controles-cantidad">
            <button class="boton-cantidad" data-accion="restar-item" data-id="${idNum}">−</button>
            <input class="valor-cantidad" type="number" min="1" max="${p.stock}" value="${cantidad}" data-accion="input-cantidad" data-id="${idNum}" />
            <button class="boton-cantidad" data-accion="sumar-item" data-id="${idNum}">+</button>
          </div>
          <div class="precio-item-carrito">$${total.toLocaleString('es-CO')}</div>
        </div>`;
      })
      .join('');

    const envio = 8000;
    document.getElementById('subtotal-carrito').textContent = '$' + subtotal.toLocaleString('es-CO');
    document.getElementById('total-carrito').textContent = '$' + (subtotal + envio).toLocaleString('es-CO');
    if (resumen) resumen.style.display = 'block';
  }

  // ══════════════════════════════════════════════════════════
  // modal de detalle de producto
  // ══════════════════════════════════════════════════════════

  function abrirModalProducto(id) {
    const producto = productosActuales.find((p) => Number(p.id) === Number(id));
    if (!producto) return;

    productoModalActual = producto;
    cantidadModalActual = 1;

    const precio = Number(producto.precio);
    const stock = Number(producto.stock);
    const sinStock = stock === 0;

    document.getElementById('mp-categoria').textContent = producto.categoria || '';
    document.getElementById('mp-nombre').textContent = producto.nombre;
    const descEl = document.getElementById('mp-descripcion');
    descEl.textContent = producto.descripcion || '';
    descEl.style.display = producto.descripcion ? 'block' : 'none';
    document.getElementById('mp-precio').textContent = '$' + precio.toLocaleString('es-CO');

    const stockEl = document.getElementById('mp-stock');
    stockEl.textContent = sinStock ? '⚠ Sin stock disponible' : `Stock disponible: ${stock} uds`;
    stockEl.classList.toggle('sin-stock', sinStock);

    const imgEl = document.getElementById('mp-imagen');
    const placeholderEl = document.getElementById('mp-imagen-placeholder');
    if (producto.imagenUrl) {
      imgEl.src = producto.imagenUrl;
      imgEl.alt = producto.nombre;
      imgEl.style.display = 'block';
      placeholderEl.style.display = 'none';
    } else {
      imgEl.style.display = 'none';
      placeholderEl.style.display = 'flex';
      placeholderEl.textContent = (producto.nombre || 'P').charAt(0).toUpperCase();
    }

    document.getElementById('mp-cantidad').value = cantidadModalActual;
    document.getElementById('mp-cantidad-row').style.display = sinStock ? 'none' : 'flex';

    const btnAgregar = document.getElementById('mp-btn-agregar');
    btnAgregar.disabled = sinStock;
    btnAgregar.textContent = sinStock ? 'Sin stock' : '+ Agregar al carrito';

    document.getElementById('modal-producto').classList.add('abierto');
  }

  function cerrarModalProducto() {
    document.getElementById('modal-producto').classList.remove('abierto');
    productoModalActual = null;
  }

  function cambiarCantidadModal(delta) {
    if (!productoModalActual) return;
    const stock = Number(productoModalActual.stock);
    const nueva = cantidadModalActual + delta;
    if (nueva < 1) return;
    if (nueva > stock) {
      mostrarToast('⚠️ No hay más stock disponible.', true);
      return;
    }
    cantidadModalActual = nueva;
    document.getElementById('mp-cantidad').value = cantidadModalActual;
  }

  // ══════════════════════════════════════════════════════════
  // eventos (delegados: el contenido de grilla/carrito se re-crea con
  // innerHTML, asi que se escucha en el contenedor fijo, no en cada tarjeta)
  // ══════════════════════════════════════════════════════════

  grilla.addEventListener('click', (evento) => {
    const el = evento.target.closest('[data-accion]');
    if (!el) return;
    const id = el.dataset.id;

    if (el.dataset.accion === 'ver-proveedor') verProductosProveedor(id);
    if (el.dataset.accion === 'abrir-producto') abrirModalProducto(id);
    if (el.dataset.accion === 'agregar-carrito') {
      agregarAlCarrito(id);
      const textoOrig = el.textContent;
      el.textContent = '✓ Agregado';
      el.classList.add('agregado');
      setTimeout(() => {
        el.textContent = textoOrig;
        el.classList.remove('agregado');
      }, 800);
    }
  });

  // fallback de imagen rota (proveedor y producto): reemplaza por el placeholder inicial
  grilla.addEventListener(
    'error',
    (evento) => {
      const img = evento.target;
      if (!img.dataset?.fallback) return;
      img.style.display = 'none';
      const placeholder = img.nextElementSibling;
      if (placeholder) placeholder.style.display = 'flex';
    },
    true, // captura: el evento "error" de <img> no burbujea
  );

  document.getElementById('contenido-carrito').addEventListener('click', (evento) => {
    const el = evento.target.closest('[data-accion]');
    if (!el) return;
    const id = el.dataset.id;
    if (el.dataset.accion === 'restar-item') cambiarCantidad(id, -1);
    if (el.dataset.accion === 'sumar-item') cambiarCantidad(id, 1);
  });

  document.getElementById('contenido-carrito').addEventListener('change', (evento) => {
    const el = evento.target.closest('[data-accion="input-cantidad"]');
    if (el) setCantidad(el.dataset.id, el);
  });

  document.getElementById('contenido-carrito').addEventListener('click', (evento) => {
    if (evento.target.matches('[data-accion="input-cantidad"]')) evento.target.select();
  });

  btnVolver?.addEventListener('click', volverAProveedores);
  campoBusqueda?.addEventListener('input', () => (proveedorActual ? filtrarCatalogo() : filtrarEmpresas()));
  selectorCategoria?.addEventListener('change', filtrarCatalogo);

  document.getElementById('mp-cerrar')?.addEventListener('click', cerrarModalProducto);
  document.getElementById('modal-producto')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarModalProducto();
  });
  document.getElementById('mp-restar')?.addEventListener('click', () => cambiarCantidadModal(-1));
  document.getElementById('mp-sumar')?.addEventListener('click', () => cambiarCantidadModal(1));
  document.getElementById('mp-cantidad')?.addEventListener('change', function () {
    if (!productoModalActual) return;
    const stock = Number(productoModalActual.stock);
    let nueva = parseInt(this.value, 10);
    if (isNaN(nueva) || nueva < 1) nueva = 1;
    else if (nueva > stock) {
      mostrarToast(`⚠️ Stock máximo disponible: ${stock} uds.`, true);
      nueva = stock;
    }
    cantidadModalActual = nueva;
    this.value = cantidadModalActual;
  });
  document.getElementById('mp-cantidad')?.addEventListener('click', function () {
    this.select();
  });

  document.getElementById('mp-btn-agregar')?.addEventListener('click', () => {
    if (!productoModalActual) return;
    agregarAlCarrito(productoModalActual.id, cantidadModalActual);
    const btn = document.getElementById('mp-btn-agregar');
    const textoOrig = btn.textContent;
    btn.textContent = '✓ Agregado';
    btn.style.background = '#16a34a';
    setTimeout(() => {
      btn.textContent = textoOrig;
      btn.style.background = '';
    }, 800);
    setTimeout(cerrarModalProducto, 700);
  });

  // el boton "confirmar pedido" todavia no tiene checkout implementado (viene en
  // el siguiente archivo: modal de direccion + pago) — por ahora emite un evento
  // personalizado para que ese componente futuro lo escuche sin acoplarse aqui
  document.getElementById('btn-confirmar-pedido')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('georuta:iniciar-checkout', { detail: { carrito, productosActuales, proveedorActual } }));
  });

  // busqueda desde la topbar del layout (evento emitido en ClienteLayout.astro)
  window.addEventListener('buscar-producto', (evento) => {
    if (!proveedorActual) return;
    if (campoBusqueda) campoBusqueda.value = evento.detail;
    filtrarCatalogo();
  });

  // estado inicial
  renderizarProveedores();
  renderizarCarrito();
</script>

<style>
  /* (todas las clases de esta seccion viven solo aqui — no se repiten en otras paginas) */
