---
// src/components/cliente/ResenasCliente.astro

interface Pendiente {
  idPedido: number;
  fecha: string;
  empresa: string;
  empresaLogo: string;
  idProducto: number;
  producto: string;
  productoImagen: string;
  cantidad: number;
  precioUnitario: number;
}

interface Enviada {
  idResena: number;
  idPedido: number;
  calificacion: number;
  comentario: string;
  fecha: string;
  producto: string;
  productoImagen: string;
  empresa: string;
  empresaLogo: string;
}

interface Props {
  pendientes: Pendiente[];
  enviadas: Enviada[];
}

const { pendientes, enviadas } = Astro.props;

function formatearFecha(fecha: string): string {
  return new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }).format(
    new Date(fecha),
  );
}

// estrellas ya renderizadas del lado servidor para las reseñas enviadas (no cambian)
function estrellas(calificacion: number): string {
  return '★'.repeat(calificacion) + '☆'.repeat(5 - calificacion);
}
---

<!-- ── tabs ── -->
<div class="tabs-resenas">
  <button class="tab-resena activo" id="tab-pendientes" data-tab="pendientes">
    Pendientes {pendientes.length > 0 && <span class="tab-contador">{pendientes.length}</span>}
  </button>
  <button class="tab-resena" id="tab-enviadas" data-tab="enviadas">
    Enviadas <span class="tab-contador tab-contador-suave">{enviadas.length}</span>
  </button>
</div>

<!-- ── panel: pendientes ── -->
<div class="panel-resenas" id="panel-pendientes">
  {pendientes.length === 0 ? (
    <div class="resenas-vacio">
      <p>No tienes productos pendientes por reseñar.</p>
      <p class="resenas-vacio-sub">Aparecerán aquí los productos de tus pedidos ya entregados.</p>
    </div>
  ) : (
    <div class="grilla-resenas">
      {pendientes.map((item) => (
        <div class="tarjeta-pendiente">
          <div class="pendiente-producto">
            {item.productoImagen ? (
              <img src={item.productoImagen} alt={item.producto} class="pendiente-imagen" data-fallback="pendiente" />
            ) : null}
            <div class="pendiente-imagen-placeholder" style={`display:${item.productoImagen ? 'none' : 'flex'}`}>
              {item.producto.charAt(0).toUpperCase()}
            </div>
            <div class="pendiente-info">
              <div class="pendiente-nombre">{item.producto}</div>
              <div class="pendiente-empresa">{item.empresa}</div>
              <div class="pendiente-meta">Pedido #{item.idPedido} · {formatearFecha(item.fecha)} · {item.cantidad} uds</div>
            </div>
          </div>
          <button
            class="btn-escribir-resena"
            data-accion="abrir-resena"
            data-id-pedido={item.idPedido}
            data-id-producto={item.idProducto}
            data-producto={item.producto}
            data-empresa={item.empresa}
            data-imagen={item.productoImagen}
          >
            Escribir reseña
          </button>
        </div>
      ))}
    </div>
  )}
</div>

<!-- ── panel: enviadas ── -->
<div class="panel-resenas" id="panel-enviadas" style="display:none;">
  {enviadas.length === 0 ? (
    <div class="resenas-vacio">
      <p>Aún no has enviado ninguna reseña.</p>
    </div>
  ) : (
    <div class="grilla-resenas">
      {enviadas.map((resena) => (
        <div class="tarjeta-enviada">
          <div class="pendiente-producto">
            {resena.productoImagen ? (
              <img src={resena.productoImagen} alt={resena.producto} class="pendiente-imagen" data-fallback="enviada" />
            ) : null}
            <div class="pendiente-imagen-placeholder" style={`display:${resena.productoImagen ? 'none' : 'flex'}`}>
              {resena.producto.charAt(0).toUpperCase()}
            </div>
            <div class="pendiente-info">
              <div class="pendiente-nombre">{resena.producto}</div>
              <div class="pendiente-empresa">{resena.empresa}</div>
              <div class="enviada-fecha">{formatearFecha(resena.fecha)}</div>
            </div>
          </div>
          <div class="enviada-estrellas">{estrellas(resena.calificacion)}</div>
          {resena.comentario && <p class="enviada-comentario">"{resena.comentario}"</p>}
        </div>
      ))}
    </div>
  )}
</div>

<!-- ── modal: escribir reseña ── -->
<div id="modal-resena" class="modal-resena-overlay">
  <div class="modal-resena-caja">
    <button class="modal-resena-cerrar" id="mr-cerrar">×</button>

    <div class="mr-producto">
      <img id="mr-imagen" src="" alt="" class="mr-imagen" style="display:none;" />
      <div id="mr-imagen-placeholder" class="mr-imagen-placeholder"></div>
      <div>
        <div id="mr-nombre-producto" class="mr-nombre-producto"></div>
        <div id="mr-empresa" class="mr-empresa"></div>
      </div>
    </div>

    <div class="mr-campo">
      <label>Calificación</label>
      <div class="mr-estrellas-input" id="mr-estrellas-input">
        <button type="button" class="mr-estrella" data-valor="1">★</button>
        <button type="button" class="mr-estrella" data-valor="2">★</button>
        <button type="button" class="mr-estrella" data-valor="3">★</button>
        <button type="button" class="mr-estrella" data-valor="4">★</button>
        <button type="button" class="mr-estrella" data-valor="5">★</button>
      </div>
    </div>

    <div class="mr-campo">
      <label for="mr-comentario">Comentario (opcional)</label>
      <textarea id="mr-comentario" maxlength="500" rows="4" placeholder="¿Qué te pareció el producto?"></textarea>
    </div>

    <button class="mr-btn-enviar" id="mr-btn-enviar" disabled>Enviar reseña</button>
  </div>
</div>

<script>
  function mostrarToast(mensaje: string, esError = false) {
    const toast = document.createElement('div');
    toast.textContent = mensaje;
    toast.style.cssText = `
      position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
      background:${esError ? '#dc2626' : '#1e293b'}; color:white;
      padding:0.65rem 1.1rem; border-radius:10px; font-size:0.85rem;
      z-index:9999; box-shadow:0 8px 24px rgba(0,0,0,0.2);
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  // ── tabs ──
  document.getElementById('tab-pendientes')?.addEventListener('click', () => cambiarTab('pendientes'));
  document.getElementById('tab-enviadas')?.addEventListener('click', () => cambiarTab('enviadas'));

  function cambiarTab(tab: string) {
    document.getElementById('panel-pendientes')!.style.display = tab === 'pendientes' ? 'block' : 'none';
    document.getElementById('panel-enviadas')!.style.display = tab === 'enviadas' ? 'block' : 'none';
    document.getElementById('tab-pendientes')?.classList.toggle('activo', tab === 'pendientes');
    document.getElementById('tab-enviadas')?.classList.toggle('activo', tab === 'enviadas');
  }

  // ── modal de reseña ──
  let idPedidoActual = 0;
  let idProductoActual = 0;
  let calificacionActual = 0;

  function abrirModalResena(el: HTMLElement) {
    idPedidoActual = Number(el.dataset.idPedido);
    idProductoActual = Number(el.dataset.idProducto);
    calificacionActual = 0;

    document.getElementById('mr-nombre-producto')!.textContent = el.dataset.producto ?? '';
    document.getElementById('mr-empresa')!.textContent = el.dataset.empresa ?? '';

    const imagenUrl = el.dataset.imagen ?? '';
    const imgEl = document.getElementById('mr-imagen') as HTMLImageElement;
    const placeholderEl = document.getElementById('mr-imagen-placeholder')!;
    if (imagenUrl) {
      imgEl.src = imagenUrl;
      imgEl.style.display = 'block';
      placeholderEl.style.display = 'none';
    } else {
      imgEl.style.display = 'none';
      placeholderEl.style.display = 'flex';
      placeholderEl.textContent = (el.dataset.producto || 'P').charAt(0).toUpperCase();
    }

    (document.getElementById('mr-comentario') as HTMLTextAreaElement).value = '';
    pintarEstrellas(0);
    actualizarBotonEnviar();

    document.getElementById('modal-resena')!.classList.add('abierto');
  }

  function cerrarModalResena() {
    document.getElementById('modal-resena')!.classList.remove('abierto');
  }

  function pintarEstrellas(valor: number) {
    document.querySelectorAll('.mr-estrella').forEach((btn) => {
      const estrellaValor = Number((btn as HTMLElement).dataset.valor);
      btn.classList.toggle('activa', estrellaValor <= valor);
    });
  }

  function actualizarBotonEnviar() {
    const boton = document.getElementById('mr-btn-enviar') as HTMLButtonElement;
    boton.disabled = calificacionActual < 1;
  }

  document.querySelectorAll('.mr-estrella').forEach((btn) => {
    btn.addEventListener('click', () => {
      calificacionActual = Number((btn as HTMLElement).dataset.valor);
      pintarEstrellas(calificacionActual);
      actualizarBotonEnviar();
    });
  });

  document.getElementById('mr-cerrar')?.addEventListener('click', cerrarModalResena);
  document.getElementById('modal-resena')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarModalResena();
  });

  document.querySelectorAll('[data-accion="abrir-resena"]').forEach((btn) => {
    btn.addEventListener('click', () => abrirModalResena(btn as HTMLElement));
  });

  document.getElementById('mr-btn-enviar')?.addEventListener('click', async () => {
    const boton = document.getElementById('mr-btn-enviar') as HTMLButtonElement;
    const comentario = (document.getElementById('mr-comentario') as HTMLTextAreaElement).value.trim();

    boton.disabled = true;
    boton.textContent = 'Enviando...';

    try {
      const res = await fetch('/api/cliente/resenas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          idPedido: idPedidoActual,
          idProducto: idProductoActual,
          calificacion: calificacionActual,
          comentario: comentario || undefined,
        }),
      });
      const data = await res.json();

      if (!data.success) {
        mostrarToast(data.message || 'No fue posible enviar la reseña', true);
        boton.disabled = false;
        boton.textContent = 'Enviar reseña';
        return;
      }

      mostrarToast('¡Reseña enviada correctamente!');
      // recarga para que el item pase de "pendientes" a "enviadas" con datos reales del servidor
      setTimeout(() => window.location.reload(), 700);
    } catch (err) {
      console.error('error enviando la reseña:', err);
      mostrarToast('Error al enviar la reseña', true);
      boton.disabled = false;
      boton.textContent = 'Enviar reseña';
    }
  });

  // fallback de imagen rota
  document.querySelectorAll('.grilla-resenas').forEach((grilla) => {
    grilla.addEventListener(
      'error',
      (evento) => {
        const img = evento.target as HTMLImageElement;
        if (!img.dataset?.fallback) return;
        img.style.display = 'none';
        const placeholder = img.nextElementSibling as HTMLElement | null;
        if (placeholder) placeholder.style.display = 'flex';
      },
      true,
    );
  });
</script>

<style>
  /* ── tabs ── */
  .tabs-resenas {
    display: flex;
    gap: 6px;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--secondary-200);
  }

  .tab-resena {
    padding: 0.65rem 1rem;
    border: none;
    background: none;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--secondary-400);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: color 0.15s;
  }

  .tab-resena.activo {
    color: var(--primary-700);
    border-bottom-color: var(--primary-700);
  }

  .tab-contador {
    background: var(--primary-700);
    color: white;
    font-size: 0.68rem;
    padding: 1px 7px;
    border-radius: 20px;
    font-weight: 700;
  }

  .tab-contador-suave {
    background: var(--secondary-200);
    color: var(--secondary-600);
  }

  /* ── vacio ── */
  .resenas-vacio {
    background: white;
    border: 1px dashed var(--secondary-200);
    border-radius: 14px;
    padding: 3rem;
    text-align: center;
    color: var(--secondary-400);
  }

  .resenas-vacio-sub {
    font-size: 0.8rem;
    margin-top: 4px;
  }

  /* ── grilla ── */
  .grilla-resenas {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }

  .tarjeta-pendiente,
  .tarjeta-enviada {
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 14px;
    padding: 1rem 1.1rem;
  }

  .pendiente-producto {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 0.75rem;
  }

  .pendiente-imagen,
  .pendiente-imagen-placeholder {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    flex-shrink: 0;
    object-fit: contain;
    border: 1px solid var(--secondary-100);
  }

  .pendiente-imagen-placeholder {
    background: var(--secondary-100);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--secondary-400);
    font-size: 1.2rem;
  }

  .pendiente-info {
    flex: 1;
    min-width: 0;
  }

  .pendiente-nombre {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--secondary-800);
  }

  .pendiente-empresa {
    font-size: 0.76rem;
    color: var(--secondary-500);
  }

  .pendiente-meta {
    font-size: 0.7rem;
    color: var(--secondary-400);
    margin-top: 2px;
  }

  .enviada-fecha {
    font-size: 0.7rem;
    color: var(--secondary-400);
    margin-top: 2px;
  }

  .btn-escribir-resena {
    width: 100%;
    padding: 0.55rem;
    border-radius: 8px;
    border: 1px solid var(--primary-600);
    background: white;
    color: var(--primary-700);
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    transition: background 0.15s;
  }

  .btn-escribir-resena:hover {
    background: var(--primary-50);
  }

  .enviada-estrellas {
    color: #f59e0b;
    font-size: 1.1rem;
    letter-spacing: 2px;
    margin-bottom: 6px;
  }

  .enviada-comentario {
    font-size: 0.82rem;
    color: var(--secondary-600);
    font-style: italic;
    line-height: 1.5;
  }

  /* ── modal ── */
  .modal-resena-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9300;
    background: rgba(15, 23, 42, 0.55);
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-resena-overlay.abierto {
    display: flex;
  }

  .modal-resena-caja {
    background: white;
    border-radius: 18px;
    width: min(440px, 96vw);
    padding: 2rem;
    position: relative;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.25);
  }

  .modal-resena-cerrar {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: var(--secondary-100);
    color: var(--secondary-600);
    font-size: 1.3rem;
    line-height: 1;
    cursor: pointer;
  }

  .modal-resena-cerrar:hover {
    background: var(--secondary-200);
    color: var(--secondary-900);
  }

  .mr-producto {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.25rem;
    padding-right: 1.5rem;
  }

  .mr-imagen,
  .mr-imagen-placeholder {
    width: 52px;
    height: 52px;
    border-radius: 10px;
    flex-shrink: 0;
    object-fit: contain;
    border: 1px solid var(--secondary-100);
  }

  .mr-imagen-placeholder {
    background: var(--secondary-100);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--secondary-400);
  }

  .mr-nombre-producto {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--secondary-800);
  }

  .mr-empresa {
    font-size: 0.76rem;
    color: var(--secondary-500);
  }

  .mr-campo {
    margin-bottom: 1.1rem;
  }

  .mr-campo label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--secondary-500);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }

  .mr-estrellas-input {
    display: flex;
    gap: 4px;
  }

  .mr-estrella {
    font-size: 1.8rem;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--secondary-200);
    line-height: 1;
    padding: 2px;
    transition: color 0.1s, transform 0.1s;
  }

  .mr-estrella:hover {
    transform: scale(1.1);
  }

  .mr-estrella.activa {
    color: #f59e0b;
  }

  .mr-campo textarea {
    width: 100%;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--secondary-200);
    border-radius: 8px;
    font-size: 0.85rem;
    resize: vertical;
    outline: none;
    font-family: inherit;
  }

  .mr-campo textarea:focus {
    border-color: var(--primary-400);
  }

  .mr-btn-enviar {
    width: 100%;
    padding: 0.75rem;
    border-radius: 10px;
    border: none;
    background: var(--primary-900);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }

  .mr-btn-enviar:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .mr-btn-enviar:hover:not(:disabled) {
    background: var(--primary-700);
  }

  @media (max-width: 768px) {
    .grilla-resenas {
      grid-template-columns: 1fr;
    }
  }
</style>