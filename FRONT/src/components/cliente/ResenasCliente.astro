---
// src/components/cliente/ResenasCliente.astro

interface ProductoPendiente {
  idProducto: number;
  producto: string;
  productoImagen: string;
  cantidad: number;
}

interface Pendiente {
  idPedido: number;
  fecha: string;
  empresa: string;
  empresaLogo: string;
  productos: ProductoPendiente[];
}

interface ProductoEnviado {
  idProducto: number;
  producto: string;
  productoImagen: string;
  calificacion: number;
}

interface Enviada {
  idPedido: number;
  fecha: string;
  empresa: string;
  empresaLogo: string;
  promedio: number;
  comentario: string;
  productos: ProductoEnviado[];
}

interface Props {
  pendientes: Pendiente[];
  enviadas: Enviada[];
}

const { pendientes, enviadas } = Astro.props;

const ESTRELLAS = [1, 2, 3, 4, 5];

// "29 jun 2026" (sin puntos ni "de")
function formatearFecha(fecha: string): string {
  const partes = new Intl.DateTimeFormat('es-CO', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
  }).formatToParts(new Date(fecha));
  const tomar = (tipo: string) => partes.find((p) => p.type === tipo)?.value ?? '';
  return `${tomar('day')} ${tomar('month').replace('.', '')} ${tomar('year')}`;
}
---

<div class="resenas-raiz">
  <!-- ── tabs ── -->
  <div class="tabs-resenas">
    <button class="tab-resena activo" id="tab-pendientes" data-tab="pendientes">
      <span class="tab-icono">📝</span> Pendientes de calificar
      <span class="tab-contador tab-contador-suave">{pendientes.length}</span>
    </button>
    <button class="tab-resena" id="tab-enviadas" data-tab="enviadas">
      <span class="tab-icono">✅</span> Reseñas enviadas
      <span class="tab-contador">{enviadas.length}</span>
    </button>
  </div>

  <!-- ── panel: pendientes ── -->
  <div class="panel-resenas" id="panel-pendientes">
    {pendientes.length === 0 ? (
      <div class="resenas-vacio">
        <p>No tienes pedidos pendientes por calificar.</p>
        <p class="resenas-vacio-sub">Aparecerán aquí los productos de tus pedidos ya entregados.</p>
      </div>
    ) : (
      <div class="lista-resenas">
        {pendientes.map((pedido) => (
          <div class="tarjeta-resena" data-tipo="pendiente" data-id-pedido={pedido.idPedido}>
            <button type="button" class="resena-cabecera" aria-expanded="false">
              {pedido.empresaLogo ? (
                <img src={pedido.empresaLogo} alt={pedido.empresa} class="resena-logo" data-fallback="logo" />
              ) : null}
              <div class="resena-logo-placeholder" style={`display:${pedido.empresaLogo ? 'none' : 'flex'}`}>
                {pedido.empresa.charAt(0).toUpperCase()}
              </div>
              <div class="resena-info">
                <div class="resena-empresa">{pedido.empresa}</div>
                <div class="resena-meta">
                  #PED-{pedido.idPedido} · {formatearFecha(pedido.fecha)} · {pedido.productos.length} productos
                </div>
              </div>
              <span class="resena-progreso" data-progreso>0/{pedido.productos.length}</span>
              <span class="resena-chevron">▲</span>
            </button>

            <div class="resena-cuerpo">
              <div class="resena-productos">
                {pedido.productos.map((item) => (
                  <div class="fila-producto" data-id-producto={item.idProducto}>
                    {item.productoImagen ? (
                      <img src={item.productoImagen} alt={item.producto} class="producto-imagen" data-fallback="producto" />
                    ) : null}
                    <div class="producto-imagen-placeholder" style={`display:${item.productoImagen ? 'none' : 'flex'}`}>
                      {item.producto.charAt(0).toUpperCase()}
                    </div>
                    <div class="producto-nombre">{item.producto}</div>
                    <div class="estrellas-input" data-valor="0">
                      {ESTRELLAS.map((n) => (
                        <button type="button" class="estrella-btn" data-valor={n} aria-label={`${n} estrellas`}>★</button>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              <div class="resena-comentario-bloque">
                <label class="comentario-titulo">💬 Comentario del pedido (opcional)</label>
                <textarea
                  class="campo-comentario"
                  maxlength="500"
                  rows="3"
                  placeholder="Cuéntanos qué te pareció tu pedido, el servicio o el repartidor..."
                ></textarea>
                <button type="button" class="btn-enviar-pedido" disabled>Enviar reseñas</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- ── panel: enviadas ── -->
  <div class="panel-resenas" id="panel-enviadas" style="display:none;">
    {enviadas.length === 0 ? (
      <div class="resenas-vacio">
        <p>Aún no has enviado ninguna reseña.</p>
      </div>
    ) : (
      <div class="lista-resenas">
        {enviadas.map((pedido) => (
          <div class="tarjeta-resena" data-tipo="enviada">
            <button type="button" class="resena-cabecera" aria-expanded="false">
              {pedido.empresaLogo ? (
                <img src={pedido.empresaLogo} alt={pedido.empresa} class="resena-logo" data-fallback="logo" />
              ) : null}
              <div class="resena-logo-placeholder" style={`display:${pedido.empresaLogo ? 'none' : 'flex'}`}>
                {pedido.empresa.charAt(0).toUpperCase()}
              </div>
              <div class="resena-info">
                <div class="resena-empresa">{pedido.empresa}</div>
                <div class="resena-meta">
                  #PED-{pedido.idPedido} · {formatearFecha(pedido.fecha)} · {pedido.productos.length} productos
                </div>
              </div>
              <span class="resena-promedio"><span class="promedio-estrella">★</span> {pedido.promedio.toFixed(1)}</span>
              <span class="resena-chevron">▲</span>
            </button>

            <div class="resena-cuerpo">
              <div class="resena-productos">
                {pedido.productos.map((item) => (
                  <div class="fila-producto">
                    {item.productoImagen ? (
                      <img src={item.productoImagen} alt={item.producto} class="producto-imagen" data-fallback="producto" />
                    ) : null}
                    <div class="producto-imagen-placeholder" style={`display:${item.productoImagen ? 'none' : 'flex'}`}>
                      {item.producto.charAt(0).toUpperCase()}
                    </div>
                    <div class="producto-nombre">{item.producto}</div>
                    <div class="estrellas-lectura" aria-label={`${item.calificacion} de 5 estrellas`}>
                      {ESTRELLAS.map((n) => (
                        <span class={`estrella-fija ${n <= item.calificacion ? 'activa' : ''}`}>★</span>
                      ))}
                    </div>
                  </div>
                ))}
              </div>

              {pedido.comentario && (
                <div class="resena-comentario-bloque separado">
                  <div class="comentario-titulo">💬 Comentario del pedido</div>
                  <p class="comentario-texto">"{pedido.comentario}"</p>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</div>

<script>
  function mostrarToast(mensaje: string, esError = false) {
    const toast = document.createElement('div');
    toast.textContent = mensaje;
    toast.style.cssText = `
      position:fixed; bottom:24px; left:50%; transform:translateX(-50%);
      background:${esError ? '#dc2626' : '#1e293b'}; color:white;
      padding:0.65rem 1.1rem; border-radius:10px; font-size:0.85rem;
      z-index:9999; box-shadow:0 8px 24px rgba(0,0,0,0.2);
    `;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  // ── tabs ──
  document.getElementById('tab-pendientes')?.addEventListener('click', () => cambiarTab('pendientes'));
  document.getElementById('tab-enviadas')?.addEventListener('click', () => cambiarTab('enviadas'));

  function cambiarTab(tab: string) {
    document.getElementById('panel-pendientes')!.style.display = tab === 'pendientes' ? 'block' : 'none';
    document.getElementById('panel-enviadas')!.style.display = tab === 'enviadas' ? 'block' : 'none';
    document.getElementById('tab-pendientes')?.classList.toggle('activo', tab === 'pendientes');
    document.getElementById('tab-enviadas')?.classList.toggle('activo', tab === 'enviadas');
  }

  // cuenta cuantos productos ya tienen estrellas, actualiza el contador de la
  // cabecera y habilita el boton de enviar solo cuando estan todos calificados
  function actualizarProgreso(tarjeta: HTMLElement) {
    const grupos = tarjeta.querySelectorAll<HTMLElement>('.estrellas-input');
    const calificados = Array.from(grupos).filter((g) => Number(g.dataset.valor) > 0).length;

    const progreso = tarjeta.querySelector<HTMLElement>('[data-progreso]');
    if (progreso) {
      progreso.textContent = `${calificados}/${grupos.length}`;
      progreso.classList.toggle('completo', calificados === grupos.length);
    }

    const boton = tarjeta.querySelector<HTMLButtonElement>('.btn-enviar-pedido');
    if (boton) boton.disabled = calificados < grupos.length;
  }

  async function enviarResena(tarjeta: HTMLElement, boton: HTMLButtonElement) {
    const calificaciones = Array.from(tarjeta.querySelectorAll<HTMLElement>('.fila-producto')).map((fila) => ({
      idProducto: Number(fila.dataset.idProducto),
      calificacion: Number(fila.querySelector<HTMLElement>('.estrellas-input')?.dataset.valor),
    }));
    const comentario = tarjeta.querySelector<HTMLTextAreaElement>('.campo-comentario')?.value.trim() ?? '';

    boton.disabled = true;
    boton.textContent = 'Enviando...';

    try {
      const res = await fetch('/api/auth/cliente/resenas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          idPedido: Number(tarjeta.dataset.idPedido),
          calificaciones,
          comentario: comentario || undefined,
        }),
      });
      const data = await res.json();

      if (!data.success) {
        mostrarToast(data.message || 'No fue posible enviar la reseña', true);
        boton.disabled = false;
        boton.textContent = 'Enviar reseñas';
        return;
      }

      mostrarToast('¡Reseña enviada correctamente!');
      // recarga para que el pedido pase de "pendientes" a "enviadas" con los datos reales
      setTimeout(() => window.location.reload(), 700);
    } catch (err) {
      console.error('error enviando la reseña:', err);
      mostrarToast('Error al enviar la reseña', true);
      boton.disabled = false;
      boton.textContent = 'Enviar reseñas';
    }
  }

  // un solo listener para toda la vista (delegacion de eventos)
  document.querySelector('.resenas-raiz')?.addEventListener('click', (evento) => {
    const objetivo = evento.target as HTMLElement;

    // desplegar / plegar la tarjeta
    const cabecera = objetivo.closest<HTMLElement>('.resena-cabecera');
    if (cabecera) {
      const tarjeta = cabecera.closest<HTMLElement>('.tarjeta-resena')!;
      const abierta = tarjeta.classList.toggle('abierta');
      cabecera.setAttribute('aria-expanded', String(abierta));
      return;
    }

    // calificar un producto con estrellas
    const estrella = objetivo.closest<HTMLElement>('.estrella-btn');
    if (estrella) {
      const grupo = estrella.closest<HTMLElement>('.estrellas-input')!;
      const valor = Number(estrella.dataset.valor);
      grupo.dataset.valor = String(valor);
      grupo.querySelectorAll<HTMLElement>('.estrella-btn').forEach((btn) => {
        btn.classList.toggle('activa', Number(btn.dataset.valor) <= valor);
      });
      actualizarProgreso(grupo.closest<HTMLElement>('.tarjeta-resena')!);
      return;
    }

    // enviar la reseña completa del pedido
    const enviar = objetivo.closest<HTMLButtonElement>('.btn-enviar-pedido');
    if (enviar && !enviar.disabled) {
      enviarResena(enviar.closest<HTMLElement>('.tarjeta-resena')!, enviar);
    }
  });

  // imagen rota -> placeholder con inicial (el evento error no burbujea, por eso captura)
  document.querySelector('.resenas-raiz')?.addEventListener(
    'error',
    (evento) => {
      const img = evento.target as HTMLImageElement;
      if (!img.dataset?.fallback) return;
      img.style.display = 'none';
      const placeholder = img.nextElementSibling as HTMLElement | null;
      if (placeholder) placeholder.style.display = 'flex';
    },
    true,
  );
</script>

<style>
  /* ── tabs ── */
  .tabs-resenas {
    display: flex;
    gap: 6px;
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--secondary-200);
  }

  .tab-resena {
    padding: 0.7rem 1.1rem;
    border: none;
    background: none;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--secondary-500);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    display: flex;
    align-items: center;
    gap: 7px;
    transition: color 0.15s;
  }

  .tab-resena.activo {
    color: var(--primary-900);
    border-bottom-color: var(--primary-900);
  }

  .tab-contador {
    background: var(--primary-900);
    color: white;
    font-size: 0.7rem;
    padding: 1px 8px;
    border-radius: 20px;
    font-weight: 700;
  }

  .tab-contador-suave {
    background: var(--secondary-200);
    color: var(--secondary-600);
  }

  /* ── vacio ── */
  .resenas-vacio {
    background: white;
    border: 1px dashed var(--secondary-200);
    border-radius: 14px;
    padding: 3rem;
    text-align: center;
    color: var(--secondary-400);
  }

  .resenas-vacio-sub {
    font-size: 0.8rem;
    margin-top: 4px;
  }

  /* ── lista de tarjetas ── */
  .lista-resenas {
    display: grid;
    /* align-items: start para que al desplegar una tarjeta no estire a las vecinas */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 14px;
    align-items: start;
  }

  .tarjeta-resena {
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 16px;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .tarjeta-resena.abierta {
    border-color: #3b82f6;
    box-shadow: 0 6px 24px rgba(59, 130, 246, 0.12);
  }

  /* ── cabecera (boton que despliega) ── */
  .resena-cabecera {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.9rem 1rem;
    border: none;
    background: white;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    transition: background 0.15s;
  }

  .resena-cabecera:hover {
    background: #f8fafc;
  }

  .tarjeta-resena.abierta .resena-cabecera {
    background: #eff6ff;
  }

  .resena-logo,
  .resena-logo-placeholder {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    flex-shrink: 0;
    object-fit: contain;
  }

  .resena-logo-placeholder {
    background: var(--primary-900);
    color: white;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }

  .resena-info {
    flex: 1;
    min-width: 0;
  }

  .resena-empresa {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--secondary-900);
  }

  .resena-meta {
    font-size: 0.74rem;
    color: var(--secondary-400);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .resena-promedio {
    font-weight: 800;
    font-size: 0.9rem;
    color: #92400e;
    white-space: nowrap;
  }

  .promedio-estrella {
    color: #f59e0b;
  }

  .resena-progreso {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 20px;
    background: var(--secondary-100);
    color: var(--secondary-500);
    white-space: nowrap;
  }

  .resena-progreso.completo {
    background: #dcfce7;
    color: #16a34a;
  }

  .resena-chevron {
    color: #3b82f6;
    font-size: 0.8rem;
    transition: transform 0.2s;
    /* cerrada apunta hacia abajo, abierta hacia arriba */
    transform: rotate(180deg);
  }

  .tarjeta-resena.abierta .resena-chevron {
    transform: rotate(0deg);
  }

  /* ── cuerpo desplegable ── */
  .resena-cuerpo {
    display: none;
    max-height: 70vh;
    overflow-y: auto;
    padding: 0.9rem 1rem 1.1rem;
  }

  .tarjeta-resena.abierta .resena-cuerpo {
    display: block;
  }

  .resena-productos {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .fila-producto {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0.55rem 0.75rem;
    background: #f8fafc;
    border: 1px solid var(--secondary-100);
    border-radius: 12px;
  }

  .producto-imagen,
  .producto-imagen-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    flex-shrink: 0;
    object-fit: contain;
    background: white;
    border: 1px solid var(--secondary-100);
  }

  .producto-imagen-placeholder {
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--secondary-400);
    background: var(--secondary-100);
  }

  .producto-nombre {
    flex: 1;
    min-width: 0;
    font-weight: 700;
    font-size: 0.86rem;
    color: var(--secondary-800);
  }

  /* ── estrellas ── */
  .estrellas-input,
  .estrellas-lectura {
    display: flex;
    gap: 2px;
    flex-shrink: 0;
  }

  .estrella-btn {
    background: none;
    border: none;
    padding: 0 1px;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--secondary-200);
    cursor: pointer;
    transition: color 0.1s, transform 0.1s;
  }

  .estrella-btn:hover {
    transform: scale(1.15);
  }

  .estrella-btn.activa {
    color: #f59e0b;
  }

  .estrella-fija {
    font-size: 1.4rem;
    line-height: 1;
    color: var(--secondary-200);
  }

  .estrella-fija.activa {
    color: #f59e0b;
  }

  /* ── comentario general ── */
  .resena-comentario-bloque {
    margin-top: 1rem;
    padding-top: 0.9rem;
    border-top: 1px dashed var(--secondary-200);
  }

  .comentario-titulo {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--secondary-600);
    margin-bottom: 8px;
  }

  .campo-comentario {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--secondary-200);
    border-radius: 10px;
    font-size: 0.85rem;
    font-family: inherit;
    resize: vertical;
    outline: none;
    background: #f8fafc;
  }

  .campo-comentario:focus {
    border-color: #3b82f6;
    background: white;
  }

  .comentario-texto {
    margin: 0;
    padding: 0.75rem 0.9rem;
    background: #f8fafc;
    border: 1px solid var(--secondary-200);
    border-radius: 10px;
    font-size: 0.84rem;
    font-style: italic;
    color: var(--secondary-600);
    line-height: 1.5;
  }

  .btn-enviar-pedido {
    width: 100%;
    margin-top: 0.8rem;
    padding: 0.75rem;
    border-radius: 10px;
    border: none;
    background: var(--primary-900);
    color: white;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
  }

  .btn-enviar-pedido:disabled {
    opacity: 0.45;
    cursor: default;
  }

  .btn-enviar-pedido:hover:not(:disabled) {
    background: var(--primary-700);
  }
</style>