---
// src/components/cliente/InicioCliente.astro

interface PerfilCuenta {
  nombre: string;
  apellido: string;
  email: string;
  fechaCreacion: string;
  estadoCuenta: string;
  activo: boolean;
}

interface ProveedorCard {
  id: number;
  nombre: string;
  descripcion: string;
  logoUrl: string;
}

interface Props {
  perfil: PerfilCuenta;
  proveedores: ProveedorCard[];
}

const { perfil, proveedores } = Astro.props;

// Alterna fondos suaves y acentos de la paleta de marca.
const COLORES_CARRUSEL = [
  { fondo: '#fff7df', acento: '#a16207' },
  { fondo: '#eaf2ff', acento: '#1d4ed8' },
  { fondo: '#f3f7ff', acento: '#2563eb' },
];

const slides = proveedores.map((proveedor, indice) => ({
  ...proveedor,
  color: COLORES_CARRUSEL[indice % COLORES_CARRUSEL.length].fondo,
  acento: COLORES_CARRUSEL[indice % COLORES_CARRUSEL.length].acento,
}));

// saludo segun la hora del servidor al momento del request (equivalente al que
// calculaba el navegador con "new Date().getHours()" en el original)
const hora = new Date().getHours();
const saludoHora =
  hora >= 5 && hora < 12 ? '¡Buenos días!' : hora >= 12 && hora < 18 ? '¡Buenas tardes!' : '¡Buenas noches!';

const fechaFormateada = perfil.fechaCreacion
  ? new Intl.DateTimeFormat('es-CO', { day: '2-digit', month: 'short', year: 'numeric' }).format(
      new Date(perfil.fechaCreacion),
    )
  : '—';

---

<main class="inicio-dashboard">
<!-- ── banner de saludo ── -->
<div class="saludo-banner">
  <div class="saludo-contenido">
    <div class="saludo-texto">
      <p class="saludo-hora"><span class="saludo-punto"></span>{saludoHora}</p>
      <h1 class="saludo-nombre">
        {perfil.nombre} <span>{perfil.apellido}</span> 👋
      </h1>
      <p class="saludo-sub">Qué bueno tenerte de vuelta. Descubre proveedores y encuentra eso que buscas.</p>
      <div class="saludo-acciones">
        <a class="btn-explorar" href="/cliente/catalogo">
          Explorar catálogo
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path>
          </svg>
        </a>
        <a class="btn-contactanos" href="mailto:soporte@georuta.co">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path
              d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
            ></path>
          </svg>
          Contáctanos
        </a>
      </div>
    </div>
    <div class="saludo-visual" aria-hidden="true">
      <span class="visual-anillo visual-anillo-externo"></span>
      <span class="visual-anillo visual-anillo-interno"></span>
      <span class="visual-destello visual-destello-uno"></span>
      <span class="visual-destello visual-destello-dos"></span>
      <div class="visual-ruta">
        <svg viewBox="0 0 220 132" fill="none">
          <path d="M26 99C57 99 54 35 98 35s37 62 92 62" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 9"></path>
          <circle cx="27" cy="99" r="7" fill="#fbbf24"></circle>
          <circle cx="190" cy="97" r="7" fill="#93c5fd"></circle>
        </svg>
      </div>
      <div class="visual-camion">
        <svg viewBox="0 0 48 48" fill="none">
          <path d="M7 13.5A2.5 2.5 0 0 1 9.5 11h18a2.5 2.5 0 0 1 2.5 2.5V18h5.2c1.1 0 2.1.5 2.8 1.4l3.5 4.6c.3.4.5.9.5 1.5v8a2.5 2.5 0 0 1-2.5 2.5H38a5 5 0 0 1-9.8 0h-8.4a5 5 0 0 1-9.8 0H9.5A2.5 2.5 0 0 1 7 33.5v-20Z" fill="currentColor"></path>
          <path d="M30 21h5.2c.3 0 .6.1.8.4l3.1 4.1H30V21Z" fill="#bfdbfe"></path>
          <circle cx="15" cy="35" r="3" fill="#1e3a8a"></circle>
          <circle cx="33" cy="35" r="3" fill="#1e3a8a"></circle>
        </svg>
      </div>
      <span class="visual-etiqueta">Tu próxima compra empieza aquí</span>
    </div>
  </div>
</div>

<!-- ── carrusel de proveedores ── -->
{slides.length > 0 && (
  <div class="seccion-carrusel">
    <div class="encabezado-seccion">
      <span class="titulo-seccion">Empresas destacadas</span>
      <a class="enlace-seccion" href="/cliente/catalogo">Ver catálogo →</a>
    </div>
    <div class="carrusel-wrap">
      <button class="carrusel-btn carrusel-prev" id="btn-carrusel-prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"></path></svg>
      </button>

      <div class="carrusel-viewport">
        <div class="carrusel-track" id="carrusel-track">
          {slides.map((slide) => (
            <div
              class="carrusel-slide"
              style={`--slide-color:${slide.color};--slide-acento:${slide.acento}`}
            >
              {slide.logoUrl && (
                <img
                  src={slide.logoUrl}
                  alt=""
                  class="slide-logo-fondo"
                  aria-hidden="true"
                />
              )}
              <div class="slide-velo"></div>
              <div class="slide-contenido">
                <div class="slide-imagen-wrap">
                  {slide.logoUrl ? (
                    <img
                      src={slide.logoUrl}
                      alt={slide.nombre}
                      class="slide-imagen"
                      data-color={slide.acento}
                    />
                  ) : (
                    <div
                      class="slide-placeholder"
                      style={`background:${slide.acento}22;border:3px solid ${slide.acento}44;color:${slide.acento}`}
                    >
                      {slide.nombre.charAt(0).toUpperCase()}
                    </div>
                  )}
                </div>
                <div class="slide-texto">
                  <div class="slide-tag">Empresa destacada</div>
                  <h2 class="slide-nombre">{slide.nombre}</h2>
                  <p class="slide-desc">{slide.descripcion || 'Proveedor de GeoRuta'}</p>
                  <a class="slide-btn" href="/cliente/catalogo">
                    Ver productos <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <button class="carrusel-btn carrusel-next" id="btn-carrusel-next" aria-label="Siguiente">
        <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"></path></svg>
      </button>

      <div class="carrusel-dots" id="carrusel-dots">
        {slides.map((_, indice) => (
          <button class={`carrusel-dot ${indice === 0 ? 'activo' : ''}`} aria-label={`Ir a slide ${indice + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
)}

<!-- ── mis datos ── -->
<div class="seccion-datos">
  <div class="encabezado-seccion">
    <span class="titulo-seccion">Mis datos</span>
    <a class="enlace-seccion" href="/cliente/perfil">Editar perfil →</a>
  </div>
  <div class="grilla-datos">
    <div class="dato-card">
      <div class="dato-icono">
        <svg viewBox="0 0 24 24">
          <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"></path>
        </svg>
      </div>
      <div class="dato-info">
        <div class="dato-label">Nombre</div>
        <div class="dato-valor">{perfil.nombre} {perfil.apellido}</div>
      </div>
    </div>

    <div class="dato-card">
      <div class="dato-icono">
        <svg viewBox="0 0 24 24">
          <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
        </svg>
      </div>
      <div class="dato-info">
        <div class="dato-label">Correo</div>
        <div class="dato-valor">{perfil.email}</div>
      </div>
    </div>

    <div class="dato-card">
      <div class="dato-icono">
        <svg viewBox="0 0 24 24">
          <path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z"></path>
        </svg>
      </div>
      <div class="dato-info">
        <div class="dato-label">Miembro desde</div>
        <div class="dato-valor">{fechaFormateada}</div>
      </div>
    </div>

    <div class="dato-card">
      <div class={`dato-icono ${perfil.activo ? 'dato-icono-verde' : ''}`}>
        <svg viewBox="0 0 24 24">
          <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"></path>
        </svg>
      </div>
      <div class="dato-info">
        <div class="dato-label">Estado de cuenta</div>
        <div class={`dato-valor ${perfil.activo ? 'dato-verde' : 'dato-rojo'}`}>{perfil.estadoCuenta}</div>
      </div>
    </div>
  </div>
</div>

<!-- ── boton flotante movil (solo visible en responsive, ver estilos) ── -->
<a class="btn-contactanos-flotante" href="mailto:soporte@georuta.co" title="Contáctanos">
  <svg viewBox="0 0 24 24" fill="white">
    <path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"></path>
  </svg>
</a>
</main>

<script>
  // carrusel: todos los slides ya vienen renderizados desde el servidor, este script
  // solo mueve el track con transform (nada de fetch, a diferencia del original)
  let slideActual = 0;
  let intervalo: ReturnType<typeof setInterval> | null = null;

  function totalSlides(): number {
    return document.querySelectorAll('.carrusel-slide').length;
  }

  function irASlide(indice: number): void {
    const total = totalSlides();
    if (total === 0) return;
    slideActual = (indice + total) % total;

    const track = document.getElementById('carrusel-track');
    if (track) track.style.transform = `translateX(-${slideActual * 100}%)`;

    document.querySelectorAll('.carrusel-dot').forEach((punto, i) => {
      punto.classList.toggle('activo', i === slideActual);
    });
  }

  function iniciarAutoplay(): void {
    if (intervalo) clearInterval(intervalo);
    if (totalSlides() > 1) {
      intervalo = setInterval(() => irASlide(slideActual + 1), 4000);
    }
  }

  function moverCarrusel(direccion: number): void {
    if (intervalo) clearInterval(intervalo);
    irASlide(slideActual + direccion);
    iniciarAutoplay();
  }

  document.getElementById('btn-carrusel-prev')?.addEventListener('click', () => moverCarrusel(-1));
  document.getElementById('btn-carrusel-next')?.addEventListener('click', () => moverCarrusel(1));

  document.querySelectorAll('.carrusel-dot').forEach((punto, indice) => {
    punto.addEventListener('click', () => {
      if (intervalo) clearInterval(intervalo);
      irASlide(indice);
      iniciarAutoplay();
    });
  });

  // si el logo del proveedor no carga, lo reemplaza por el mismo placeholder
  // (inicial del nombre) que se usa cuando no hay logoUrl
  document.querySelectorAll<HTMLImageElement>('.slide-imagen').forEach((img) => {
    img.addEventListener('error', () => {
      const contenedor = img.parentElement;
      const color = img.dataset.color ?? '#1d4ed8';
      const inicial = (img.alt || '?').charAt(0).toUpperCase();
      if (contenedor) {
        contenedor.innerHTML = `<div class="slide-placeholder" style="background:${color}22;border:3px solid ${color}44;color:${color}">${inicial}</div>`;
      }
    });
  });

  document.querySelectorAll<HTMLImageElement>('.slide-logo-fondo').forEach((img) => {
    img.addEventListener('error', () => img.remove());
  });

  iniciarAutoplay();
</script>

<style>
  .encabezado-seccion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .titulo-seccion {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--secondary-800);
  }

  .enlace-seccion {
    font-size: 0.75rem;
    color: var(--primary-600);
    text-decoration: none;
  }

  /* ── banner de saludo ── */
  .saludo-banner {
    background: linear-gradient(135deg, var(--primary-900) 0%, var(--primary-700) 100%);
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    color: white;
    position: relative;
    overflow: hidden;
    margin-bottom: 1.25rem;
  }

  .saludo-contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .saludo-hora {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--primary-400);
    letter-spacing: 0.04em;
    margin-bottom: 4px;
  }

  .saludo-nombre {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: white;
    margin-bottom: 6px;
  }

  .saludo-nombre span {
    color: var(--primary-400);
  }

  .saludo-sub {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .btn-contactanos {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0.65rem 1.25rem;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s;
    backdrop-filter: blur(4px);
  }

  .btn-contactanos:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .btn-contactanos svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .btn-contactanos-flotante {
    display: none;
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--primary-700);
    box-shadow: 0 4px 16px rgba(29, 78, 216, 0.4);
    align-items: center;
    justify-content: center;
    z-index: 50;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .btn-contactanos-flotante svg {
    width: 22px;
    height: 22px;
  }

  .btn-contactanos-flotante:hover {
    transform: scale(1.08);
  }

  /* ── carrusel ── */
  .seccion-carrusel {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .carrusel-wrap {
    position: relative;
    border-radius: 14px;
    overflow: hidden;
  }

  .carrusel-viewport {
    overflow: hidden;
    border-radius: 14px;
    border: 1px solid var(--secondary-200);
  }

  .carrusel-track {
    display: flex;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
  }

  .carrusel-slide {
    flex: 0 0 100%;
    min-height: 180px;
    padding: 1.5rem 2rem;
    border-radius: 14px;
  }

  .slide-contenido {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
  }

  .slide-texto {
    flex: 1;
  }

  .slide-tag {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  .slide-nombre {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--secondary-900);
    margin-bottom: 6px;
  }

  .slide-desc {
    font-size: 0.82rem;
    color: var(--secondary-600);
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .slide-btn {
    display: inline-block;
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    color: white;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s, transform 0.15s;
  }

  .slide-btn:hover {
    opacity: 0.9;
    transform: translateX(2px);
  }

  .slide-imagen-wrap {
    width: 320px;
    height: 220px;
    overflow: hidden;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .slide-imagen {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  :global(.slide-placeholder) {
    width: 100%;
    height: 100%;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    font-weight: 700;
  }

  .carrusel-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: white;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: box-shadow 0.15s, transform 0.15s;
  }

  .carrusel-btn:hover {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    transform: translateY(-50%) scale(1.05);
  }

  .carrusel-btn svg {
    width: 18px;
    height: 18px;
    fill: var(--secondary-700);
  }

  .carrusel-prev {
    left: 10px;
  }

  .carrusel-next {
    right: 10px;
  }

  .carrusel-dots {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 10px 0 2px;
  }

  .carrusel-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    background: var(--secondary-300);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    padding: 0;
  }

  .carrusel-dot.activo {
    background: var(--primary-600);
    transform: scale(1.3);
  }

  /* ── mis datos ── */
  .seccion-datos {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
  }

  .grilla-datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .dato-card {
    background: white;
    border: 1px solid var(--secondary-200);
    border-radius: 10px;
    padding: 0.9rem 1rem;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: box-shadow 0.15s, border-color 0.15s;
  }

  .dato-card:hover {
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
    border-color: var(--primary-200);
  }

  .dato-icono {
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--primary-50);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .dato-icono svg {
    width: 18px;
    height: 18px;
    fill: var(--primary-600);
  }

  .dato-icono-verde {
    background: #dcfce7;
  }

  .dato-icono-verde svg {
    fill: #16a34a;
  }

  .dato-label {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--secondary-400);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .dato-valor {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--secondary-800);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dato-verde {
    color: #16a34a;
  }

  .dato-rojo {
    color: #dc2626;
  }

  @media (max-width: 768px) {
    .saludo-contenido {
      flex-direction: column;
      align-items: flex-start;
    }

    .grilla-datos {
      grid-template-columns: 1fr 1fr;
    }

    .btn-contactanos {
      display: none;
    }

    .btn-contactanos-flotante {
      display: flex;
    }

    .slide-imagen-wrap {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .grilla-datos {
      grid-template-columns: 1fr;
    }

  }

  .inicio-dashboard {
    --inicio-radio: 30px;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.4rem);
    padding: 0.35rem 0 1rem;
  }

  .inicio-dashboard::before {
    position: absolute;
    z-index: -1;
    top: -1.5rem;
    right: -2rem;
    left: -2rem;
    height: 31rem;
    background:
      radial-gradient(ellipse at 16% 10%, rgba(191, 219, 254, 0.34), transparent 48%),
      radial-gradient(ellipse at 94% 4%, rgba(251, 191, 36, 0.1), transparent 34%);
    content: "";
    pointer-events: none;
