---
// flujo de checkout del cliente: mapa de direccion -> metodo de pago -> (stripe) -> mis pedidos.
// escucha 'georuta:iniciar-checkout' (lo emite el boton "Confirmar pedido" del catalogo) y,
// cuando el pedido queda creado, emite 'georuta:pedido-creado' para que el catalogo vacie el carrito.
---

<!-- leaflet (mapa) y stripe.js: solo se necesitan en esta vista -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script is:inline src="https://js.stripe.com/v3/"></script>

<!-- ═══════════ modal 1: mapa de direccion ═══════════ -->
<div id="ck-mapa" class="ck-overlay" role="dialog" aria-modal="true" aria-labelledby="ck-mapa-titulo">
  <div class="ck-caja ck-caja-mapa">
    <div class="ck-cabecera">
      <div>
        <h3 class="ck-titulo" id="ck-mapa-titulo">📍 ¿Dónde entregamos tu pedido?</h3>
        <p class="ck-subtitulo">Escribe tu dirección o haz clic en el mapa</p>
      </div>
      <button type="button" class="ck-cerrar" data-ck-cerrar="mapa" aria-label="Cerrar">×</button>
    </div>

    <div class="ck-buscador">
      <div class="ck-buscador-fila">
        <input id="ck-input-direccion" class="ck-input" type="text" placeholder="Ej: Calle 72 # 10-34, Bogotá" autocomplete="off" />
        <button type="button" id="ck-btn-buscar" class="ck-btn ck-btn-primario">Buscar</button>
      </div>
      <div id="ck-sugerencias" class="ck-sugerencias"></div>
    </div>

    <div id="ck-mapa-leaflet" class="ck-mapa-leaflet"></div>

    <div class="ck-pie">
      <div id="ck-direccion-txt" class="ck-direccion-txt">Mueve el marcador o busca tu dirección para continuar</div>
      <div class="ck-acciones">
        <button type="button" class="ck-btn ck-btn-secundario" data-ck-cerrar="mapa">Cancelar</button>
        <button type="button" id="ck-btn-confirmar-direccion" class="ck-btn ck-btn-oscuro" disabled>Confirmar dirección →</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════ modal 2: metodo de pago ═══════════ -->
<div id="ck-pago" class="ck-overlay" role="dialog" aria-modal="true" aria-labelledby="ck-pago-titulo">
  <div class="ck-caja ck-caja-pago">
    <div class="ck-cabecera">
      <div>
        <h3 class="ck-titulo" id="ck-pago-titulo">💳 ¿Cómo quieres pagar?</h3>
        <p class="ck-subtitulo">Elige tu método de pago para finalizar el pedido</p>
      </div>
      <button type="button" class="ck-cerrar" data-ck-cerrar="pago" aria-label="Cerrar">×</button>
    </div>

    <div class="ck-cuerpo">
      <div class="ck-resumen">
        <div class="ck-resumen-fila"><span>Empresa</span><strong id="ck-pago-empresa"></strong></div>
        <div class="ck-resumen-bloque">
          <span>Dirección de entrega</span>
          <strong id="ck-pago-direccion"></strong>
        </div>
        <hr class="ck-separador" />
        <div class="ck-resumen-fila"><span>Subtotal</span><strong id="ck-pago-subtotal"></strong></div>
        <div class="ck-resumen-fila"><span>Envío</span><strong id="ck-pago-envio"></strong></div>
        <div class="ck-resumen-fila ck-resumen-total"><span>Total a pagar</span><strong id="ck-pago-total"></strong></div>
      </div>

      <div class="ck-opciones">
        <label class="ck-opcion">
          <input type="radio" name="ck-metodo" value="online" checked />
          <div>
            <div class="ck-opcion-titulo">💳 Pagar en línea</div>
            <div class="ck-opcion-desc">Tarjeta de crédito o débito (Stripe)</div>
          </div>
        </label>
        <label class="ck-opcion">
          <input type="radio" name="ck-metodo" value="contra_entrega" />
          <div>
            <div class="ck-opcion-titulo">💵 Contra entrega</div>
            <div class="ck-opcion-desc">Pagas en efectivo al recibir tu pedido</div>
          </div>
        </label>
      </div>

      <div id="ck-msg-pago" class="ck-msg"></div>

      <div class="ck-acciones">
        <button type="button" class="ck-btn ck-btn-secundario" id="ck-btn-atras">Atrás</button>
        <button type="button" class="ck-btn ck-btn-oscuro" id="ck-btn-finalizar">Hacer pedido</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════ modal 3: pago con tarjeta (stripe payment element) ═══════════ -->
<div id="ck-stripe" class="ck-overlay ck-overlay-alto" role="dialog" aria-modal="true" aria-labelledby="ck-stripe-titulo">
  <div class="ck-caja ck-caja-pago">
    <div class="ck-cabecera">
      <div>
        <h3 class="ck-titulo" id="ck-stripe-titulo">🔒 Pago seguro con tarjeta</h3>
        <p class="ck-subtitulo">Procesado por Stripe — modo de prueba</p>
      </div>
    </div>

    <div class="ck-cuerpo">
      <div class="ck-resumen">
        <div class="ck-resumen-fila ck-resumen-total"><span>Total a pagar (USD)</span><strong id="ck-stripe-total"></strong></div>
        <p class="ck-nota">Convertido desde COP según la tasa de cambio configurada.</p>
      </div>

      <div id="ck-payment-element" class="ck-payment-element"></div>
      <div id="ck-msg-stripe" class="ck-msg"></div>

      <div class="ck-acciones">
        <button type="button" class="ck-btn ck-btn-secundario" id="ck-btn-cancelar-stripe">Cancelar</button>
        <button type="button" class="ck-btn ck-btn-oscuro" id="ck-btn-pagar">Pagar ahora</button>
      </div>

      <div class="ck-prueba">
        💡 Modo prueba: usa la tarjeta <strong>4242 4242 4242 4242</strong>, cualquier fecha futura y cualquier CVC.
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const ENVIO = 8000;
    // centro inicial del mapa (bogota); si el navegador da la ubicacion, se usa esa
    const CENTRO_INICIAL = [4.711, -74.0721];

    // ── estado del checkout ──
    let carrito = {};
    let productos = [];
    let proveedor = null;

    let mapa = null;
    let marcador = null;
    let coords = { lat: null, lng: null, texto: '' }; // lo que el usuario tiene elegido en el mapa
    let direccionGuardada = null; // { id, lat, lng } -> evita guardar la misma direccion dos veces
    let pedidoCreado = null; // id del pedido ya creado en este checkout (por si el pago online se reintenta)
    let metodoPago = 'online';

    let stripe = null;
    let elementos = null;
    let idPedidoStripe = null;

    const $ = (id) => document.getElementById(id);
    const formatoCOP = (n) => '$' + Number(n).toLocaleString('es-CO');

    function toast(mensaje, esError) {
      const el = document.createElement('div');
      el.textContent = mensaje;
      el.style.cssText =
        'position:fixed;bottom:24px;left:50%;transform:translateX(-50%);color:#fff;padding:0.65rem 1.1rem;' +
        'border-radius:10px;font-size:0.85rem;z-index:99999;box-shadow:0 8px 24px rgba(0,0,0,0.2);' +
        'background:' + (esError ? '#dc2626' : '#1e293b');
      document.body.appendChild(el);
      setTimeout(() => el.remove(), 2600);
    }

    function mensaje(el, texto, ok) {
      el.textContent = texto;
      el.className = 'ck-msg ck-msg-visible ' + (ok ? 'ck-msg-ok' : 'ck-msg-error');
    }
    function limpiarMensaje(el) {
      el.className = 'ck-msg';
      el.textContent = '';
    }

    function abrir(id) { $(id).classList.add('ck-abierto'); }
    function cerrar(id) { $(id).classList.remove('ck-abierto'); }

    function calcularSubtotal() {
      let subtotal = 0;
      Object.keys(carrito).forEach((id) => {
        const p = productos.find((x) => Number(x.id) === Number(id));
        if (p) subtotal += Number(p.precio) * carrito[id];
      });
      return subtotal;
    }

    async function llamar(url, opciones) {
      const res = await fetch(url, opciones);
      let datos = {};
      try { datos = await res.json(); } catch (_) {}
      return datos;
    }
    function post(url, cuerpo) {
      return llamar(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(cuerpo),
      });
    }

    // ══════════════════ paso 0: entrada desde el catalogo ══════════════════
    document.addEventListener('georuta:iniciar-checkout', (evento) => {
      const detalle = evento.detail || {};
      carrito = detalle.carrito || {};
      productos = detalle.productosActuales || [];
      proveedor = detalle.proveedorActual || null;

      if (!Object.keys(carrito).some((id) => carrito[id] > 0)) {
        toast('⚠️ Tu carrito está vacío.', true);
        return;
      }
      if (!proveedor) {
        toast('⚠️ No se identificó la empresa del pedido.', true);
        return;
      }

      pedidoCreado = null; // checkout nuevo -> pedido nuevo
      bloquearMetodo(false);
      abrirMapa();
    });

    // ══════════════════ paso 1: mapa ══════════════════
    function abrirMapa() {
      abrir('ck-mapa');
      // leaflet necesita que el contenedor ya sea visible para medirlo
      setTimeout(() => {
        if (!mapa) iniciarMapa();
        else mapa.invalidateSize();
      }, 120);
    }

    function iconoMarcador() {
      return L.divIcon({
        className: '',
        html: '<div class="ck-pin"></div>',
        iconSize: [34, 34],
        iconAnchor: [17, 34],
      });
    }

    function iniciarMapa() {
      mapa = L.map('ck-mapa-leaflet').setView(CENTRO_INICIAL, 13);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a>',
        maxZoom: 19,
      }).addTo(mapa);

      marcador = L.marker(CENTRO_INICIAL, { draggable: true, icon: iconoMarcador() }).addTo(mapa);

      marcador.on('dragend', (e) => {
        const p = e.target.getLatLng();
        geocodificacionInversa(p.lat, p.lng);
      });
      mapa.on('click', (e) => {
        marcador.setLatLng(e.latlng);
        geocodificacionInversa(e.latlng.lat, e.latlng.lng);
      });

      if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const { latitude: lat, longitude: lng } = pos.coords;
            mapa.setView([lat, lng], 16);
            marcador.setLatLng([lat, lng]);
            geocodificacionInversa(lat, lng);
          },
          () => {}
        );
      }
    }

    async function geocodificacionInversa(lat, lng) {
      try {
        const res = await fetch(
          'https://nominatim.openstreetmap.org/reverse?lat=' + lat + '&lon=' + lng + '&format=json&accept-language=es'
        );
        const datos = await res.json();
        fijarDireccion(lat, lng, datos.display_name || lat.toFixed(6) + ', ' + lng.toFixed(6));
      } catch (_) {
        fijarDireccion(lat, lng, lat.toFixed(6) + ', ' + lng.toFixed(6));
      }
    }

    function fijarDireccion(lat, lng, texto) {
      coords = { lat, lng, texto };
      $('ck-direccion-txt').textContent = '📍 ' + texto;
      $('ck-btn-confirmar-direccion').disabled = false;
    }

        // ══════════════════ autocompletado de direcciones ══════════════════
    let temporizadorBusqueda = null;
    let controlBusqueda = null;
    let resultadosActuales = [];
    let indiceActivo = -1;
    const cacheBusquedas = new Map();

    function ocultarSugerencias() {
      $('ck-sugerencias').classList.remove('ck-visible');
      indiceActivo = -1;
    }

    // mensaje dentro de la caja (buscando, sin resultados, error)
    function mostrarAviso(texto) {
      const caja = $('ck-sugerencias');
      caja.innerHTML = '';
      const aviso = document.createElement('div');
      aviso.className = 'ck-sugerencia-aviso';
      aviso.textContent = texto;
      caja.appendChild(aviso);
      caja.classList.add('ck-visible');
    }

    function elegirSugerencia(r) {
      const lat = parseFloat(r.lat);
      const lng = parseFloat(r.lon);
      mapa.setView([lat, lng], 16);
      marcador.setLatLng([lat, lng]);
      $('ck-input-direccion').value = r.display_name;
      ocultarSugerencias();
      fijarDireccion(lat, lng, r.display_name);
    }

    function pintarSugerencias(resultados) {
      resultadosActuales = resultados;
      indiceActivo = -1;

      if (!resultados.length) {
        mostrarAviso('No se encontraron resultados.');
        return;
      }

      const caja = $('ck-sugerencias');
      caja.innerHTML = '';

      // textContent (nunca innerHTML) porque display_name viene de un servicio externo
      resultados.forEach((r) => {
        const item = document.createElement('div');
        item.className = 'ck-sugerencia';
        item.textContent = '📍 ' + r.display_name;
        item.addEventListener('click', () => elegirSugerencia(r));
        caja.appendChild(item);
      });

      caja.classList.add('ck-visible');
    }

    // marca visualmente la opcion activa al navegar con las flechas
    function resaltarSugerencia() {
      const items = $('ck-sugerencias').querySelectorAll('.ck-sugerencia');
      items.forEach((el, i) => el.classList.toggle('ck-sugerencia-activa', i === indiceActivo));
      if (items[indiceActivo]) items[indiceActivo].scrollIntoView({ block: 'nearest' });
    }

    async function buscarSugerencias(texto) {
      if (cacheBusquedas.has(texto)) {
        pintarSugerencias(cacheBusquedas.get(texto));
        return;
      }

      // si todavia hay una peticion en vuelo, se cancela: solo importa la ultima
      if (controlBusqueda) controlBusqueda.abort();
      controlBusqueda = new AbortController();

      mostrarAviso('Buscando...');

      try {
        const url =
          'https://nominatim.openstreetmap.org/search?q=' + encodeURIComponent(texto) +
          '&format=json&limit=5&accept-language=es&countrycodes=co';
        const res = await fetch(url, { signal: controlBusqueda.signal });
        if (!res.ok) throw new Error('nominatim respondio ' + res.status);

        const resultados = await res.json();
        cacheBusquedas.set(texto, resultados);
        pintarSugerencias(resultados);
      } catch (error) {
        if (error.name === 'AbortError') return;
        mostrarAviso('Error al buscar. Intenta de nuevo.');
      }
    }

    // busqueda inmediata (boton "Buscar" o enter sin opcion resaltada)
    function buscarAhora() {
      const texto = $('ck-input-direccion').value.trim();
      if (!texto) return;
      clearTimeout(temporizadorBusqueda);
      buscarSugerencias(texto);
    }

    async function confirmarDireccion() {
      if (coords.lat === null) {
        toast('⚠️ Selecciona una dirección en el mapa.', true);
        return;
      }

      // si ya se guardo exactamente este punto, se reutiliza (volver "atras" no duplica direcciones)
      if (direccionGuardada && direccionGuardada.lat === coords.lat && direccionGuardada.lng === coords.lng) {
        cerrar('ck-mapa');
        abrirPago();
        return;
      }

      const btn = $('ck-btn-confirmar-direccion');
      btn.textContent = 'Guardando...';
      btn.disabled = true;

      try {
        const datos = await post('/api/auth/cliente/direcciones', {
          direccionTexto: coords.texto,
          latitud: coords.lat,
          longitud: coords.lng,
        });

        if (!datos.success) {
          toast('❌ ' + (datos.message || 'No se pudo guardar la dirección'), true);
          return;
        }

        direccionGuardada = { id: datos.data.id, lat: coords.lat, lng: coords.lng };
        cerrar('ck-mapa');
        abrirPago();
      } catch (_) {
        toast('❌ Error de conexión.', true);
      } finally {
        btn.textContent = 'Confirmar dirección →';
        btn.disabled = false;
      }
    }

    // ══════════════════ paso 2: metodo de pago ══════════════════
    // una vez creado el pedido el metodo ya no se puede cambiar (quedo registrado como "online")
    function bloquearMetodo(bloqueado) {
      document.querySelectorAll('input[name="ck-metodo"]').forEach((r) => { r.disabled = bloqueado; });
    }

    function abrirPago() {
      const subtotal = calcularSubtotal();
      $('ck-pago-empresa').textContent = proveedor ? proveedor.nombre : '';
      $('ck-pago-direccion').textContent = coords.texto;
      $('ck-pago-subtotal').textContent = formatoCOP(subtotal);
      $('ck-pago-envio').textContent = formatoCOP(ENVIO);
      $('ck-pago-total').textContent = formatoCOP(subtotal + ENVIO);
      limpiarMensaje($('ck-msg-pago'));

      const btn = $('ck-btn-finalizar');
      btn.textContent = 'Hacer pedido';
      btn.disabled = false;
      abrir('ck-pago');
    }

    async function finalizarPedido() {
      if (!direccionGuardada) {
        toast('⚠️ Dirección no confirmada.', true);
        return;
      }

      const btn = $('ck-btn-finalizar');
      const msg = $('ck-msg-pago');
      btn.textContent = 'Procesando...';
      btn.disabled = true;

      const items = Object.keys(carrito)
        .filter((id) => carrito[id] > 0)
        .map((id) => ({ idProducto: Number(id), cantidad: carrito[id] }));

      try {
        // si el pedido ya existe (reintento del pago en linea) no se vuelve a crear
        if (!pedidoCreado) {
          const datos = await post('/api/auth/cliente/pedidos', {
            idEmpresa: Number(proveedor.id),
            idDireccion: direccionGuardada.id,
            metodoPago,
            items,
          });

          if (!datos.success) {
            mensaje(msg, '❌ ' + (datos.message || 'No se pudo crear el pedido'), false);
            btn.textContent = 'Hacer pedido';
            btn.disabled = false;
            return;
          }
          pedidoCreado = datos.data.idPedido;
          bloquearMetodo(true);
        }

        if (metodoPago === 'online') {
          mensaje(msg, '⏳ Preparando pago seguro...', true);

          const intento = await post('/api/auth/cliente/pago/crear-intencion', { idPedido: pedidoCreado });
          if (!intento.success) {
            mensaje(msg, '❌ ' + (intento.message || 'No se pudo iniciar el pago') + ' Puedes reintentar.', false);
            btn.textContent = 'Reintentar pago';
            btn.disabled = false;
            return;
          }

          cerrar('ck-pago');
          abrirStripe(intento.clientSecret, intento.publishableKey, pedidoCreado, intento.totalUsd);
          return;
        }

        // contra entrega: el pedido ya quedo registrado, se vacia el carrito y se lleva al cliente a "Mis pedidos"
        mensaje(msg, '✅ Pedido #' + pedidoCreado + ' registrado. Pagarás al recibir.', true);
        document.dispatchEvent(new CustomEvent('georuta:pedido-creado'));
        setTimeout(() => { window.location.href = '/cliente/pedidos'; }, 1400);
      } catch (_) {
        mensaje(msg, '❌ Error de conexión. Intenta de nuevo.', false);
        btn.textContent = 'Hacer pedido';
        btn.disabled = false;
      }
    }

    // ══════════════════ paso 3: stripe ══════════════════
    function abrirStripe(clientSecret, publishableKey, idPedido, totalUsd) {
      idPedidoStripe = idPedido;
      $('ck-stripe-total').textContent = '$' + Number(totalUsd).toFixed(2) + ' USD';
      limpiarMensaje($('ck-msg-stripe'));

      const btn = $('ck-btn-pagar');
      btn.textContent = 'Pagar ahora';
      btn.disabled = false;

      if (!stripe) stripe = Stripe(publishableKey);
      elementos = stripe.elements({ clientSecret });
      elementos.create('payment').mount('#ck-payment-element');

      abrir('ck-stripe');
    }

    function cerrarStripe() {
      cerrar('ck-stripe');
      $('ck-payment-element').innerHTML = '';
      elementos = null;
    }

    async function pagarConTarjeta() {
      if (!stripe || !elementos) return;

      const btn = $('ck-btn-pagar');
      const msg = $('ck-msg-stripe');
      btn.textContent = 'Procesando...';
      btn.disabled = true;

      const { error, paymentIntent } = await stripe.confirmPayment({
        elements: elementos,
        // solo se usa si el banco pide redireccion (3d secure); con tarjetas de prueba no pasa
        confirmParams: { return_url: window.location.origin + '/cliente/pedidos' },
        redirect: 'if_required',
      });

      if (error) {
        mensaje(msg, '❌ ' + (error.message || 'Error al procesar el pago.'), false);
        btn.textContent = 'Pagar ahora';
        btn.disabled = false;
        return;
      }

      if (paymentIntent && paymentIntent.status === 'succeeded') {
        mensaje(msg, '✅ ¡Pago exitoso! Registrando tu pedido...', true);
        try {
          // el backend verifica con stripe, marca el pago como aprobado y envia el recibo
          await llamar('/api/auth/cliente/pago/exito/' + idPedidoStripe);
        } catch (_) {}
        document.dispatchEvent(new CustomEvent('georuta:pedido-creado'));
        setTimeout(() => { window.location.href = '/cliente/pedidos'; }, 1200);
      } else {
        mensaje(msg, '⏳ Procesando, espera un momento...', true);
      }
    }

    // ══════════════════ eventos ══════════════════
        $('ck-btn-buscar').addEventListener('click', buscarAhora);

    // mientras se escribe: espera 600ms sin teclear y recien ahi consulta
    $('ck-input-direccion').addEventListener('input', () => {
      const texto = $('ck-input-direccion').value.trim();
      clearTimeout(temporizadorBusqueda);

      if (texto.length < 3) {
        if (controlBusqueda) controlBusqueda.abort();
        ocultarSugerencias();
        return;
      }

      temporizadorBusqueda = setTimeout(() => buscarSugerencias(texto), 600);
    });

    // teclado: flechas para moverse, enter para elegir, escape para cerrar
    $('ck-input-direccion').addEventListener('keydown', (e) => {
      const hayLista = $('ck-sugerencias').classList.contains('ck-visible') && resultadosActuales.length > 0;

      if (e.key === 'ArrowDown' && hayLista) {
        e.preventDefault();
        indiceActivo = (indiceActivo + 1) % resultadosActuales.length;
        resaltarSugerencia();
      } else if (e.key === 'ArrowUp' && hayLista) {
        e.preventDefault();
        indiceActivo = (indiceActivo - 1 + resultadosActuales.length) % resultadosActuales.length;
        resaltarSugerencia();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (hayLista && indiceActivo >= 0) elegirSugerencia(resultadosActuales[indiceActivo]);
        else buscarAhora();
      } else if (e.key === 'Escape') {
        ocultarSugerencias();
      }
    });

    // clic fuera de la caja: se cierra la lista
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#ck-input-direccion, #ck-sugerencias, #ck-btn-buscar')) {
        ocultarSugerencias();
      }
    });
    $('ck-btn-confirmar-direccion').addEventListener('click', confirmarDireccion);

    $('ck-btn-atras').addEventListener('click', () => {
      cerrar('ck-pago');
      abrirMapa();
    });
    $('ck-btn-finalizar').addEventListener('click', finalizarPedido);

    document.querySelectorAll('input[name="ck-metodo"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        metodoPago = radio.value;
        const btn = $('ck-btn-finalizar');
        btn.textContent = pedidoCreado && metodoPago === 'online' ? 'Reintentar pago' : 'Hacer pedido';
      });
    });

    // cancelar el pago con tarjeta devuelve al paso anterior; el pedido ya existe, asi que
    // "Hacer pedido" solo vuelve a pedir la intencion de pago, no crea otro pedido
    $('ck-btn-cancelar-stripe').addEventListener('click', () => {
      cerrarStripe();
      abrirPago();
      $('ck-btn-finalizar').textContent = 'Reintentar pago';
      mensaje($('ck-msg-pago'), 'Tu pedido #' + idPedidoStripe + ' quedó pendiente de pago.', false);
    });
    $('ck-btn-pagar').addEventListener('click', pagarConTarjeta);

    // cerrar con la X, con "Cancelar", o clic fuera de la caja (el modal de stripe no se cierra asi)
    document.querySelectorAll('[data-ck-cerrar]').forEach((el) => {
      el.addEventListener('click', () => cerrar('ck-' + el.dataset.ckCerrar));
    });
    ['ck-mapa', 'ck-pago'].forEach((id) => {
      $(id).addEventListener('click', (e) => {
        if (e.target === $(id)) cerrar(id);
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      cerrar('ck-mapa');
      cerrar('ck-pago');
    });
  })();
</script>

