---
// src/components/admin/InventarioAdmin.astro
export interface ItemInventario {
  id_producto: number;
  nombre: string;
  nombre_categoria: string;
  stock_disponible: number;
  stock_reservado: number;
  stock_minimo: number;
  imagen_url: string | null;
}

interface Props {
  inventarioInicial: ItemInventario[];
}

const { inventarioInicial } = Astro.props;
const backendUrlPublico = (
  import.meta.env.PUBLIC_API_DENO ||
  import.meta.env.API_DENO ||
  import.meta.env.PUBLIC_BACKEND_URL ||
  'http://127.0.0.1:8005'
).replace(/\/+$/, '');
---

<div class="encabezado-sec">
  <span class="titulo-sec">Inventario</span>
</div>

<div class="barra-filtros">
  <input class="input-busqueda" type="text" placeholder="Buscar producto..." id="buscar-inventario" style="width:260px" />
  <select class="input-busqueda" id="filtro-estado-stock" style="width:180px">
    <option value="">Todos los estados</option>
    <option value="agotado">Agotados</option>
    <option value="bajo">Stock bajo</option>
    <option value="ok">Stock normal</option>
  </select>
</div>

<div class="panel-card">
  <table class="tabla-admin">
    <thead>
      <tr>
        <th>Imagen</th>
        <th>Producto</th>
        <th>Categoría</th>
        <th>Disponible</th>
        <th>Reservado</th>
        <th>Mínimo</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="tbody-inventario">
      <tr><td colspan="8" style="text-align:center;color:#94a3b8;padding:2rem">Cargando inventario...</td></tr>
    </tbody>
  </table>
</div>

<!-- modal agregar stock -->
<div class="modal-overlay" id="modal-stock" style="display:none">
  <div class="modal-box" style="max-width:460px">
    <div class="modal-header">
      <h2 class="modal-titulo" id="modal-stock-titulo">Agregar stock</h2>
      <button class="modal-cerrar" id="btn-cerrar-modal-stock">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
      </button>
    </div>
    <div class="modal-body">
      <input type="hidden" id="stock-id-producto" value="" />
      <div class="form-grupo">
        <label class="form-label">Stock actual</label>
        <input class="form-input" id="stock-actual" disabled />
      </div>
      <div class="form-grupo">
        <label class="form-label">Cantidad a agregar</label>
        <input class="form-input" id="stock-cantidad" type="number" min="1" step="1" placeholder="0" />
      </div>
      <div class="form-grupo">
        <label class="form-label">Motivo</label>
        <textarea class="form-input" id="stock-motivo" rows="2" placeholder="Ej: Compra a proveedor, reposición..."></textarea>
      </div>
      <div id="msg-stock" style="display:none"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-secundario" id="btn-cancelar-stock">Cancelar</button>
      <button class="btn-primario" id="btn-guardar-stock">Agregar stock</button>
    </div>
  </div>
</div>

<!-- modal historial -->
<div class="modal-overlay" id="modal-historial" style="display:none">
  <div class="modal-box" style="max-width:820px">
    <div class="modal-header">
      <h2 class="modal-titulo" id="modal-historial-titulo">Historial de movimientos</h2>
      <button class="modal-cerrar" id="btn-cerrar-modal-historial">
        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" /></svg>
      </button>
    </div>
    <div class="modal-body">
      <table class="tabla-admin">
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Cantidad</th>
            <th>Anterior</th>
            <th>Nuevo</th>
            <th>Motivo</th>
            <th>Usuario</th>
          </tr>
        </thead>
        <tbody id="tbody-historial"></tbody>
      </table>
    </div>
    <div class="modal-footer">
      <button class="btn-secundario" id="btn-cerrar-historial">Cerrar</button>
    </div>
  </div>
</div>

<script define:vars={{ inventarioInicial, backendUrlPublico }}>
  let inventario = inventarioInicial;

  const svgSinImagen = `
    <svg viewBox="0 0 24 24" style="width:28px;height:28px;fill:#94a3b8">
      <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"/></svg>`;

  function escapar(texto) {
    return String(texto ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function resolverImagenProducto(url) {
    if (!url || /^(https?:|data:|blob:)/i.test(url)) return url;
    return `${backendUrlPublico}${url.startsWith('/') ? url : `/${url}`}`;
  }

  function estadoStock(item) {
    if (item.stock_disponible === 0) return 'agotado';
    if (item.stock_minimo > 0 && item.stock_disponible <= item.stock_minimo) return 'bajo';
    return 'ok';
  }

  async function refrescarInventario() {
    const res = await fetch('/api/auth/admin/inventario');
    const data = await res.json();
    if (data.success) {
      inventario = data.data;
      renderInventario();
    }
    return data;
  }

  function renderInventario() {
    const tbody = document.getElementById('tbody-inventario');
    if (!tbody) return;

    const texto = document.getElementById('buscar-inventario')?.value.toLowerCase() ?? '';
    const estadoFiltro = document.getElementById('filtro-estado-stock')?.value ?? '';

    const filtrados = inventario.filter(
      (p) =>
        p.nombre.toLowerCase().includes(texto) &&
        (!estadoFiltro || estadoStock(p) === estadoFiltro),
    );

    if (!filtrados.length) {
      tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:#94a3b8;padding:2rem">
        No hay productos para mostrar.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtrados
      .map((p) => {
        const imagen = p.imagen_url
          ? `<img src="${escapar(resolverImagenProducto(p.imagen_url))}" style="width:44px;height:44px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0">`
          : `<div style="width:44px;height:44px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;margin:0 auto">${svgSinImagen}</div>`;

        const estado = estadoStock(p);
        const badge =
          estado === 'agotado'
            ? '<span class="badge badge-rojo">Agotado</span>'
            : estado === 'bajo'
              ? '<span class="badge" style="background:#fef3c7;color:#b45309">Stock bajo</span>'
              : '<span class="badge badge-verde">Normal</span>';

        const colorStock = estado === 'agotado' ? 'var(--rojo-500)' : estado === 'bajo' ? '#d97706' : 'var(--slate-700)';

        return `
        <tr>
          <td style="text-align:center">${imagen}</td>
          <td style="font-weight:600;color:var(--slate-800)">${escapar(p.nombre)}</td>
          <td>${escapar(p.nombre_categoria)}</td>
          <td><span style="font-weight:600;color:${colorStock}">${p.stock_disponible}</span></td>
          <td>${p.stock_reservado}</td>
          <td>${p.stock_minimo}</td>
          <td>${badge}</td>
          <td>
            <div style="display:flex;gap:6px">
              <button class="btn-primario" data-accion="agregar" data-id="${p.id_producto}">Agregar stock</button>
              <button class="btn-secundario" data-accion="historial" data-id="${p.id_producto}">Historial</button>
            </div>
          </td>
        </tr>`;
      })
      .join('');
  }

  // ---------- modal agregar stock ----------
  function mostrarMensaje(texto, ok) {
    const el = document.getElementById('msg-stock');
    if (!el) return;
    el.textContent = texto;
    el.className = ok ? 'admin-msg-ok' : 'admin-msg-err';
    el.style.display = 'block';
  }

  function ocultarMensaje() {
    const el = document.getElementById('msg-stock');
    if (el) el.style.display = 'none';
  }

  function abrirModalStock(id) {
    const p = inventario.find((x) => x.id_producto === id);
    if (!p) return;
    document.getElementById('modal-stock-titulo').textContent = `Agregar stock — ${p.nombre}`;
    document.getElementById('stock-id-producto').value = String(p.id_producto);
    document.getElementById('stock-actual').value = `${p.stock_disponible} uds`;
    document.getElementById('stock-cantidad').value = '';
    document.getElementById('stock-motivo').value = '';
    ocultarMensaje();
    document.getElementById('modal-stock').style.display = 'flex';
  }

  function cerrarModalStock() {
    document.getElementById('modal-stock').style.display = 'none';
  }

  async function guardarStock() {
    const id = Number(document.getElementById('stock-id-producto')?.value);
    const cantidad = Number(document.getElementById('stock-cantidad')?.value);
    const motivo = document.getElementById('stock-motivo')?.value.trim() ?? '';
    const btn = document.getElementById('btn-guardar-stock');

    if (!id) return mostrarMensaje('Producto inválido.', false);
    if (!Number.isInteger(cantidad) || cantidad <= 0) {
      return mostrarMensaje('Ingresa una cantidad entera mayor a 0.', false);
    }
    if (!motivo) return mostrarMensaje('El motivo es obligatorio.', false);

    const textoOrig = btn.innerHTML;
    btn.innerHTML = 'Guardando...';
    btn.disabled = true;

    try {
      const res = await fetch('/api/auth/admin/inventario/agregar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id_producto: id, cantidad, motivo }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        mostrarMensaje('✓ ' + data.message, true);
        await refrescarInventario();
        setTimeout(cerrarModalStock, 900);
      } else {
        mostrarMensaje('✗ ' + (data.message ?? 'Error al agregar stock'), false);
      }
    } catch {
      mostrarMensaje('✗ Error de conexión.', false);
    } finally {
      btn.innerHTML = textoOrig;
      btn.disabled = false;
    }
  }

  // ---------- modal historial ----------
  async function abrirHistorial(id) {
    const tbody = document.getElementById('tbody-historial');
    const titulo = document.getElementById('modal-historial-titulo');
    const p = inventario.find((x) => x.id_producto === id);
    titulo.textContent = `Historial — ${p?.nombre ?? ''}`;
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:2rem">Cargando...</td></tr>`;
    document.getElementById('modal-historial').style.display = 'flex';

    try {
      const res = await fetch(`/api/auth/admin/inventario/${id}/historial`);
      const data = await res.json();
      if (!res.ok || !data.success) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#b91c1c;padding:2rem">${escapar(data.message ?? 'No se pudo cargar el historial')}</td></tr>`;
        return;
      }

      const movimientos = data.data.movimientos ?? [];
      if (!movimientos.length) {
        tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:2rem">Sin movimientos registrados.</td></tr>`;
        return;
      }

      tbody.innerHTML = movimientos
        .map((m) => {
          const fecha = new Date(m.fecha).toLocaleString('es-CO', {
            year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit',
          });
          return `
          <tr>
            <td>${escapar(fecha)}</td>
            <td style="text-transform:capitalize">${escapar(m.tipo_movimiento)}</td>
            <td style="font-weight:600">${escapar(m.cantidad)}</td>
            <td>${escapar(m.stock_anterior)}</td>
            <td>${escapar(m.stock_nuevo)}</td>
            <td>${escapar(m.motivo)}</td>
            <td>${escapar(`${m.nombre_usuario ?? ''} ${m.apellido_usuario ?? ''}`.trim())}</td>
          </tr>`;
        })
        .join('');
    } catch {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#b91c1c;padding:2rem">Error de conexión.</td></tr>`;
    }
  }

  function cerrarHistorial() {
    document.getElementById('modal-historial').style.display = 'none';
  }

  // ---------- listeners ----------
  document.getElementById('buscar-inventario')?.addEventListener('input', renderInventario);
  document.getElementById('filtro-estado-stock')?.addEventListener('change', renderInventario);

  document.getElementById('btn-cerrar-modal-stock')?.addEventListener('click', cerrarModalStock);
  document.getElementById('btn-cancelar-stock')?.addEventListener('click', cerrarModalStock);
  document.getElementById('btn-guardar-stock')?.addEventListener('click', guardarStock);
  document.getElementById('modal-stock')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarModalStock();
  });

  document.getElementById('btn-cerrar-modal-historial')?.addEventListener('click', cerrarHistorial);
  document.getElementById('btn-cerrar-historial')?.addEventListener('click', cerrarHistorial);
  document.getElementById('modal-historial')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarHistorial();
  });

  document.getElementById('tbody-inventario')?.addEventListener('click', (e) => {
    const boton = e.target.closest('button[data-accion]');
    if (!boton) return;
    const id = Number(boton.dataset.id);
    if (boton.dataset.accion === 'agregar') abrirModalStock(id);
    if (boton.dataset.accion === 'historial') abrirHistorial(id);
  });

  renderInventario();
</script>

<style>
  #modal-stock.modal-overlay,
  #modal-historial.modal-overlay {
    align-items: flex-start;
    overflow-y: auto;
    padding: 1rem;
  }

  #modal-stock .modal-box,
  #modal-historial .modal-box {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-height: calc(100dvh - 2rem);
    margin: auto;
  }

  #modal-stock .modal-body,
  #modal-historial .modal-body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }
</style>