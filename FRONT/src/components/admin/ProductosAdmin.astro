---
// src/components/admin/ProductosAdmin.astro
// panel de productos del admin — puerto de Views/Admin/Productos.cshtml + la parte de
// productos de Script_Admin.js, adaptado a los campos reales que devuelve el backend deno
// (id_producto, imagen_url, id_categoria, categoria, activo) en vez de los que usaba el c#
// original (id, imagenUrl, idCategoria, activo booleano)

export interface ProductoAdmin {
  id_producto: number;
  nombre: string;
  descripcion: string | null;
  categoria: string;
  id_categoria: number;
  precio: number;
  imagen_url: string | null;
  activo: number; // 0 o 1, tal como sale de mysql
  stock: number;
}

export interface CategoriaAdmin {
  id_categoria: number;
  nombre: string;
}

interface Props {
  productosIniciales: ProductoAdmin[];
  categoriasIniciales: CategoriaAdmin[];
}

const { productosIniciales, categoriasIniciales } = Astro.props;
const backendUrlPublico = (
  import.meta.env.PUBLIC_API_DENO ||
  import.meta.env.API_DENO ||
  import.meta.env.PUBLIC_BACKEND_URL ||
  'http://127.0.0.1:8005'
).replace(/\/+$/, '');
---

<div class="encabezado-sec">
  <span class="titulo-sec">Catálogo de productos</span>
  <button class="btn-primario" id="btn-abrir-modal-producto">
    <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" /></svg>
    Agregar producto
  </button>
</div>

<!-- pestanas de estado -->
<div class="tabs-productos">
  <button id="tab-activos" class="tab-producto tab-activo" data-tab="activos">
    ✅ Activos <span id="count-activos" class="tab-contador tab-contador-activo">0</span>
  </button>
  <button id="tab-inactivos" class="tab-producto" data-tab="inactivos">
    ❌ Inactivos <span id="count-inactivos" class="tab-contador">0</span>
  </button>
</div>

<!-- busqueda y filtro -->
<div class="barra-filtros">
  <input class="input-busqueda" type="text" placeholder="Buscar producto..." id="buscar-producto" style="width:260px" />
  <select class="input-busqueda" id="filtro-categoria" style="width:180px">
    <option value="">Todas las categorías</option>
    {categoriasIniciales.map((c) => (
      <option value={c.nombre}>{c.nombre}</option>
    ))}
  </select>
</div>

<!-- tabla -->
<div class="panel-card">
  <table class="tabla-admin">
    <thead>
      <tr>
        <th>Imagen</th>
        <th>Producto</th>
        <th>Categoría</th>
        <th>Precio</th>
        <th>Stock</th>
        <th>Estado</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="tbody-productos">
      <tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:2rem">Cargando productos...</td></tr>
    </tbody>
  </table>
</div>

<!-- modal agregar / editar -->
<div class="modal-overlay" id="modal-producto" style="display:none">
  <div class="modal-box" style="max-width:560px">
    <div class="modal-header">
      <h2 class="modal-titulo" id="modal-titulo-txt">Agregar producto</h2>
      <button class="modal-cerrar" id="btn-cerrar-modal-producto">
        <svg viewBox="0 0 24 24">
          <path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        </svg>
      </button>
    </div>

    <div class="modal-body">
      <div class="prod-imagen-zona" id="prod-imagen-zona">
        <div class="prod-imagen-preview" id="prod-imagen-preview">
          <svg viewBox="0 0 24 24" style="width:36px;height:36px;fill:#94a3b8">
            <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z" />
          </svg>
          <span>Haz clic para agregar imagen</span>
          <span style="font-size:0.72rem;color:#cbd5e1">Puedes seleccionar varias · JPG, PNG, WEBP · máx. 3MB cada una</span>
        </div>
        <input type="file" id="prod-imagen" accept="image/jpeg,image/png,image/webp" multiple style="display:none" />
      </div>
      <div class="prod-galeria-actual" id="prod-galeria-actual" hidden>
        <span class="form-label">Imágenes guardadas</span>
        <div class="prod-galeria-lista" id="prod-galeria-lista"></div>
      </div>

      <input type="hidden" id="prod-id" value="" />

      <div class="form-fila">
        <div class="form-grupo">
          <label class="form-label">Nombre del producto</label>
          <input class="form-input" id="prod-nombre" placeholder="Ej: Arroz Diana 500g" />
        </div>
        <div class="form-grupo">
          <label class="form-label">Categoría</label>
          <select class="form-input" id="prod-categoria">
            <option value="">Cargando categorías...</option>
          </select>
        </div>
      </div>

      <div class="form-fila">
        <div class="form-grupo">
          <label class="form-label">Precio (COP)</label>
          <input class="form-input" id="prod-precio" type="number" placeholder="0" min="0" />
        </div>
        <div class="form-grupo">
          <label class="form-label">Stock</label>
          <input class="form-input" id="prod-stock" type="number" placeholder="0" min="0" />
        </div>
      </div>

      <div class="form-grupo">
        <label class="form-label">Descripción (opcional)</label>
        <textarea class="form-input" id="prod-desc" rows="2" placeholder="Descripción breve..."></textarea>
      </div>

      <div id="msg-producto" style="display:none"></div>
    </div>

    <div class="modal-footer">
      <button class="btn-secundario" id="btn-cancelar-producto">Cancelar</button>
      <button class="btn-primario" id="btn-guardar-prod">Guardar producto</button>
    </div>
  </div>
</div>

<script define:vars={{ productosIniciales, categoriasIniciales, backendUrlPublico }}>
  // ============================================================
  // estado local del componente (arranca con lo que trajo el ssr)
  // ============================================================
  let productos = productosIniciales;
  let categorias = categoriasIniciales;
  let tabActual = 'activos';
  let urlsImagenesSeleccionadas = [];

  const svgSinImagen = `
    <svg viewBox="0 0 24 24" style="width:36px;height:36px;fill:#94a3b8">
      <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0
      1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5
      12l4.5 6H5l3.5-4.5z"/></svg>`;

  function resolverImagenProducto(url) {
    if (!url || /^(https?:|data:|blob:)/i.test(url)) return url;
    return `${backendUrlPublico}${url.startsWith('/') ? url : `/${url}`}`;
  }

  // ============================================================
  // llamadas al backend (via proxies bff en /api/auth/admin/*)
  // ============================================================
  async function refrescarProductos() {
    const res = await fetch('/api/auth/admin/productos');
    const data = await res.json();
    if (data.success) {
      productos = data.data;
      renderProductos();
    }
    return data;
  }

  async function refrescarCategoriasSelect() {
    const res = await fetch('/api/auth/admin/categorias');
    const data = await res.json();
    if (!data.success) return;
    categorias = data.data;
    const select = document.getElementById('prod-categoria');
    if (select) {
      select.innerHTML = categorias
        .map((c) => `<option value="${c.id_categoria}">${c.nombre}</option>`)
        .join('');
    }
  }

  // ============================================================
  // render de la tabla
  // ============================================================
  function renderProductos() {
    const tbody = document.getElementById('tbody-productos');
    if (!tbody) return;

    const activos = productos.filter((p) => p.activo);
    const inactivos = productos.filter((p) => !p.activo);
    const elCA = document.getElementById('count-activos');
    const elCI = document.getElementById('count-inactivos');
    if (elCA) elCA.textContent = String(activos.length);
    if (elCI) elCI.textContent = String(inactivos.length);

    const texto = document.getElementById('buscar-producto')?.value.toLowerCase() ?? '';
    const catFiltro = document.getElementById('filtro-categoria')?.value ?? '';

    const filtrados = productos.filter(
      (p) =>
        (tabActual === 'activos' ? p.activo : !p.activo) &&
        p.nombre.toLowerCase().includes(texto) &&
        (!catFiltro || p.categoria === catFiltro),
    );

    if (!filtrados.length) {
      tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#94a3b8;padding:2rem">
        No hay productos en esta categoría.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtrados
      .map((p) => {
        const imagen = p.imagen_url
          ? `<img src="${resolverImagenProducto(p.imagen_url)}" style="width:44px;height:44px;object-fit:contain;border-radius:6px;border:1px solid #e2e8f0">`
          : `<div style="width:44px;height:44px;border-radius:6px;background:#f1f5f9;display:flex;align-items:center;justify-content:center;margin:0 auto">${svgSinImagen}</div>`;

        const colorStock = p.stock === 0 ? 'var(--rojo-500)' : p.stock < 10 ? '#d97706' : 'var(--slate-700)';
        const iconoStock = p.stock === 0 ? '⚠' : p.stock < 10 ? '↓' : '';

        return `
        <tr style="opacity:${p.activo ? '1' : '0.65'}">
          <td style="text-align:center">${imagen}</td>
          <td>
            <div style="font-weight:600;color:var(--slate-800)">${p.nombre}</div>
            ${p.descripcion ? `<div style="font-size:0.72rem;color:var(--slate-400);margin-top:2px">${p.descripcion}</div>` : ''}
          </td>
          <td>${p.categoria}</td>
          <td style="font-weight:600">$${Number(p.precio).toLocaleString('es-CO')}</td>
          <td><span style="font-weight:600;color:${colorStock}">${p.stock} uds ${iconoStock}</span></td>
          <td><span class="badge ${p.activo ? 'badge-verde' : 'badge-slate'}">${p.activo ? 'Activo' : 'Inactivo'}</span></td>
          <td>
            <div style="display:flex;gap:6px">
              <button class="btn-secundario" data-accion="editar" data-id="${p.id_producto}">Editar</button>
              <button class="${p.activo ? 'btn-peligro' : 'btn-primario'}" data-accion="toggle" data-id="${p.id_producto}">
                ${p.activo ? 'Desactivar' : 'Activar'}</button>
            </div>
          </td>
        </tr>`;
      })
      .join('');
  }

  // ============================================================
  // pestanas activos / inactivos
  // ============================================================
  function cambiarTab(tab) {
    tabActual = tab;
    document.getElementById('tab-activos')?.classList.toggle('tab-activo', tab === 'activos');
    document.getElementById('tab-inactivos')?.classList.toggle('tab-activo', tab === 'inactivos');
    document.getElementById('count-activos')?.classList.toggle('tab-contador-activo', tab === 'activos');
    document.getElementById('count-inactivos')?.classList.toggle('tab-contador-activo', tab === 'inactivos');
    renderProductos();
  }

  // ============================================================
  // modal: abrir / cerrar / editar / previsualizar imagen
  // ============================================================
  function limpiarPreview() {
    const preview = document.getElementById('prod-imagen-preview');
    urlsImagenesSeleccionadas.forEach((url) => URL.revokeObjectURL(url));
    urlsImagenesSeleccionadas = [];
    if (preview) {
      preview.innerHTML = `${svgSinImagen}<span>Haz clic para agregar imagen</span>
        <span style="font-size:0.72rem;color:#cbd5e1">Puedes seleccionar varias · JPG, PNG, WEBP · máx. 3MB cada una</span>`;
    }
    const galeriaActual = document.getElementById('prod-galeria-actual');
    const listaActual = document.getElementById('prod-galeria-lista');
    if (galeriaActual) galeriaActual.hidden = true;
    if (listaActual) listaActual.replaceChildren();
  }

  async function abrirModalCrear() {
    document.getElementById('modal-titulo-txt').textContent = 'Agregar producto';
    ['prod-id', 'prod-nombre', 'prod-precio', 'prod-stock', 'prod-desc'].forEach((id) => {
      const el = document.getElementById(id);
      if (el) el.value = '';
    });
    document.getElementById('prod-imagen').value = '';
    limpiarPreview();
    await refrescarCategoriasSelect();
    ocultarMensaje();
    document.getElementById('modal-producto').style.display = 'flex';
  }

  async function abrirModalEditar(id) {
    const p = productos.find((x) => x.id_producto === id);
    if (!p) return;

    limpiarPreview();
    let respuesta;
    let detalle;
    try {
      respuesta = await fetch(`/api/auth/admin/productos/${id}`);
      detalle = await respuesta.json();
    } catch (error) {
      console.error('Error al cargar el producto para editar:', error);
      mostrarMensaje('✗ No se pudo cargar el producto.', false);
      document.getElementById('modal-producto').style.display = 'flex';
      return;
    }
    if (!respuesta.ok || !detalle.success) {
      mostrarMensaje('✗ ' + (detalle.message ?? 'No se pudo cargar la galería del producto.'), false);
      document.getElementById('modal-producto').style.display = 'flex';
      return;
    }

    document.getElementById('modal-titulo-txt').textContent = 'Editar producto';
    document.getElementById('prod-id').value = String(p.id_producto);
    document.getElementById('prod-nombre').value = p.nombre;
    document.getElementById('prod-precio').value = String(p.precio);
    document.getElementById('prod-stock').value = String(p.stock);
    document.getElementById('prod-desc').value = p.descripcion ?? '';
    document.getElementById('prod-imagen').value = '';

    await refrescarCategoriasSelect();
    const select = document.getElementById('prod-categoria');
    if (select) select.value = String(p.id_categoria);

    const imagenes = Array.isArray(detalle.data.imagenes) ? detalle.data.imagenes : [];
    const galeriaActual = document.getElementById('prod-galeria-actual');
    const listaActual = document.getElementById('prod-galeria-lista');
    if (imagenes.length && galeriaActual && listaActual) {
      renderizarCarruselImagenes(
        listaActual,
        imagenes.map((imagen) => ({
          id: Number(imagen.id_imagen),
          url: resolverImagenProducto(imagen.url),
        })),
        p.nombre,
        (idImagen) => eliminarImagenProducto(p.id_producto, idImagen),
      );
      galeriaActual.hidden = false;
    }

    ocultarMensaje();
    document.getElementById('modal-producto').style.display = 'flex';
  }

  function cerrarModal() {
    document.getElementById('modal-producto').style.display = 'none';
  }

  function previsualizarImagen(input) {
    const archivos = Array.from(input.files ?? []);
    const archivoInvalido = archivos.find((archivo) => archivo.size > 3 * 1024 * 1024);
    if (archivoInvalido) {
      alert(`La imagen "${archivoInvalido.name}" supera el límite de 3MB.`);
      input.value = '';
      return;
    }

    const preview = document.getElementById('prod-imagen-preview');
    if (!preview) return;
    urlsImagenesSeleccionadas.forEach((url) => URL.revokeObjectURL(url));
    urlsImagenesSeleccionadas = [];
    if (!archivos.length) {
      limpiarPreview();
      return;
    }
    urlsImagenesSeleccionadas = archivos.map((archivo) => URL.createObjectURL(archivo));
    renderizarCarruselImagenes(preview, urlsImagenesSeleccionadas, 'Imagen seleccionada');
    const texto = document.createElement('span');
    texto.textContent = `${archivos.length} imagen${archivos.length === 1 ? '' : 'es'} seleccionada${archivos.length === 1 ? '' : 's'}`;
    preview.append(texto);
  }

  function renderizarCarruselImagenes(contenedor, imagenes, descripcion, alEliminar = null) {
    contenedor.replaceChildren();
    if (!imagenes.length) return;

    let indice = 0;
    const carrusel = document.createElement('div');
    carrusel.className = 'prod-carrusel';
    const marco = document.createElement('div');
    marco.className = 'prod-carrusel-marco';
    const img = document.createElement('img');
    img.alt = `${descripcion}, imagen 1 de ${imagenes.length}`;
    img.src = typeof imagenes[indice] === 'string' ? imagenes[indice] : imagenes[indice].url;
    marco.appendChild(img);

    const contador = document.createElement('span');
    contador.className = 'prod-carrusel-contador';
    contador.textContent = `1 / ${imagenes.length}`;
    marco.appendChild(contador);

    const actualizar = (direccion) => {
      indice = (indice + direccion + imagenes.length) % imagenes.length;
      img.src = typeof imagenes[indice] === 'string' ? imagenes[indice] : imagenes[indice].url;
      img.alt = `${descripcion}, imagen ${indice + 1} de ${imagenes.length}`;
      contador.textContent = `${indice + 1} / ${imagenes.length}`;
      img.classList.remove('prod-carrusel-deslizar-izquierda', 'prod-carrusel-deslizar-derecha');
      void img.offsetWidth;
      img.classList.add(direccion > 0 ? 'prod-carrusel-deslizar-derecha' : 'prod-carrusel-deslizar-izquierda');
    };

    if (imagenes.length > 1) {
      const anterior = document.createElement('button');
      anterior.type = 'button';
      anterior.className = 'prod-carrusel-nav prod-carrusel-anterior';
      anterior.setAttribute('aria-label', 'Ver imagen anterior');
      anterior.textContent = '‹';
      anterior.addEventListener('click', (evento) => {
        evento.stopPropagation();
        actualizar(-1);
      });

      const siguiente = document.createElement('button');
      siguiente.type = 'button';
      siguiente.className = 'prod-carrusel-nav prod-carrusel-siguiente';
      siguiente.setAttribute('aria-label', 'Ver imagen siguiente');
      siguiente.textContent = '›';
      siguiente.addEventListener('click', (evento) => {
        evento.stopPropagation();
        actualizar(1);
      });
      marco.append(anterior, siguiente);
    }

    if (alEliminar && typeof imagenes[indice] !== 'string') {
      const eliminar = document.createElement('button');
      eliminar.type = 'button';
      eliminar.className = 'prod-carrusel-eliminar';
      eliminar.textContent = 'Eliminar imagen';
      eliminar.addEventListener('click', (evento) => {
        evento.stopPropagation();
        alEliminar(imagenes[indice].id);
      });
      marco.appendChild(eliminar);
    }

    carrusel.appendChild(marco);
    contenedor.appendChild(carrusel);
  }

  async function eliminarImagenProducto(idProducto, idImagen) {
    if (!confirm('¿Eliminar esta imagen del producto? Esta acción no se puede deshacer.')) return;

    const galeriaActual = document.getElementById('prod-galeria-actual');
    const listaActual = document.getElementById('prod-galeria-lista');
    const boton = listaActual?.querySelector('.prod-carrusel-eliminar');
    if (boton) boton.disabled = true;

    try {
      const res = await fetch(`/api/auth/admin/productos/${idProducto}?idImagen=${idImagen}`, {
        method: 'DELETE',
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        mostrarMensaje('✗ ' + (data.message ?? 'No se pudo eliminar la imagen.'), false);
        return;
      }

      const detalleRes = await fetch(`/api/auth/admin/productos/${idProducto}`);
      const detalle = await detalleRes.json();
      if (!detalleRes.ok || !detalle.success) {
        mostrarMensaje('✓ Imagen eliminada, pero no se pudo actualizar la galería. Cierra y vuelve a abrir el producto.', true);
        return;
      }

      const imagenes = Array.isArray(detalle.data.imagenes) ? detalle.data.imagenes : [];
      if (imagenes.length && listaActual) {
        renderizarCarruselImagenes(
          listaActual,
          imagenes.map((imagen) => ({
            id: Number(imagen.id_imagen),
            url: resolverImagenProducto(imagen.url),
          })),
          document.getElementById('prod-nombre')?.value || 'Producto',
          (id) => eliminarImagenProducto(idProducto, id),
        );
      } else if (galeriaActual && listaActual) {
        galeriaActual.hidden = true;
        listaActual.replaceChildren();
      }
      await refrescarProductos();
      mostrarMensaje('✓ Imagen eliminada correctamente.', true);
    } catch (error) {
      console.error('Error al eliminar imagen del producto:', error);
      mostrarMensaje('✗ Error de conexión al eliminar la imagen.', false);
    }
  }

  // ============================================================
  // mensajes de resultado dentro del modal
  // ============================================================
  function mostrarMensaje(texto, ok) {
    const el = document.getElementById('msg-producto');
    if (!el) return;
    el.textContent = texto;
    el.className = ok ? 'admin-msg-ok' : 'admin-msg-err';
    el.style.display = 'block';
  }

  function ocultarMensaje() {
    const el = document.getElementById('msg-producto');
    if (el) el.style.display = 'none';
  }

  // ============================================================
  // guardar (crear o editar) — form-data por la imagen opcional
  // ============================================================
  async function guardarProducto() {
    const nombre = document.getElementById('prod-nombre')?.value.trim() ?? '';
    const idCategoria = document.getElementById('prod-categoria')?.value ?? '';
    const precio = document.getElementById('prod-precio')?.value ?? '';
    const stock = document.getElementById('prod-stock')?.value ?? '';
    const desc = document.getElementById('prod-desc')?.value.trim() ?? '';
    const idProd = document.getElementById('prod-id')?.value ?? '';
    const archivos = Array.from(document.getElementById('prod-imagen')?.files ?? []);
    const btn = document.getElementById('btn-guardar-prod');

    if (!nombre) return mostrarMensaje('El nombre es obligatorio.', false);
    if (!precio || Number(precio) < 0) return mostrarMensaje('Ingresa un precio válido.', false);
    if (!stock || Number(stock) < 0) return mostrarMensaje('Ingresa un stock válido.', false);
    if (!idCategoria) return mostrarMensaje('Selecciona una categoría.', false);

    const textoOrig = btn.innerHTML;
    btn.innerHTML = 'Guardando...';
    btn.disabled = true;

    try {
      const formData = new FormData();
      formData.append('nombre', nombre);
      formData.append('id_categoria', idCategoria);
      formData.append('precio', precio);
      formData.append('stock_disponible', stock);
      formData.append('descripcion', desc);
      for (const archivo of archivos) formData.append('imagenes', archivo);

      const ruta = idProd
        ? `/api/auth/admin/productos/${idProd}`
        : '/api/auth/admin/productos';
      const res = await fetch(ruta, { method: idProd ? 'PUT' : 'POST', body: formData });
      const data = await res.json();

      if (res.ok && data.success) {
        mostrarMensaje('✓ ' + data.message, true);
        await refrescarProductos();
        setTimeout(cerrarModal, 900);
      } else {
        mostrarMensaje('✗ ' + data.message, false);
      }
    } catch {
      mostrarMensaje('✗ Error de conexión.', false);
    } finally {
      btn.innerHTML = textoOrig;
      btn.disabled = false;
    }
  }

  // ============================================================
  // activar / desactivar
  // ============================================================
  async function toggleProducto(id) {
    const producto = productos.find((x) => x.id_producto === id);
    if (!producto) return;
    const accion = producto.activo ? 'desactivar' : 'activar';
    if (!confirm(`¿Deseas ${accion} este producto?`)) return;

    try {
      const res = await fetch('/api/auth/admin/productos/toggle', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ idProducto: id }),
      });
      const data = await res.json();
      if (data.success) await refrescarProductos();
      else alert('Error: ' + data.message);
    } catch {
      alert('Error de conexión.');
    }
  }

  // ============================================================
  // listeners
  // ============================================================
  document.getElementById('btn-abrir-modal-producto')?.addEventListener('click', abrirModalCrear);
  document.getElementById('btn-cerrar-modal-producto')?.addEventListener('click', cerrarModal);
  document.getElementById('btn-cancelar-producto')?.addEventListener('click', cerrarModal);
  document.getElementById('btn-guardar-prod')?.addEventListener('click', guardarProducto);
  document.getElementById('prod-imagen-zona')?.addEventListener('click', (evento) => {
    if (evento.target.closest('.prod-carrusel-nav')) return;
    document.getElementById('prod-imagen')?.click();
  });
  document.getElementById('prod-imagen')?.addEventListener('change', (e) => previsualizarImagen(e.target));
  document.getElementById('buscar-producto')?.addEventListener('input', renderProductos);
  document.getElementById('filtro-categoria')?.addEventListener('change', renderProductos);
  document.getElementById('tab-activos')?.addEventListener('click', () => cambiarTab('activos'));
  document.getElementById('tab-inactivos')?.addEventListener('click', () => cambiarTab('inactivos'));

  document.getElementById('modal-producto')?.addEventListener('click', function (e) {
    if (e.target === this) cerrarModal();
  });

  // delegacion de eventos para los botones editar/toggle que se regeneran en cada render
  document.getElementById('tbody-productos')?.addEventListener('click', (e) => {
    const boton = e.target.closest('button[data-accion]');
    if (!boton) return;
    const id = Number(boton.dataset.id);
    if (boton.dataset.accion === 'editar') abrirModalEditar(id);
    if (boton.dataset.accion === 'toggle') toggleProducto(id);
  });

  renderProductos();
</script>

