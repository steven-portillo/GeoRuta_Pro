---
import type { ColumnaDef } from "../../utils/agGrid";
import { utf8ToBase64 } from "../../utils/base64";
import "./Ag-grid-theme.css";
interface Props {
  data: any[];
  columnas: ColumnaDef[];
  resaltarCritico?: boolean;
}
const { data, columnas, resaltarCritico = false } = Astro.props;

const dataBase64 = utf8ToBase64(JSON.stringify(data));
const columnasBase64 = utf8ToBase64(JSON.stringify(columnas));
---

<div
  id="ag-grid-wrapper"
  data-rows={dataBase64}
  data-columnas={columnasBase64}
  style="margin-left: 2.5%; margin-right: 2.5%;"
>
  <div
    id="tabla-generica"
    class="ag-theme-alpine ag-theme-georuta"
    style="height:500px; width:95;"
  >
  </div>
</div>

<script>
  import {
    createGrid,
    ModuleRegistry,
    AllEnterpriseModule,
  } from "ag-grid-enterprise";
  import { base64ToUtf8 } from "../../utils/base64";

  ModuleRegistry.registerModules([AllEnterpriseModule]);

  // base publica de la API para las fotos de la tabla
  const IMG_BASE = import.meta.env.PUBLIC_API_DENO;

  document.addEventListener("DOMContentLoaded", () => {
    const wrapper = document.getElementById("ag-grid-wrapper") as HTMLElement;
    const rows = JSON.parse(base64ToUtf8(wrapper.dataset.rows ?? ""));
    const columnas = JSON.parse(base64ToUtf8(wrapper.dataset.columnas ?? ""));
    const resaltarCritico = wrapper.dataset.resaltarCritico === "true";

    const columnDefs = columnas.map((col: any) => {
      if (col.tipo === "acciones") {
        const cantidadBotones = col.acciones.length;
        const anchoEstimado = Math.max(180, cantidadBotones * 95);

        return {
          headerName: col.titulo,
          sortable: false,
          filter: false,
          resizable: false,
          width: anchoEstimado,
          minWidth: anchoEstimado, // ← esto es lo que faltaba: evita que flex lo achique
          maxWidth: anchoEstimado + 40, // un poco de margen, sin dejarlo crecer sin límite
          autoHeight: true, // permite que la fila crezca si los botones envuelven a 2 líneas
          cellStyle: {
            display: "flex",
            alignItems: "center",
            padding: "6px 4px",
          },
          cellRenderer: (params: any) => {
            if (!params.data) return "";
            const botones = col.acciones
              .map(
                (accion: string) => `
            <button class="btn btn-sm btn-outline-secondary"
                    style="white-space: nowrap; font-size: 0.75rem; padding: 0.25rem 0.5rem;"
                    data-accion="${accion}"
                    data-id="${params.data.id}">
              ${accion}
            </button>
          `,
              )
              .join("");
            return `<div style="display:flex; flex-wrap:wrap; gap:4px; align-items:center; justify-content:center; width:100%; padding:4px 0;">${botones}</div>`;
          },
        };
      }

      if (col.tipo === "estado") {
        return {
          field: col.campo,
          headerName: col.titulo,
          width: 130,
          cellRenderer: (params: any) => {
            const activo = params.value === 1 || params.value === true;
            return `<button class="pill-estado ${activo ? "pill-activo" : "pill-inactivo"}"
                       data-accion="toggle-estado"
                       data-id="${params.data.id}"
                       data-estado="${activo}">
                ${activo ? "Activo" : "Inactivo"}
              </button>`;
          },
        };
      }

      if (col.tipo === "imagen") {
        const defaultImg = col.defaultImg ?? "/defaults/usuarios.png"; // fallback genérico si la columna no especifica uno

        return {
          field: col.campo,
          headerName: col.titulo,
          sortable: false,
          filter: false,
          width: 90,
          cellRenderer: (params: any) => {
            if (!params.data) return "";

            let valor = (params.value ?? "").toString().trim();
            let src: string;

            if (!valor) {
              // Sin valor en absoluto: usa el default directo, sin pasar por IMG_BASE
              src = defaultImg;
            } else if (valor.startsWith("http")) {
              // URL externa completa, se usa tal cual
              src = valor;
            } else if (
              valor.startsWith("/defaults/") ||
              valor.startsWith("defaults/")
            ) {
              // Imagen default servida por Astro desde /public — NUNCA pasa por IMG_BASE,
              // porque no vive en el backend de Deno, vive en el propio frontend
              src = valor.startsWith("/") ? valor : `/${valor}`;
            } else {
              // Archivo real subido, servido por el middleware de Deno bajo /Uploads/
              let relativo = valor.replace(/^\/+/, "");
              if (relativo.startsWith("Uploads/")) {
                relativo = relativo.slice("Uploads/".length);
              }
              const segmentos = relativo
                .split("/")
                .map((s: string) => encodeURIComponent(s));
              src = `${IMG_BASE}/Uploads/${segmentos.join("/")}`; // "Uploads/" restaurado
            }

            return `
        <div class="d-flex h-100 align-items-center justify-content-center">
          <img
            src="${src}"
            alt="${col.titulo}"
            style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,0.15);"
            onerror="this.onerror=null;this.src='${defaultImg}';"
          />
        </div>`;
          },
        };
      }

      if (col.tipo === "moneda") {
        return {
          field: col.campo,
          headerName: col.titulo,
          valueFormatter: (params: any) =>
            params.value == null
              ? ""
              : new Intl.NumberFormat("es-CO", {
                  style: "currency",
                  currency: "COP",
                  maximumFractionDigits: 0,
                }).format(params.value),
        };
      }

      if (col.tipo === "fecha") {
        return {
          field: col.campo,
          headerName: col.titulo,
          sortable: true,
          filter: "agDateColumnFilter",
          comparator: (filterDate: Date, cellValue: string) => {
            if (!cellValue) return -1;
            const cellDate = new Date(cellValue.replace(" ", "T"));
            const cellSinHora = new Date(
              cellDate.getFullYear(),
              cellDate.getMonth(),
              cellDate.getDate(),
            );
            if (cellSinHora < filterDate) return -1;
            if (cellSinHora > filterDate) return 1;
            return 0;
          },
          browserDatePicker: true,
          valueFormatter: (params: any) =>
            params.value
              ? new Date(params.value).toLocaleString("es-CO", {
                  day: "2-digit",
                  month: "short",
                  hour: "2-digit",
                  minute: "2-digit",
                })
              : "",
        };
      }

      if (col.tipo === "estado-pedido") {
        const COLOR_ESTADO: Record<string, string> = {
          Pendiente: "var(--color-text-muted)",
          Aprobado: "var(--color-primary)",
          Asignado: "var(--primary-700)",
          "En tránsito": "var(--color-warning)",
          Entregado: "var(--color-success)",
          Cancelado: "var(--color-danger)",
        };
        return {
          field: col.campo,
          headerName: col.titulo,
          cellRenderer: (params: any) => {
            if (!params.data) return "";
            const color =
              COLOR_ESTADO[params.value] ?? "var(--color-text-secondary)";
            return `<span class="badge-estado" style="--badge-color:${color}">${params.value ?? ""}</span>`;
          },
        };
      }

      return {
        field: col.campo,
        headerName: col.titulo,
        filter: true,
        floatingFilter: false,
        tooltipField: col.campo,
        //wrapText: true,                 // Descomenta si queiro que el valoer del campo se parta en varias lineas(si el texto es muy largo)
        //autoHeight: true,               // Necesario si se usa wrapText
      };
    });

    const gridDiv = document.getElementById("tabla-generica") as HTMLElement;
    createGrid(gridDiv, {
      defaultColDef: {
        flex: 1,
        resizable: true,
        tooltipValueGetter: (params) => params.value ?? null,
      },
      rowData: rows,
      columnDefs,
      pagination: true,
      paginationPageSize: 15,
      tooltipShowDelay: 300,
      getRowStyle: resaltarCritico
        ? (params: any) => {
            if (params.data?.stock_disponible <= params.data?.stock_minimo) {
              return { background: "rgba(var(--color-warning-rgb), 0.08)" };
            }
          }
        : undefined,
    });

    // Delegación de eventos
    gridDiv.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(
        "[data-accion]",
      ) as HTMLElement | null;
      if (!btn) return;

      const id = Number(btn.dataset.id);
      const fila = rows.find((r: any) => r.id === id);

      const evento = new CustomEvent("accion-tabla", {
        detail: {
          accion: btn.dataset.accion,
          id,
          estado: btn.dataset.estado === "true",
          fila,
        },
        bubbles: true,
      });
      wrapper.dispatchEvent(evento);
    });
  });
</script>
