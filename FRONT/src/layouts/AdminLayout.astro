---
// src/layouts/AdminLayout.astro
import "../styles/AdminPanel.css";
import Sidebar from "../components/comunes/Sidebar.astro";
import type { SidebarLink } from "../components/comunes/Sidebar.astro";

interface Props {
  // titulo que se muestra en el h1 de la pagina y en el <title>
  titulo: string;
  // que link del sidebar se marca como activo
  vistaActual:
    | "inicio"
    | "categorias"
    | "productos"
    | "pedidos"
    | "pagos"
    | "repartidores"
    | "perfil";
  // opcionales: si la pagina no los manda, el layout los saca del perfil del backend
  nombreAdmin?: string;
  inicialesAdmin?: string;
  imagenUrl?: string | null;
}

const { titulo, vistaActual, nombreAdmin, imagenUrl } = Astro.props;

// ── datos del admin y de su empresa para el sidebar ──
interface PerfilSidebar {
  nombre?: string;
  apellido?: string;
  imagenUrl?: string;
  empresaNombre?: string;
  empresaLogo?: string;
}

let perfil: PerfilSidebar = {};
try {
  const token = Astro.cookies.get("token")?.value ?? "";
  const respuesta = await solicitarAPI<PerfilSidebar>("/admin/perfil", {
    token,
  });
  perfil = respuesta.datos.data ?? {};
} catch (error) {
  // si el backend no responde el sidebar igual se pinta, solo sin nombre/logo
  console.error("AdminLayout: no se pudo cargar el perfil", error);
}

// la solicitud ya convierte las rutas "/img/..." del backend en urls absolutas

const nombreCompleto =
  nombreAdmin ??
  (`${perfil.nombre ?? ""} ${perfil.apellido ?? ""}`.trim() || "Administrador");

// links del sidebar: mismas vistas que tenia la navbar de pestanas (el perfil va en el footer)
const links: SidebarLink[] = [
  { href: "/admin/inicio", label: "Inicio", icon: "bi-house-door" },
  { href: "/admin/categorias", label: "Categorías", icon: "bi-tags" },
  { href: "/admin/productos", label: "Productos", icon: "bi-box-seam" },
  { href: "/admin/pedidos", label: "Pedidos", icon: "bi-cart3" },
  { href: "/admin/pagos", label: "Pagos", icon: "bi-credit-card" },
  { href: "/admin/repartidores", label: "Repartidores", icon: "bi-truck" },
];

// la vista "perfil" no esta en la lista, asi que no marca ningun link como activo
const activePath = `/admin/${vistaActual}`;
type OpcionesSolicitud = {
  metodo?: string;
  token?: string | null;
  cuerpo?: unknown;
  headers?: HeadersInit;
  query?: Record<string, string | number | boolean | null | undefined>;
  timeoutMs?: number;
};

async function solicitarAPI<T = any>(
  ruta: string,
  opciones: OpcionesSolicitud = {},
): Promise<{
  ok: boolean;
  status: number;
  datos: {
    [clave: string]: any;
    data?: T;
    success?: boolean;
    message?: string;
    error?: string;
  };
}> {
  const {
    metodo = "GET",
    token,
    cuerpo,
    headers: encabezadosIniciales,
    query,
    timeoutMs = 20_000,
  } = opciones;
  const absoluta = /^https?:\/\//i.test(ruta);
  const rutaNormalizada = absoluta || ruta.startsWith("/") ? ruta : `/${ruta}`;
  const requiereApi =
    !absoluta &&
    !rutaNormalizada.startsWith("/api") &&
    !rutaNormalizada.startsWith("/ws") &&
    !rutaNormalizada.startsWith("/img");
  const baseUrl = import.meta.env.API_DENO ?? "http://127.0.0.1:8005";
  const url = new URL(
    absoluta
      ? rutaNormalizada
      : `${baseUrl.replace(/\/+$/, "")}${requiereApi ? "/api" : ""}${rutaNormalizada}`,
  );
  for (const [clave, valor] of Object.entries(query ?? {})) {
    if (valor !== undefined && valor !== null)
      url.searchParams.set(clave, String(valor));
  }
  const headers = new Headers(encabezadosIniciales);
  if (token) headers.set("Authorization", `Bearer ${token}`);
  let body: BodyInit | undefined;
  if (
    cuerpo !== undefined &&
    cuerpo !== null &&
    metodo.toUpperCase() !== "GET" &&
    metodo.toUpperCase() !== "HEAD"
  ) {
    if (
      typeof cuerpo === "string" ||
      cuerpo instanceof FormData ||
      cuerpo instanceof URLSearchParams ||
      (typeof Blob !== "undefined" && cuerpo instanceof Blob) ||
      (typeof ArrayBuffer !== "undefined" && cuerpo instanceof ArrayBuffer)
    ) {
      body = cuerpo as BodyInit;
    } else {
      if (!headers.has("Content-Type"))
        headers.set("Content-Type", "application/json");
      body = JSON.stringify(cuerpo);
    }
  }
  const controller = new AbortController();
  const timeout = globalThis.setTimeout(() => controller.abort(), timeoutMs);
  try {
    const respuesta = await fetch(url, {
      method: metodo,
      headers,
      body,
      signal: controller.signal,
    });
    const texto = await respuesta.text();
    let datos: any = { success: respuesta.ok, message: "Sin contenido" };
    if (texto) {
      try {
        datos = JSON.parse(texto);
      } catch {
        datos = { success: false, message: texto };
      }
    }
    return { ok: respuesta.ok, status: respuesta.status, datos };
  } catch (error) {
    console.error(`Error al llamar al backend (${ruta}):`, error);
    return {
      ok: false,
      status: 502,
      datos: {
        success: false,
        message:
          error instanceof Error
            ? error.message
            : "Error al contactar con el backend",
      },
    };
  } finally {
    globalThis.clearTimeout(timeout);
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo} — GeoRuta Admin</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
  </head>
  <body>
    <Sidebar
      activePath={activePath}
      links={links}
      perfilHref="/admin/perfil"
      empresa={perfil.empresaNombre
        ? {
            nombre: perfil.empresaNombre,
            logoUrl: perfil.empresaLogo || undefined,
          }
        : undefined}
      usuario={{
        nombre: nombreCompleto,
        fotoUrl: imagenUrl || perfil.imagenUrl || undefined,
      }}
    />

    <!-- aplica el estado colapsado ANTES del primer pintado para que no haya parpadeo al navegar -->
    <script is:inline>
      if (
        localStorage.getItem("sidebar-collapsed") === "true" &&
        window.innerWidth >= 992
      ) {
        document.body.classList.add("sidebar-collapsed");
        document.getElementById("appSidebar")?.classList.add("is-collapsed");
      }
    </script>

    <div class="sa-contenedor">
      <main class="sa-main">
        <div class="sa-page-header">
          <div>
            <h1 class="sa-page-titulo">{titulo}</h1>
            <p class="sa-page-sub">
              <span class="sa-badge-sistema">● SISTEMA ACTIVO</span>
            </p>
          </div>
          <div class="sa-page-acciones">
            <span class="sa-fecha" id="admin-fecha-hoy"></span>
          </div>
        </div>
        <div class="sa-zona-contenido">
          <slot />
        </div>
      </main>
    </div>

    <script>
      // fecha del dia en la esquina superior derecha (mismo formato que Script_Admin.js)
      const elFecha = document.getElementById("admin-fecha-hoy");
      if (elFecha) {
        const ahora = new Date();
        elFecha.textContent =
          "📅 " +
          ahora
            .toLocaleDateString("es-CO", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
            .toUpperCase();
      }
    </script>
  </body>
</html>
